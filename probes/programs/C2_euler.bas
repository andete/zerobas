10 REM ** C2 - PROJECT EULER 1-28 IN MSX BASIC (PROBLEMS 1 2 5 6 9 15 18 19 20 28) **
20 KEY OFF:CLS:DEFINT I-N:DEFDBL A-H,O-Z:DIM T(15,15),W(40)
30 REM P1: multiples of 3 or 5 below 1000
40 S=0:FOR I=1 TO 999:IF I MOD 3=0 OR I MOD 5=0 THEN S=S+I
50 NEXT:LPRINT "P1";S
60 REM P2: even Fibonacci terms up to four million
70 A=1:B=2:S=0
80 IF B>4000000# THEN 90
84 IF B-INT(B/2)*2=0 THEN S=S+B
86 C=A+B:A=B:B=C:GOTO 80
90 LPRINT "P2";S
100 REM P5: the smallest number divisible by 1..20, as an lcm fold (gcd in doubles)
110 R=1:FOR K=2 TO 20:A=R:B=K
120 IF B>0 THEN C=A-INT(A/B)*B:A=B:B=C:GOTO 120
130 R=R/A*K:NEXT:LPRINT "P5";R
140 REM P6: square of the sum minus sum of the squares, 1..100
150 S=0:Q=0:FOR K=1 TO 100:S=S+K:Q=Q+K*K:NEXT:LPRINT "P6";S*S-Q
160 REM P9: the Pythagorean triplet with a+b+c=1000, b solved for each a
170 FOR K=1 TO 332:A=K:B=(500000#-1000*A)/(1000-A):IF B=INT(B) AND B>A THEN C=1000-A-B:LPRINT "P9";A;B;C;A*B*C
180 NEXT
190 REM P15: lattice paths through a 20x20 grid, C(40,20) as a running product
200 R=1:FOR K=1 TO 20:R=R*(20+K)/K:NEXT:LPRINT "P15";R
210 REM P18: the maximum path down the triangle, bottom up
220 RESTORE 1000:FOR I=1 TO 15:FOR J=1 TO I:READ T(I,J):NEXT J,I
230 FOR I=14 TO 1 STEP -1:FOR J=1 TO I:M=T(I+1,J):IF T(I+1,J+1)>M THEN M=T(I+1,J+1)
240 T(I,J)=T(I,J)+M:NEXT J,I:LPRINT "P18";T(1,1)
250 REM P19: Sundays on the first of a month, 1901-2000 (D = the weekday, 0 = Sunday; 1 Jan 1900 was a Monday)
260 RESTORE 2000:FOR I=1 TO 12:READ W(I):NEXT:N=0:D=1
270 FOR Y=1900 TO 2000:FOR M=1 TO 12:IF Y>1900 AND D MOD 7=0 THEN N=N+1
280 L=W(M):IF M=2 AND Y MOD 4=0 AND (Y MOD 100<>0 OR Y MOD 400=0) THEN L=29
290 D=(D+L) MOD 7:NEXT M,Y:LPRINT "P19";N
300 REM P20: the digit sum of 100!, in base-10000 limbs
310 FOR I=1 TO 40:W(I)=0:NEXT:W(1)=1:NL=1
320 FOR F=2 TO 100:CY=0:FOR I=1 TO NL:V=W(I)*F+CY:CY=INT(V/10000):W(I)=V-CY*10000:NEXT
330 IF CY>0 THEN NL=NL+1:W(NL)=CY-INT(CY/10000)*10000:CY=INT(CY/10000):GOTO 330
340 NEXT:S=0:FOR I=1 TO NL:V=W(I):FOR J=1 TO 4:S=S+V-INT(V/10)*10:V=INT(V/10):NEXT J,I:LPRINT "P20";S;NL
350 REM P28: the diagonals of a 1001x1001 number spiral, ring by ring
360 S=1:FOR K=3 TO 1001 STEP 2:S=S+4*K*K-6*(K-1):NEXT:LPRINT "P28";S
370 LPRINT "CP 9 END":END
