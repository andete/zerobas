10 REM ** C5 - CONTEST STYLE: STRING ALGORITHMS **
20 CLEAR 2000:KEY OFF:CLS:DEFINT A-Z:DIM F(20),D(10,10),L(12,12),G$(10),K$(10)
30 REM 1: KMP search: every place ABRA starts in the text
40 T$="ABRACADABRA ABRACADABRA CADABRA":P$="ABRA":M=LEN(P$):F(1)=0:K=0
50 FOR I=2 TO M
60 IF K>0 AND MID$(P$,K+1,1)<>MID$(P$,I,1) THEN K=F(K):GOTO 60
70 IF MID$(P$,K+1,1)=MID$(P$,I,1) THEN K=K+1
80 F(I)=K:NEXT:K=0:R$=""
90 FOR I=1 TO LEN(T$)
100 IF K>0 AND MID$(P$,K+1,1)<>MID$(T$,I,1) THEN K=F(K):GOTO 100
110 IF MID$(P$,K+1,1)=MID$(T$,I,1) THEN K=K+1
120 IF K=M THEN R$=R$+STR$(I-M+1):K=F(K)
130 NEXT:LPRINT "CP 1";R$
140 REM 2: edit distance by DP on a 2-D array
150 RESTORE 900:FOR Q=1 TO 2:READ A$,B$:X=LEN(A$):Y=LEN(B$)
160 FOR I=0 TO X:D(I,0)=I:NEXT:FOR J=0 TO Y:D(0,J)=J:NEXT
170 FOR I=1 TO X:FOR J=1 TO Y:C=-(MID$(A$,I,1)<>MID$(B$,J,1)):V=D(I-1,J-1)+C
180 IF D(I-1,J)+1<V THEN V=D(I-1,J)+1
190 IF D(I,J-1)+1<V THEN V=D(I,J-1)+1
200 D(I,J)=V:NEXT J,I:LPRINT "CP 2 ";A$;" ";B$;D(X,Y):NEXT Q
210 REM 3: longest common subsequence, and one of them by walking back
220 A$="AGGTABQMXZ":B$="GXTXAYBQZ":X=LEN(A$):Y=LEN(B$)
230 FOR I=0 TO X:L(I,0)=0:NEXT:FOR J=0 TO Y:L(0,J)=0:NEXT
240 FOR I=1 TO X:FOR J=1 TO Y:IF MID$(A$,I,1)=MID$(B$,J,1) THEN L(I,J)=L(I-1,J-1)+1 ELSE L(I,J)=L(I-1,J):IF L(I,J-1)>L(I,J) THEN L(I,J)=L(I,J-1)
250 NEXT J,I:I=X:J=Y:S$=""
260 IF I=0 OR J=0 THEN 300
270 IF MID$(A$,I,1)=MID$(B$,J,1) THEN S$=MID$(A$,I,1)+S$:I=I-1:J=J-1:GOTO 260
280 IF L(I-1,J)>=L(I,J-1) THEN I=I-1 ELSE J=J-1
290 GOTO 260
300 LPRINT "CP 3";L(X,Y);" ";S$
310 REM 4: run-length encoding
320 S$=STRING$(12,"W")+"B"+STRING$(12,"W")+"BBB"+STRING$(24,"W")+"B"+STRING$(14,"W"):E$="":I=1
330 C$=MID$(S$,I,1):N=0
340 IF I<=LEN(S$) THEN IF MID$(S$,I,1)=C$ THEN N=N+1:I=I+1:GOTO 340
350 E$=E$+MID$(STR$(N),2)+C$:IF I<=LEN(S$) THEN 330
360 LPRINT "CP 4 ";E$
370 REM 5: ROT13, and a hash with XOR
380 M$="MEET ME AT THE MSX CLUB":E$="":H!=0
390 FOR I=1 TO LEN(M$):C=ASC(MID$(M$,I,1)):IF C>=65 AND C<=90 THEN C=(C-65+13) MOD 26+65
400 E$=E$+CHR$(C):H!=H!*7+(ASC(MID$(M$,I,1)) XOR 42):H!=H!-INT(H!/9973)*9973:NEXT:LPRINT "CP 5 ";E$;H!
410 REM 6: anagram groups by a sorted signature
420 RESTORE 910:FOR I=1 TO 7:READ G$(I):W$=G$(I)
430 FOR J=1 TO LEN(W$)-1:FOR Q=J+1 TO LEN(W$):IF MID$(W$,Q,1)<MID$(W$,J,1) THEN C$=MID$(W$,J,1):MID$(W$,J,1)=MID$(W$,Q,1):MID$(W$,Q,1)=C$
440 NEXT Q,J:K$(I)=W$:NEXT I:B=0:BI=0
450 FOR I=1 TO 7:N=0:FOR J=1 TO 7:IF K$(J)=K$(I) THEN N=N+1
460 NEXT J:IF N>B THEN B=N:BI=I
470 NEXT I:R$="":FOR J=1 TO 7:IF K$(J)=K$(BI) THEN R$=R$+" "+G$(J)
480 NEXT:LPRINT "CP 6";B;R$
490 LPRINT "CP 9 END":END
900 DATA KITTEN,SITTING,SUNDAY,SATURDAY
910 DATA LISTEN,SILENT,ENLIST,GOOGLE,TINSEL,BANANA,INLETS
