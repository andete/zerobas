10 REM ** METEOR DODGE - DEMO MODE **
20 REM the player is steered by a script, not the keyboard, and the main loop
30 REM waits one frame per step, so every checkpoint is frame-exact
35 ON ERROR GOTO 990
40 SCREEN 2,1:COLOR 15,1,1:CLS:DEFINT A-Z
50 FOR I=0 TO 7:READ A:S$=S$+CHR$(A):NEXT:SPRITE$(0)=S$
60 FOR I=0 TO 7:READ A:M$=M$+CHR$(A):NEXT:SPRITE$(1)=M$
70 DATA 24,60,126,255,255,126,60,24
80 DATA 0,60,126,126,126,126,60,0
90 OPEN "GRP:" FOR OUTPUT AS #1
100 LINE (0,180)-(255,191),4,BF:PSET (8,182),4:COLOR 15:PRINT #1,"METEOR DODGE"
110 PX=120:PY=160:MX=122:MY=0:HIT=0:TK=0:SC=0:LH=-1
120 ON SPRITE GOSUB 500:ON INTERVAL=25 GOSUB 600
130 SPRITE ON:INTERVAL ON
140 PLAY "T200O4L8CDEFGABO5C","T200O3L4CEGC"
150 RESTORE 900
160 FOR K=1 TO 120
170 IF K MOD 10=1 THEN READ DX:IF DX=99 THEN RESTORE 900:READ DX
180 PX=PX+DX:IF PX<0 THEN PX=0 ELSE IF PX>240 THEN PX=240
190 MY=MY+3:IF MY>176 THEN MY=0:MX=(MX*7+31) MOD 240:SC=SC+1
195 IF MX<PX-1 THEN MX=MX+3 ELSE IF MX>PX+1 THEN MX=MX-3
200 PUT SPRITE 0,(PX,PY),11,0:PUT SPRITE 1,(MX,MY),8,1
210 T=TIME
220 IF TIME=T THEN 220
230 IF K MOD 20=0 THEN LPRINT "CP 1";K;PX;MX;MY;SC;HIT
240 NEXT K
250 SPRITE OFF:INTERVAL OFF
260 IF PLAY(0) THEN 260
270 LPRINT "CP 2 HITS";HIT;"SCORE";SC;"TICKS OK";-(TK>=4)
280 LPRINT "CP 3";STICK(0);STRIG(0);POINT(250,186);POINT(100,100)
290 CLOSE:SCREEN 0:PRINT "HITS";HIT;"SCORE";SC
300 END
500 REM ** collision: count it once per meteor fall **
510 IF LH<>SC THEN HIT=HIT+1:LH=SC:LPRINT "CP 4 HIT";K;PX;MX;MY
520 RETURN
600 TK=TK+1:RETURN
900 DATA 2,2,-3,0,4,-4,1,1,-2,3,99
990 LPRINT "CP 9 ERROR";ERR;"IN";ERL:SCREEN 0:END
