1 REM @ANSWERS D|C000|E|C003|A5|E|C008|FF|D|C000|S|C000|C00F|Q
10 REM ** A HEX MONITOR ON A BUFFER IN FREE RAM **
20 CLEAR 200,&HC000:KEY OFF:CLS:WIDTH 37:ON ERROR GOTO 900
30 FOR A=&HC000 TO &HC01F:POKE A,(A AND 255)*7 AND 255:NEXT
40 LPRINT "CP 0";PEEK(&HC000);PEEK(&HC01F);HEX$(&HC01F)
50 INPUT "D=DUMP E=EDIT S=SUM Q=QUIT";C$:C$=LEFT$(C$,1)
60 ON INSTR("DESQ",C$)+1 GOTO 50,100,200,300,400
100 INPUT "FROM";A$:A=VAL("&H"+A$)
110 FOR R=0 TO 1:PRINT HEX$(A+R*8);":";:S$=""
120 FOR B=0 TO 7:V=PEEK(A+R*8+B):PRINT RIGHT$("0"+HEX$(V),2);" ";
130 IF V>=32 AND V<127 THEN S$=S$+CHR$(V) ELSE S$=S$+"."
140 NEXT:PRINT S$:LPRINT "CP 1 ";HEX$(A+R*8);" ";S$:NEXT:GOTO 50
200 INPUT "ADDRESS";A$:INPUT "BYTE";B$:A=VAL("&H"+A$):V=VAL("&H"+B$)
210 POKE A,V:LPRINT "CP 2 ";HEX$(A);PEEK(A);V:GOTO 50
300 INPUT "FROM";A$:INPUT "TO";B$:S=0:X=0
310 FOR A=VAL("&H"+A$) TO VAL("&H"+B$):S=S+PEEK(A):X=X XOR PEEK(A):NEXT
320 PRINT "SUM ";HEX$(S);" XOR ";HEX$(X):LPRINT "CP 3";S;X;HEX$(S):GOTO 50
400 LPRINT "CP 4 END";FRE(0)>0:END
900 LPRINT "CP 9 ERR";ERR;ERL:RESUME NEXT
