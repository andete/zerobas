10 REM ** C1 - CONTEST STYLE: NUMBER THEORY AND DYNAMIC PROGRAMMING **
20 KEY OFF:CLS:DEFINT A-Z:DIM P(2000),D(200),W(60),LI(60)
30 REM 1: sieve of Eratosthenes below 2000: count, last prime, sum mod 9973
40 FOR I=2 TO 1999:P(I)=1:NEXT
50 FOR I=2 TO 44:IF P(I) THEN FOR J=I*I TO 1999 STEP I:P(J)=0:NEXT
60 NEXT:C=0:L=0:S=0:FOR I=2 TO 1999:IF P(I) THEN C=C+1:L=I:S=(S+I) MOD 9973
70 NEXT:LPRINT "CP 1";C;L;S
80 REM 2: gcd / lcm by Euclid, with negatives and MOD's sign
90 RESTORE 900:FOR K=1 TO 4:READ A,B:X=ABS(A):Y=ABS(B)
100 IF Y THEN T=X MOD Y:X=Y:Y=T:GOTO 100
110 LPRINT "CP 2";A;B;X;A MOD B;A\B;(A\X)*B:NEXT
120 REM 3: modular power 7^k mod 997: the product passes 32767, so it is taken in a double
130 FOR K=1 TO 4:READ E:R=1:B=7:N=E
140 IF N=0 THEN 160
150 IF N AND 1 THEN Q#=CDBL(R)*B:R=Q#-INT(Q#/997)*997
155 Q#=CDBL(B)*B:B=Q#-INT(Q#/997)*997:N=N\2:GOTO 140
160 LPRINT "CP 3";E;R:NEXT
170 REM 4: 30! exactly (33 digits), in base-10000 limbs
180 FOR I=1 TO 60:W(I)=0:NEXT:W(1)=1:NL=1
190 FOR F=2 TO 30:CY=0
200 FOR I=1 TO NL:V#=CDBL(W(I))*F+CY:CY=INT(V#/10000):W(I)=V#-CY*10000#:NEXT
210 IF CY THEN NL=NL+1:W(NL)=CY MOD 10000:CY=CY\10000:GOTO 210
220 NEXT:S$=MID$(STR$(W(NL)),2):FOR I=NL-1 TO 1 STEP -1:S$=S$+RIGHT$("000"+MID$(STR$(W(I)),2),4):NEXT
230 LPRINT "CP 4";LEN(S$);LEFT$(S$,20);" ";RIGHT$(S$,12)
240 REM 5: Fibonacci 80 (17 digits) by string addition
250 A$="0":B$="1":FOR K=2 TO 80:GOSUB 800:A$=B$:B$=C$:NEXT
260 LPRINT "CP 5";LEN(B$);LEFT$(B$,15);" ";RIGHT$(B$,10)
270 REM 6: Collatz: the longest chain up to 30 (doubles: 27 climbs to 9232)
280 BL=0:BN=0:FOR N=1 TO 30:X#=N:T=1
290 IF X#<>1 THEN IF X#/2=INT(X#/2) THEN X#=X#/2:T=T+1:GOTO 290 ELSE X#=3*X#+1:T=T+1:GOTO 290
300 IF T>BL THEN BL=T:BN=N
310 NEXT:LPRINT "CP 6";BN;BL
320 REM 7: coin change: ways to make 0..200 from 1 2 5 10 20 50 100 200, mod 16000
330 FOR I=0 TO 200:D(I)=0:NEXT:D(0)=1:RESTORE 910
340 FOR K=1 TO 8:READ CN:FOR I=CN TO 200:D(I)=D(I)+D(I-CN):IF D(I)>=16000 THEN D(I)=D(I)-16000
350 NEXT I,K:LPRINT "CP 7";D(10);D(100);D(200)
360 REM 8: longest increasing subsequence of 60 seeded values, O(n log n)
370 X=RND(-31):L=0:FOR I=1 TO 60:V=INT(RND(1)*500):LO=1:HI=L
380 IF LO<=HI THEN MI=(LO+HI)\2:IF LI(MI)<V THEN LO=MI+1:GOTO 380 ELSE HI=MI-1:GOTO 380
390 LI(LO)=V:IF LO>L THEN L=LO
400 NEXT:LPRINT "CP 8";L;LI(1);LI(L)
410 LPRINT "CP 9 END":END
800 REM C$ = A$ + B$ as decimal strings
810 C$="":CY=0:IA=LEN(A$):IB=LEN(B$)
820 IF IA=0 AND IB=0 AND CY=0 THEN RETURN
830 DA=0:DB=0:IF IA THEN DA=ASC(MID$(A$,IA,1))-48:IA=IA-1
840 IF IB THEN DB=ASC(MID$(B$,IB,1))-48:IB=IB-1
850 T=DA+DB+CY:CY=T\10:C$=CHR$(48+T MOD 10)+C$:GOTO 820
900 DATA 1071,462,-48,18,270,-192,17,5
905 DATA 0,1,100,996
910 DATA 1,2,5,10,20,50,100,200
