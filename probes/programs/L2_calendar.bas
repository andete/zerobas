1 REM @ANSWERS 2|1986|Y|7|1969|Y|2|2000|Y|13|N
10 REM ** PERPETUAL CALENDAR **
15 CLEAR 400:REM without it the note wrap ran out of the default 200 bytes -- zerobas a month early (D-CATCOPY, TODO.md)
20 CLS:KEY OFF:WIDTH 37:DIM D(12)
30 FOR I=1 TO 12:READ D(I):NEXT:N$="JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC"
40 INPUT "MONTH (1-12)";M:IF M<1 OR M>12 THEN PRINT "NO SUCH MONTH":LPRINT "CP 9 BAD";M:GOTO 200
50 INPUT "YEAR";Y
60 L=-(Y MOD 4=0 AND (Y MOD 100<>0 OR Y MOD 400=0)):DM=D(M)-(M=2)*L
70 REM day of week of the 1st (0=SUNDAY), Zeller-style
80 MM=M:YY=Y:IF MM<3 THEN MM=MM+12:YY=YY-1
90 W=(1+INT(13*(MM+1)/5)+YY+INT(YY/4)-INT(YY/100)+INT(YY/400)) MOD 7:W=(W+6) MOD 7
100 CLS:PRINT TAB(10);MID$(N$,M*3-2,3);Y:PRINT
110 PRINT " SU MO TU WE TH FR SA"
120 PRINT SPC(W*3);
130 FOR DD=1 TO DM
140 PRINT USING "###";DD;
150 IF (DD+W) MOD 7=0 THEN PRINT
160 NEXT:PRINT:PRINT
170 LPRINT "CP 1";M;Y;L;DM;W;POS(0);CSRLIN
180 REM a note, word-wrapped to 20 columns
190 T$="THE FIRST OF THIS MONTH FALLS ON DAY"+STR$(W)+" OF THE WEEK, AND THE MONTH HAS"+STR$(DM)+" DAYS.":GOSUB 300
200 INPUT "AGAIN (Y/N)";A$:IF A$="Y" THEN 40
210 END
300 P=1:C=0
310 Q=INSTR(P,T$+" "," "):WD$=MID$(T$,P,Q-P)
320 IF C+LEN(WD$)>20 THEN PRINT:LPRINT "CP 2 WRAP";C:C=0
330 PRINT WD$;" ";:C=C+LEN(WD$)+1:P=Q+1
340 IF P<=LEN(T$) THEN 310
350 PRINT:LPRINT "CP 3";LEN(T$);C:RETURN
1000 DATA 31,28,31,30,31,30,31,31,30,31,30,31
