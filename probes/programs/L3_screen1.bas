10 REM ** SCREEN 1 TILES: REDEFINED CHARACTERS AND COLOURS **
20 ON ERROR GOTO 900
30 SCREEN 1:WIDTH 32:COLOR 15,4,4:KEY OFF:CLS
40 PT=BASE(7):CT=BASE(6):NT=BASE(5)
50 LPRINT "CP 0";PT;CT;NT;VDP(0);VDP(1);VDP(2);VDP(4)
60 REM redefine 128..131 as a brick, a ball, a smiley and a stripe
70 FOR C=128 TO 131:FOR R=0 TO 7:READ B:VPOKE PT+C*8+R,B:NEXT R,C
80 VPOKE CT+16,&H6A:VPOKE CT+0,&HF4
90 LOCATE 2,2:PRINT "TILES ";CHR$(128);CHR$(129);CHR$(130);CHR$(131)
100 FOR X=0 TO 31:VPOKE NT+32*20+X,128+(X MOD 4):NEXT
110 LOCATE 0,10:PRINT "CSRLIN";CSRLIN;"POS";POS(0)
120 S=0:FOR A=NT TO NT+767:S=(S*5+VPEEK(A)) MOD 3001:NEXT
130 LPRINT "CP 1";S;VPEEK(NT+66);VPEEK(PT+129*8+3);VPEEK(CT+16)
140 S=0:FOR A=PT+128*8 TO PT+132*8-1:S=S+VPEEK(A):NEXT:LPRINT "CP 2";S
150 SCREEN 0:PRINT "DONE":END
900 LPRINT "CP 9 ERR";ERR;ERL:SCREEN 0:END
1000 DATA 255,129,129,255,24,24,24,255
1010 DATA 60,126,255,255,255,255,126,60
1020 DATA 60,66,165,129,165,153,66,60
1030 DATA 255,0,255,0,255,0,255,0
