10 REM ** PRIME SIEVE AND BIT TOOLS - integer arrays, logic, number bases **
20 CLS:DEFINT A-Z:ON ERROR GOTO 900:N=2000:DIM F(2000)
30 FOR I=2 TO SQR(N):IF F(I) THEN 50
40 FOR J=I*I TO N STEP I:F(J)=1:NEXT J
50 NEXT I
60 C=0:S!=0:FOR I=2 TO N:IF F(I)=0 THEN C=C+1:S!=S!+I:L=I
70 NEXT:LPRINT "CP 1";C;S!;L
80 T=0:FOR I=2 TO 100:IF F(I)=0 THEN T=T XOR I
90 NEXT:LPRINT "CP 2";T;HEX$(T);BIN$(T);OCT$(T)
100 A=&HF0F0:B=&O7777:C=&B1010101010101010
110 LPRINT "CP 3";A;B;C;A AND B;A OR C;NOT A;A XOR -1;(A AND &HFF)\16;-17 MOD 5;-17\5
120 X=32767:X=X+1:LPRINT "CP 4 NO ERROR";X
130 Y=-32768:LPRINT "CP 5";Y;-Y
140 Z=300*300:LPRINT "CP 6";Z
150 LPRINT "CP 7";CINT(32767.4);FIX(-2.5);INT(-2.5);CINT(-2.5);CINT(2.5);CINT(3.5)
160 END
900 LPRINT "CP E";ERR;ERL:RESUME NEXT
