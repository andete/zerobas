1 REM @ANSWERS LOOK|TAKE LAMP|GO NORTH|N|TAKE KEY|INVENTORY|S|E|OPEN DOOR|E|TAKE COIN|DANCE|I|W|W|DROP LAMP|LOOK|QUIT
10 REM ** THE OLD MILL - A TEXT ADVENTURE **
20 CLS:KEY OFF:WIDTH 37
30 NR=4:NO=4:DIM R$(NR),EX(NR,4),O$(NO),OL(NO)
40 FOR I=1 TO NR:READ R$(I):FOR J=1 TO 4:READ EX(I,J):NEXT J,I
50 FOR I=1 TO NO:READ O$(I),OL(I):NEXT
60 D$="NSEW":RM=1:MV=0:DR=0
70 PRINT "THE OLD MILL":PRINT STRING$(12,"~")
80 GOSUB 500
90 PRINT:INPUT "> ";C$:MV=MV+1
100 IF C$="" THEN 90
110 SP=INSTR(C$," "):IF SP=0 THEN V$=C$:N$="" ELSE V$=LEFT$(C$,SP-1):N$=MID$(C$,SP+1)
120 IF V$="GO" THEN V$=LEFT$(N$,1):N$=""
130 V$=LEFT$(V$,4)
140 LPRINT "CP 1";MV;RM;"[";V$;"][";N$;"]"
150 DI=INSTR(D$,V$):IF LEN(V$)=1 AND DI>0 THEN 300
160 K=(INSTR("LOOKTAKEDROPINVEOPENQUITI   ",V$)+3)/4
170 IF K<>INT(K) OR K<1 THEN PRINT "I DON'T KNOW HOW TO ";C$;".":GOTO 90
180 IF K=7 THEN K=4
190 ON K GOSUB 500,600,700,800,900,950
200 IF K=6 THEN END
210 GOTO 90
300 REM ** MOVE **
310 X=EX(RM,DI)
320 IF RM=2 AND DI=3 AND DR=0 THEN PRINT "THE DOOR IS LOCKED.":GOTO 90
330 IF X=0 THEN PRINT "YOU CAN'T GO THAT WAY.":GOTO 90
340 RM=X:GOSUB 500:GOTO 90
500 REM ** LOOK **
510 PRINT R$(RM):E$=""
520 FOR J=1 TO 4:IF EX(RM,J) THEN E$=E$+" "+MID$(D$,J,1)
530 NEXT:PRINT "EXITS:";E$
540 FOR J=1 TO NO:IF OL(J)=RM THEN PRINT "THERE IS A ";O$(J);" HERE."
550 NEXT:LPRINT "CP 2 ROOM";RM;E$:RETURN
600 REM ** TAKE **
610 GOSUB 990:IF J=0 THEN RETURN
620 IF OL(J)<>RM THEN PRINT "IT ISN'T HERE.":RETURN
630 OL(J)=0:PRINT "TAKEN.":LPRINT "CP 3 TAKE ";O$(J):RETURN
700 REM ** DROP **
710 GOSUB 990:IF J=0 THEN RETURN
720 IF OL(J)<>0 THEN PRINT "YOU DON'T HAVE IT.":RETURN
730 OL(J)=RM:PRINT "DROPPED.":RETURN
800 REM ** INVENTORY **
810 PRINT "YOU CARRY:";:F=0
820 FOR J=1 TO NO:IF OL(J)=0 THEN PRINT " ";O$(J);:F=F+1
830 NEXT:IF F=0 THEN PRINT " NOTHING";
840 PRINT ".":LPRINT "CP 4 INV";F:RETURN
900 REM ** OPEN **
910 IF RM<>2 OR N$<>"DOOR" THEN PRINT "NOTHING TO OPEN.":RETURN
920 IF OL(2)<>0 THEN PRINT "YOU NEED A KEY.":RETURN
930 DR=1:EX(2,3)=4:PRINT "THE DOOR CREAKS OPEN.":LPRINT "CP 5 DOOR":RETURN
950 SC=0:FOR J=1 TO NO:IF OL(J)=0 THEN SC=SC+10
960 NEXT:PRINT "SCORE";SC;"IN";MV;"MOVES."
970 LPRINT "CP 6 END";SC;MV;FRE(""):RETURN
990 J=0:FOR I=1 TO NO:IF O$(I)=N$ THEN J=I
995 NEXT:IF J=0 THEN PRINT "WHAT ";N$;"?"
996 RETURN
1000 DATA "YOU ARE IN THE MILL YARD.",3,0,2,0
1010 DATA "A DUSTY HALL. A DOOR IS EAST.",0,0,0,1
1020 DATA "THE MILL POND. COLD WATER.",0,1,0,0
1030 DATA "THE GRINDING ROOM.",0,0,0,2
1040 DATA LAMP,1,KEY,3,COIN,4,ROPE,2
