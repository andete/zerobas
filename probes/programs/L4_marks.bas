10 REM ** CLASS MARKS - DEFSTR, ERASE, A PRINTER THAT KNOWS ITS COLUMN, TRON **
20 KEY OFF:CLS:DEFSTR N:DEFINT I-K
30 REM 1: DEFSTR names, LET written out, a string DEF FN typed by its letter
40 LET N="ADA":LET M=3.5:DEF FNN(X$)=LEFT$(X$,1)+"."
50 LPRINT "CP 1 ";N;LEN(N);M;FNN("BRUNO");FNN(N)
60 REM 2: a class of five read into arrays, totals at a TAB, LPOS after them
70 DIM NS(4),SC(4,2):RESTORE 900
80 FOR I=0 TO 4:READ NS(I):FOR K=0 TO 2:READ SC(I,K):NEXT K,I
90 FOR I=0 TO 4:T=0:FOR K=0 TO 2:T=T+SC(I,K):NEXT:LPRINT "CP 2 ";NS(I);TAB(12);T;LPOS(0):NEXT
100 REM 3: the average in a column the printer reports itself
110 FOR I=0 TO 4:A=(SC(I,0)+SC(I,1)+SC(I,2))/3:LPRINT NS(I);:P=LPOS(0):LPRINT SPC(15-P);:LPRINT USING "##.##";A:NEXT:LPRINT "CP 3";P
120 REM 4: ERASE and DIM again with another shape; a second DIM is trapped
130 ERASE SC:DIM SC(9):FOR I=0 TO 9:SC(I)=I*I:NEXT:LPRINT "CP 4";SC(9);SC(3)
140 ON ERROR GOTO 800:DIM SC(2)
150 ERASE NS:DIM NS(1):NS(1)="Z":LPRINT "CP 6 ";NS(0);"|";NS(1);LEN(NS(0))
160 REM 7: MID$ assignment and INSTR, editing a name in place
170 N="CHARLOTTE":MID$(N,2,3)="***":LPRINT "CP 7 ";N;INSTR(N,"*");INSTR(5,N,"T")
180 REM 8: a bar chart drawn, part rubbed out with PRESET, read back with POINT
190 SCREEN 2:COLOR 15,1,1:CLS
200 FOR I=0 TO 4:LINE(10+I*20,180)-(20+I*20,180-I*30),I+2,BF:NEXT
210 FOR Y=150 TO 180:PRESET(60,Y):NEXT
220 C1=POINT(60,170):C2=POINT(59,170):C3=POINT(15,180):VDP(7)=POINT(59,170)
230 R7=VDP(7):SCREEN 0:LPRINT "CP 8";C1;C2;C3;R7
240 REM 9: TRON across three lines: the trace goes to the screen
250 CLS:J=0:TRON
260 FOR I=1 TO 2
270 J=J+I
280 NEXT:TROFF:LPRINT "CP 9";J
290 REM 10: STOP ends the run and names its line
300 LPRINT "CP 10";FRE(0)>1000:STOP
310 LPRINT "CP 10 NOT REACHED"
800 LPRINT "CP 5 ERR";ERR;"IN";ERL:RESUME NEXT
900 DATA ADA,7,8,9,BRUNO,5.5,6,7,CHLOE,10,9.5,9,DIRK,4,5,6,EVA,8,8,8
