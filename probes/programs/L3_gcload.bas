10 REM ** STRING TORTURE - a word list rewritten until the string space gives **
20 CLEAR 1200:DEFINT A-Z:DIM W$(100):ON ERROR GOTO 900:CLS:E=0
30 FOR I=1 TO 100:W$(I)=CHR$(65+I MOD 26)+STR$(I):NEXT
40 LPRINT "CP 1";FRE("");LEN(W$(1));W$(100)
50 FOR R=1 TO 6
60 FOR I=1 TO 100:W$(I)=W$(I)+MID$("ABCDEFGH",R,1):NEXT
70 LPRINT "CP 2";R;FRE("");E;LEN(W$(50))
80 NEXT R
90 FOR I=1 TO 100 STEP 2:W$(I)="":NEXT:LPRINT "CP 3";FRE("")
100 FOR I=2 TO 100 STEP 2:W$(I)=STRING$(15,W$(I)):NEXT:LPRINT "CP 4";FRE("");E
110 T$="":FOR I=1 TO 100:T$=LEFT$(T$+LEFT$(W$(I),2),200):NEXT:LPRINT "CP 5";LEN(T$);FRE("");E
120 ERASE W$:LPRINT "CP 6";FRE("");E
130 END
900 E=E+1:IF E<5 THEN LPRINT "CP E";ERR;ERL;I
910 RESUME NEXT
