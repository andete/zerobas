1 REM @DISK
10 REM ** JOURNAL - SEQUENTIAL FILES THE WAY A DIARY PROGRAM USED THEM **
20 CLEAR 1000,&HC000:MAXFILES=3:SCREEN 0:WIDTH 37:KEY OFF:CLS:ON ERROR GOTO 900
25 REM (SCREEN 0: the CF-3300 boots in SCREEN 1, the VG-8020 and zerobas in 0)
30 OPEN "DIARY.TXT" FOR OUTPUT AS #1
40 FOR I=1 TO 4:READ D$,T$,V:PRINT #1,D$;",";CHR$(34);T$;CHR$(34);",";V:NEXT
50 WRITE #1,"19861105","SMALL, QUOTED",-1.5:CLOSE #1
60 LPRINT "CP 1 WRITTEN"
70 OPEN "DIARY.TXT" FOR APPEND AS #1:PRINT #1,"19861106,";CHR$(34);"APPENDED";CHR$(34);",7":CLOSE
80 OPEN "DIARY.TXT" FOR INPUT AS #1:N=0:S=0
90 IF EOF(1) THEN 120
100 INPUT #1,D$,T$,V:N=N+1:S=S+V:LPRINT "CP 2";N;D$;" [";T$;"]";V
110 GOTO 90
120 LPRINT "CP 3";N;S;LOF(1);LOC(1):CLOSE #1
130 REM the same file read line by line, and two files at once
140 OPEN "DIARY.TXT" FOR INPUT AS #1:OPEN "COPY.TXT" FOR OUTPUT AS #2:L=0
150 IF EOF(1) THEN 170
160 LINE INPUT #1,A$:L=L+1:PRINT #2,STR$(L);": ";A$:GOTO 150
170 CLOSE:OPEN "COPY.TXT" FOR INPUT AS #2:LINE INPUT #2,A$:LINE INPUT #2,B$:LPRINT "CP 4";L;"[";A$;"][";B$;"]";LOF(2):CLOSE
180 REM rename, the errors a careless program meets, then tidy up
190 NAME "COPY.TXT" AS "OLD.TXT":E=0:OPEN "COPY.TXT" FOR INPUT AS #1:LPRINT "CP 5";E
200 E=0:OPEN "OLD.TXT" FOR INPUT AS #1:OPEN "OLD.TXT" FOR INPUT AS #2:LPRINT "CP 6";E:CLOSE
210 E=0:PRINT #3,"X":LPRINT "CP 7";E:E=0:INPUT #1,A$:LPRINT "CP 8";E
220 REM BSAVE a block of RAM and BLOAD it somewhere else
230 FOR I=0 TO 15:POKE &HC000+I,I*17:NEXT:BSAVE "BLOCK.BIN",&HC000,&HC00F
240 BLOAD "BLOCK.BIN",&H100:S=0:FOR I=0 TO 15:S=S+PEEK(&HC100+I):NEXT:LPRINT "CP 9";S;PEEK(&HC10F)
250 KILL "DIARY.TXT":KILL "OLD.TXT":KILL "BLOCK.BIN":E=0:KILL "DIARY.TXT":LPRINT "CP 10";E
260 LPRINT "CP 11 END":END
800 DATA 19861101,"PAYDAY, AT LAST",2150,19861102,QUIET DAY,0
810 DATA 19861103,"RENT",-450,19861104,"  SPACES  ",12
900 E=ERR:LPRINT "ERR";ERR;"IN";ERL:RESUME NEXT
