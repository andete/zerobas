1 REM @ANSWERS 12500|7.5|3
10 REM ** LOAN CALCULATOR **
20 CLS:KEY OFF:WIDTH 37
30 PRINT "LOAN CALCULATOR":PRINT
40 INPUT "AMOUNT BORROWED";P
50 INPUT "YEARLY INTEREST %";R
60 INPUT "NUMBER OF YEARS";Y
70 IF P<=0 OR R<0 OR Y<=0 THEN PRINT "BAD INPUT":GOTO 40
80 N=Y*12:I=R/1200
90 IF I=0 THEN M=P/N ELSE M=P*I/(1-(1+I)^-N)
100 M=INT(M*100+.5)/100
110 LPRINT "CP 1";P;R;Y;N;M
120 PRINT:PRINT USING "MONTHLY PAYMENT ######.##";M
130 PRINT USING "TOTAL PAID      ######.##";M*N
140 PRINT USING "TOTAL INTEREST  ######.##";M*N-P
150 LPRINT "CP 2";M*N;M*N-P
160 PRINT:PRINT " NR  INTEREST PRINCIPAL  BALANCE"
170 B=P:TI=0
180 FOR K=1 TO N
190 IT=INT(B*I*100+.5)/100
200 PR=M-IT:IF K=N THEN PR=B:M=PR+IT
210 B=B-PR:TI=TI+IT
220 IF K<=6 OR K>N-3 THEN PRINT USING "### #####.## #####.## ######.##";K;IT;PR;B
230 IF K=7 THEN PRINT " ..."
240 IF K MOD 12=0 THEN LPRINT "CP 3";K;IT;PR;B;TI
250 NEXT K
260 LPRINT "CP 4";B;TI;M
270 PRINT USING "INTEREST TOTAL  ######.##";TI
280 END
