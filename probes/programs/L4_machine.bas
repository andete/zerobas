10 REM ** MACHINE CODE FROM BASIC - DEFUSR, VARPTR AND A BIOS CALL **
20 KEY OFF:SCREEN 0:WIDTH 40:CLS:CLEAR 200,&HDFFF:A=&HE000
30 REM 1: a routine that doubles the integer in the DAC
40 RESTORE 500:GOSUB 400:DEFUSR=A
50 FOR I%=-3 TO 3:LPRINT "CP 1";I%;USR(I%*1000):NEXT
60 REM 2: a second routine at another address, USR1, reading VALTYP
70 B=A+16:RESTORE 510:GOSUB 410:DEFUSR1=B
80 LPRINT "CP 2";USR1(7);USR1(2.5);USR1("X");PEEK(&HF663)
90 REM 3: VARPTR into a number and into a string's descriptor
100 N%=258:P=VARPTR(N%):LPRINT "CP 3";PEEK(P);PEEK(P+1)
110 POKE P,4:POKE P+1,1:LPRINT "CP 4";N%
120 S$="HELLO":Q=VARPTR(S$):L=PEEK(Q):D=PEEK(Q+1)+256*PEEK(Q+2)
130 T$="":FOR I=0 TO L-1:T$=T$+CHR$(PEEK(D+I)+1):NEXT:LPRINT "CP 5 ";L;T$
140 REM 4: a routine that calls the BIOS: FILVRM fills 40 cells of the screen
150 C=A+32:RESTORE 520:GOSUB 420:DEFUSR2=C
160 X=USR2(0):LPRINT "CP 6";VPEEK(0);VPEEK(39);VPEEK(40)
170 REM 5: the same routine, the fill character poked in first
180 POKE C+4,ASC("#"):X=USR2(0):LPRINT "CP 7 ";CHR$(VPEEK(5));CHR$(VPEEK(41))
190 REM 6: checksum of everything poked
200 S=0:FOR I=0 TO 7:S=S+PEEK(A+I):NEXT:FOR I=0 TO 15:S=S+PEEK(B+I):NEXT:FOR I=0 TO 11:S=S+PEEK(C+I):NEXT:LPRINT "CP 8";S;HEX$(S)
210 LPRINT "CP 9 END";FRE(0)>1000:END
400 FOR I=0 TO 15:READ H$:IF H$="*" THEN RETURN ELSE POKE A+I,VAL("&H"+H$):NEXT:RETURN
410 FOR I=0 TO 15:READ H$:IF H$="*" THEN RETURN ELSE POKE B+I,VAL("&H"+H$):NEXT:RETURN
420 FOR I=0 TO 15:READ H$:IF H$="*" THEN RETURN ELSE POKE C+I,VAL("&H"+H$):NEXT:RETURN
490 REM LD HL,(&HF7F8) / ADD HL,HL / LD (&HF7F8),HL / RET
500 DATA 2A,F8,F7,29,22,F8,F7,C9,*
505 REM LD A,(&HF663) / LD (&HF7F8),A / XOR A / LD (&HF7F9),A / LD A,2 / LD (&HF663),A / RET
510 DATA 3A,63,F6,32,F8,F7,AF,32,F9,F7,3E,02,32,63,F6,C9
515 REM LD HL,0 / LD A,"*" / LD BC,40 / CALL FILVRM (&H0056) / RET
520 DATA 21,00,00,3E,2A,01,28,00,CD,56,00,C9,*
