1 CLEAR1000:SCREEN3:COLOR15,1,1:CLS:DEFINTA-Z:DIMR$(19),N$(19):W=16:H=12
2 FORY=0TOH+1:R$(Y)=STRING$(W+2,"."):NEXTY:FORI=1TO9:READX,Y:MID$(R$(Y),X+1,1)="#":NEXTI:LINE(0,0)-(4*W+11,4*H+11),7,B
3 FORG=0TO7:P=0
4 FORY=1TOH:FORX=1TOW:IFMID$(R$(Y),X+1,1)="#"THENP=P+1:PSET(X*4+4,Y*4+4),10+(GMOD4)ELSEPSET(X*4+4,Y*4+4),1
5 NEXTX:NEXTY:LPRINT"CP 1";G;P
6 FORY=1TOH:A$=R$(Y-1):B$=R$(Y):C$=R$(Y+1):S$="."
7 FORX=1TOW:N=-(MID$(A$,X,1)="#")-(MID$(A$,X+1,1)="#")-(MID$(A$,X+2,1)="#")-(MID$(B$,X,1)="#")-(MID$(B$,X+2,1)="#")-(MID$(C$,X,1)="#")-(MID$(C$,X+1,1)="#")-(MID$(C$,X+2,1)="#")
8 IFN=3OR(N=2ANDMID$(B$,X+1,1)="#")THENS$=S$+"#"ELSES$=S$+"."
9 NEXTX:N$(Y)=S$+".":NEXTY
10 FORY=1TOH:R$(Y)=N$(Y):NEXTY:NEXTG
11 Q=0:FORY=0TO95STEP4:FORX=0TO123STEP4:Q=(Q*3+POINT(X,Y))AND4095:NEXTX:NEXTY:SCREEN0:LPRINT"CP 9";Q
12 DATA 2,1,3,2,1,3,2,3,3,3,12,8,13,8,14,8,13,9
