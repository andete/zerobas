1 REM @DISK
10 REM ** FILE KEEPER - two files at once, positions, renames, the file errors **
20 CLEAR 1000:MAXFILES=4:SCREEN 0:WIDTH 37:KEY OFF:CLS:ON ERROR GOTO 900
30 OPEN "A.TXT" FOR OUTPUT AS #1:OPEN "B.TXT" FOR OUTPUT AS #2
40 FOR I=1 TO 20:PRINT #1,"LINE";I;STRING$(I,"*"):IF I MOD 3=0 THEN PRINT #2,I*I
50 NEXT:LPRINT "CP 1";LOC(1);LOC(2);LOF(1):CLOSE
60 OPEN "A.TXT" FOR INPUT AS #1:N=0
70 IF EOF(1) THEN 100
80 LINE INPUT #1,L$:N=N+1:IF N MOD 5=0 THEN LPRINT "CP 2";N;LEN(L$);L$
90 GOTO 70
100 LPRINT "CP 3";N;LOF(1);LOC(1):CLOSE #1
110 OPEN "B.TXT" FOR INPUT AS #2:X$=INPUT$(11,#2):LPRINT "CP 4";LEN(X$);ASC(X$);INSTR(X$,CHR$(13))
120 INPUT #2,V:LPRINT "CP 5";V;EOF(2):CLOSE
130 NAME "B.TXT" AS "C.TXT":OPEN "B.TXT" FOR INPUT AS #1:LPRINT "CP 6 AFTER"
140 OPEN "C.TXT" FOR INPUT AS #1:OPEN "C.TXT" FOR INPUT AS #1:LPRINT "CP 7 AFTER":CLOSE
150 OPEN "A.TXT" FOR INPUT AS #1:PRINT #1,"X":LPRINT "CP 8 AFTER":CLOSE
160 PRINT #3,"X":LPRINT "CP 9 AFTER"
170 KILL "C.TXT":KILL "C.TXT":LPRINT "CP 10 AFTER"
180 OPEN "A.TXT" FOR INPUT AS #5:LPRINT "CP 11 AFTER":CLOSE
190 FILES:LPRINT "CP 12 END":END
900 LPRINT "CP E";ERR;ERL:RESUME NEXT
