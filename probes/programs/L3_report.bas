10 REM ** SALES REPORT **
20 CLEAR 2000:DEFINT I-N:KEY OFF:CLS
30 N=60:DIM RG$(N),PR$(N),QT(N),AM!(N),K$(N)
40 FOR I=1 TO 5:READ RN$(I):NEXT:FOR I=1 TO 6:READ PN$(I),PP!(I):NEXT
50 X=RND(-7):PRINT "GENERATING";N;"ORDERS"
60 FOR I=1 TO N
70 R=INT(RND(1)*5)+1:P=INT(RND(1)*6)+1
80 RG$(I)=RN$(R):PR$(I)=PN$(P):QT(I)=INT(RND(1)*20)+1:AM!(I)=QT(I)*PP!(P)
90 K$(I)=LEFT$(RG$(I)+SPACE$(8),8)+LEFT$(PR$(I)+SPACE$(10),10)+RIGHT$("000"+MID$(STR$(I),2),3)
100 NEXT:LPRINT "CP 1";FRE("");K$(1);"/";K$(N)
110 REM ** SHELL SORT ON THE KEY **
120 G=N\2
130 IF G<1 THEN 210
140 FOR I=G+1 TO N:J=I-G
150 IF J<1 THEN 190
160 IF K$(J)<=K$(J+G) THEN 190
170 SWAP K$(J),K$(J+G):J=J-G:GOTO 150
190 NEXT:G=G\2:GOTO 130
210 LPRINT "CP 2";FRE("");K$(1);"/";K$(N)
220 REM ** REPORT, GROUPED BY REGION **
230 LPRINT STRING$(38,"=")
240 LR$="":ST!=0:GT!=0:NL=0
250 FOR I=1 TO N
260 X=VAL(RIGHT$(K$(I),3)):R$=RG$(X)
270 IF R$<>LR$ AND LR$<>"" THEN GOSUB 400
280 LR$=R$:ST!=ST!+AM!(X):GT!=GT!+AM!(X)
290 LPRINT USING "\      \ \        \ ### #####.##";RG$(X);PR$(X);QT(X);AM!(X)
300 NEXT:GOSUB 400
310 LPRINT STRING$(38,"=")
320 LPRINT USING "TOTAL ALL REGIONS        ######.##";GT!
330 PRINT USING "TOTAL ######.## IN ## GROUPS";GT!;NL
340 LPRINT "CP 3";NL;FRE("")
350 END
400 NL=NL+1:LPRINT USING "  SUBTOTAL \      \     ######.##";LR$;ST!
410 LPRINT STRING$(38,"-"):ST!=0:RETURN
500 DATA NORTH,SOUTH,EAST,WEST,CENTRE
510 DATA WIDGET,1.25,GADGET,4.99,SPROCKET,.85,GIZMO,12.5,DOOHICKEY,3.3,THINGAMAJIG,7.75
