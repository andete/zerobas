1 REM @ANSWERS paris|7|Blue Whale|nope|1969|Q|y
10 REM ** QUIZ MASTER - question sets from DATA, typed answers, a score card **
20 KEY OFF:CLS:SC=0:NQ=0:DIM OK(10)
30 RESTORE 500:READ ST$,N:LPRINT "CP 1 ";ST$;N
40 FOR Q=1 TO N
50 READ Q$,T,A$:NQ=NQ+1
60 PRINT Q$;:IF T=1 THEN LINE INPUT "? ";R$ ELSE INPUT R
70 IF T=1 THEN GOSUB 300:R$=U$:OK(Q)=-(R$=A$) ELSE OK(Q)=-(R=VAL(A$))
80 SC=SC+OK(Q):LPRINT "CP 2";Q;OK(Q);SC
90 NEXT Q
100 RESTORE 600:READ ST$,N:LPRINT "CP 3 ";ST$;N
110 FOR Q=1 TO N:READ Q$,T,A$:NQ=NQ+1
120 IF T=1 THEN LINE INPUT R$:GOSUB 300:R$=U$:K=-(INSTR(A$,R$)=1 AND LEN(R$)>0) ELSE INPUT R:K=-(R=VAL(A$))
130 SC=SC+K:LPRINT "CP 4";Q;K;SC:NEXT Q
140 LINE INPUT "AGAIN (Y/N)";Y$:LPRINT "CP 5 ";Y$;LEN(Y$)
150 PRINT USING "SCORE ## OF ## = ###%";SC;NQ;SC*100/NQ
160 LPRINT "CP 6";SC;NQ;INT(SC*100/NQ+.5)
170 END
300 REM upper-case R$ into U$ and trim spaces at both ends
310 U$="":FOR I=1 TO LEN(R$):C$=MID$(R$,I,1):IF C$>="a" AND C$<="z" THEN C$=CHR$(ASC(C$)-32)
320 U$=U$+C$:NEXT I
330 IF LEFT$(U$,1)=" " THEN U$=MID$(U$,2):GOTO 330
340 IF RIGHT$(U$,1)=" " THEN U$=LEFT$(U$,LEN(U$)-1):GOTO 340
350 RETURN
500 DATA "CAPITALS AND NUMBERS",3
510 DATA "CAPITAL OF FRANCE",1,"PARIS"
520 DATA "3 + 4",2,"7"
530 DATA "BIGGEST ANIMAL",1,"BLUE WHALE"
600 DATA "HISTORY",3
610 DATA "MAN ON THE MOON (YES/NO)",1,"YES"
620 DATA "YEAR OF THE LANDING",2,"1969"
630 DATA "FIRST LETTER OF QUEEN",1,"QUEEN"
