10 REM ** TURTLE - DRAW MACROS WITH VARIABLES, SUBSTRINGS, SCALE AND ANGLE **
20 SCREEN 2:COLOR 15,1,1:CLS:DEFINT A-Z
30 REM 1: a square from a substring, at four angles
40 SQ$="U20R20D20L20":FOR A=0 TO 3:CC=A+2:DRAW "BM40,60A=A;C=CC;XSQ$;":NEXT
50 DRAW "A0"
60 REM 2: a star by variable lengths, scale changes, N (no move) and B (blank)
70 L=24:DRAW "BM128,96C15":FOR K=1 TO 5:DRAW "NE=L;NF=L;NG=L;NH=L;":L=L-4:NEXT
80 DRAW "S8BM200,40C11U10R10D10L10S4"
90 REM 3: M with absolute and relative moves, a spiral
100 DRAW "BM30,150C9":FOR K=1 TO 12:D=K*3:DRAW "M+=D;,0M+0,=D;":D=-D-2:DRAW "M+=D;,0M+0,=D;":NEXT
110 REM 4: read back pixels and a checksum of the pattern table
120 P$="":FOR Y=40 TO 170 STEP 26:FOR X=20 TO 240 STEP 22:P$=P$+CHR$(48+POINT(X,Y)):NEXT:NEXT
130 S=0:FOR I=0 TO 6143 STEP 7:S=(S+VPEEK(I)) AND 4095:NEXT
140 C=0:FOR I=8192 TO 14335 STEP 11:C=(C+VPEEK(I)) AND 4095:NEXT
170 SCREEN 0:LPRINT "CP 1 ";P$:LPRINT "CP 2";S;C
180 REM 5: PLAY with a variable tempo, a substring, and PLAY(0) while it runs
190 T=200:M$="L16CDEFG":PLAY "T=T;O4XM$;O5XM$;"
200 W=PLAY(0):FOR I=1 TO 2000:NEXT:LPRINT "CP 3";W
210 ON ERROR GOTO 300:DRAW "Q5":LPRINT "CP 4 AFTER BAD DRAW"
220 PLAY "Z":LPRINT "CP 5 AFTER BAD PLAY":PLAY "XNOSUCH$;":LPRINT "CP 6 EMPTY SUBSTRING OK"
230 LPRINT "CP 9 END":END
300 LPRINT "CP E";ERR;"IN";ERL:RESUME NEXT
