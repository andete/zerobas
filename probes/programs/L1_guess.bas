1 REM @ANSWERS JOOST|H|L|H|L|C|N
10 REM ** I GUESS YOUR NUMBER **
20 CLS:KEY OFF
30 PRINT "I GUESS YOUR NUMBER"
40 PRINT STRING$(19,"-")
50 INPUT "WHAT IS YOUR NAME";N$
60 IF N$="" THEN N$="FRIEND"
70 PRINT "HELLO, ";N$;"!"
80 LPRINT "CP 1 ";N$;LEN(N$)
90 PRINT "THINK OF A NUMBER 1 TO 100."
100 PRINT "ANSWER H (TOO HIGH), L (TOO LOW)"
110 PRINT "OR C (CORRECT)."
120 LO=1:HI=100:T=0
130 G=(LO+HI)\2:T=T+1
140 PRINT "GUESS";T;": IS IT";G;
150 INPUT A$
160 A$=LEFT$(A$,1)
170 LPRINT "CP 2";T;G;A$
180 IF A$="C" THEN 260
190 IF A$="H" THEN HI=G-1:GOTO 220
200 IF A$="L" THEN LO=G+1:GOTO 220
210 PRINT "PLEASE TYPE H, L OR C":GOTO 140
220 IF LO<=HI THEN 130
230 PRINT "YOU CHEATED, ";N$;"!"
240 LPRINT "CP 3 CHEAT";LO;HI
250 GOTO 280
260 PRINT "GOT IT IN";T;"GUESSES!"
270 LPRINT "CP 3 GOT";G;"IN";T
280 INPUT "PLAY AGAIN (Y/N)";A$
290 IF A$="Y" OR A$="y" THEN 90
300 PRINT "BYE, ";N$
310 LPRINT "CP 4 END"
320 END
