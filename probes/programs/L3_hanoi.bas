10 REM ** TOWERS OF HANOI - recursion on GOSUB with a hand-made frame stack **
20 CLS:DEFINT A-Z:DIM PG(3,8),H(3),SN(40),SF(40),ST(40),SV(40):SP=0:MV=0
30 DEF FN OT(A,B)=6-A-B
40 N=5:FOR I=1 TO N:PG(1,I)=N+1-I:NEXT:H(1)=N
50 GOSUB 400:LPRINT "CP 1 ";B$
60 SN=N:SF=1:ST=3:GOSUB 200
70 LPRINT "CP 3";MV;H(1);H(2);H(3):GOSUB 400:LPRINT "CP 4 ";B$
80 LPRINT "CP 5";MV=2^N-1;FN OT(1,3);FN OT(3,2)
90 END
200 REM move SN discs from SF to ST, recursively
210 IF SN=0 THEN RETURN
220 SP=SP+1:SN(SP)=SN:SF(SP)=SF:ST(SP)=ST
230 SN=SN-1:ST=FN OT(SF(SP),ST(SP)):GOSUB 200
240 SN=SN(SP):SF=SF(SP):ST=ST(SP)
250 D=PG(SF,H(SF)):H(SF)=H(SF)-1:H(ST)=H(ST)+1:PG(ST,H(ST))=D:MV=MV+1
260 IF MV MOD 8=0 THEN LPRINT "CP 2";MV;D;SF;ST;SP
270 SN=SN-1:SF=FN OT(SF(SP),ST(SP)):ST=ST(SP):GOSUB 200
280 SP=SP-1:RETURN
400 REM draw the three pegs into B$ with MID$ assignment
410 B$=STRING$(36,".")
420 FOR P=1 TO 3:FOR I=1 TO H(P):MID$(B$,(P-1)*12+I*2-1,1)=CHR$(48+PG(P,I)):NEXT I,P
430 RETURN
