1 REM @ANSWERS Y|ABC|Q
10 REM ** KEYS - FUNCTION KEYS, KEY LIST, INKEY$ AND INPUT$ **
20 SCREEN 0:WIDTH 40:CLS:KEY ON
30 KEY 1,"LIST"+CHR$(13):KEY 2,"RUN 100"+CHR$(13):KEY 5,"":KEY 10,"0123456789ABCDEF"
40 REM 1: the function-key row at the bottom, read back
50 S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(23*40+X)):NEXT:LPRINT "CP 1 [";S$;"]"
60 KEY OFF:S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(23*40+X)):NEXT:LPRINT "CP 2 [";S$;"]"
70 REM 2: KEY LIST on the screen, read back
80 CLS:KEY LIST:FOR Y=0 TO 10:S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(Y*40+X)):NEXT:LPRINT "|";S$:NEXT
90 REM 3: a menu key by INKEY$ polling, then INPUT$(3), then INKEY$ once more
100 CLS:PRINT "PRESS A KEY"
110 K$=INKEY$:IF K$="" THEN 110
120 LPRINT "CP 3 [";K$;"]";ASC(K$)
130 PRINT "THREE KEYS":T$=INPUT$(3):LPRINT "CP 4 [";T$;"]";LEN(T$)
140 PRINT "ONE MORE"
150 K$=INKEY$:IF K$="" THEN 150
160 LPRINT "CP 5 [";K$;"]";INKEY$="";POS(0);CSRLIN
170 LPRINT "CP 9 END":END
