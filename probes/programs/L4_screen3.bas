10 REM ** PIXEL STUDIO - SCREEN 3 blocks and SCREEN 2 drawing, read back **
20 REM every drawing is checksummed through POINT and VPEEK, nothing is guessed
30 SCREEN 3:COLOR 15,4,4:CLS
40 FOR I=0 TO 15:LINE (I*16,0)-(I*16+15,40),I,BF:NEXT
50 CIRCLE (128,120),50,8:PAINT (128,120),11,8:PSET (10,180),2
60 S=0:FOR Y=0 TO 191 STEP 12:FOR X=0 TO 255 STEP 12:S=S+POINT(X,Y):NEXT X,Y
70 V=0:FOR A=0 TO 1535 STEP 7:V=V+VPEEK(A):NEXT
80 LPRINT "CP 1";S;V;POINT(128,120);POINT(10,180);POINT(255,191)
90 SCREEN 2:COLOR 1,15,15:CLS
100 D$="U20R20D20L20":M=7:DRAW "BM40,40C6XD$;BM+30,0S8XD$;"
110 DRAW "BM120,100C4A1R30A0U=M;R=M;":LINE (0,150)-(255,150),12:LINE (20,160)-(60,190),9,B
120 CIRCLE (200,60),30,13,,,.5:CIRCLE (200,140),25,2,0,3.14159
130 PAINT (40,170),3,9
140 S=0:FOR Y=0 TO 191 STEP 6:FOR X=0 TO 255 STEP 6:S=S+POINT(X,Y):NEXT X,Y
150 V=0:FOR A=0 TO 6143 STEP 11:V=V+VPEEK(A):NEXT:C=0:FOR A=8192 TO 14335 STEP 13:C=C+VPEEK(A):NEXT
160 LPRINT "CP 2";S;V;C;POINT(40,170);POINT(200,30);POINT(-1,-1)
170 SCREEN 0:LPRINT "CP 3 END"
180 END
