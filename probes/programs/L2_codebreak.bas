1 REM @ANSWERS 2|ABCD|AABB|ABCDE|AB1D|BADC|DCBA|CDAB|1|ABCF|DCBA|ABCD|3
10 REM ** CODEBREAKER - GUESS THE FOUR-LETTER CODE **
20 KEY OFF:CLS:X=RND(-1986):C$="ABCDEF":S$=STRING$(4,"-")
30 PRINT "CODEBREAKER":PRINT STRING$(11,"=")
40 PRINT "1 EASY  2 NORMAL  3 QUIT";:INPUT M:IF M<1 OR M>3 THEN 40
50 ON M GOTO 60,70,900
60 L=4:GOTO 80
70 L=6
80 REM make the secret: L letters to choose from, no repeats
90 S$=SPACE$(4):I=1
100 K$=MID$(C$,INT(RND(1)*L)+1,1):IF INSTR(S$,K$) THEN 100
110 MID$(S$,I,1)=K$:I=I+1:IF I<=4 THEN 100
120 LPRINT "CP 1 LEVEL";M;"LETTERS ";LEFT$(C$,L);" SECRET ";S$
130 T=0
140 PRINT "GUESS";:INPUT G$:G$=LEFT$(G$+SPACE$(4),5)
150 IF LEN(G$)<>4 AND RIGHT$(G$,1)<>" " THEN PRINT "FOUR LETTERS!":LPRINT "CP 2 TOO LONG":GOTO 140
160 G$=LEFT$(G$,4):OK=-1:FOR I=1 TO 4:A=ASC(MID$(G$,I,1))-64:IF A<1 OR A>L THEN OK=0
170 NEXT:IF NOT OK THEN PRINT "ONLY ";LEFT$(C$,L):LPRINT "CP 3 BAD ";G$:GOTO 140
180 T=T+1:B=0:W=0:H$=S$
190 FOR I=1 TO 4:IF MID$(G$,I,1)=MID$(H$,I,1) THEN B=B+1:MID$(H$,I,1)="*":MID$(G$,I,1)="#"
200 NEXT
210 FOR I=1 TO 4:P=INSTR(H$,MID$(G$,I,1)):IF P THEN W=W+1:MID$(H$,P,1)="+"
220 NEXT
230 R$=STRING$(B,"B")+STRING$(W,"W")+STRING$(4-B-W,".")
240 PRINT USING "TRY ## \  \ &";T;G$;R$:LPRINT USING "CP 4 TRY ## & & ";T;LEFT$(G$,4);R$;:LPRINT H$
250 IF B=4 THEN 300
260 IF T<5 THEN 140
270 PRINT "THE CODE WAS ";S$:LPRINT "CP 5 LOST";T
280 GOTO 40
300 PRINT "CRACKED IN";T:LPRINT "CP 6 WON IN";T;CHR$(ASC("A")+T-1)
310 GOTO 40
900 LPRINT "CP 9 BYE":PRINT "BYE":END
