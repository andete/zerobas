10 REM ** SALES CHART - BARS AND A PIE IN SCREEN 2 **
20 ON ERROR GOTO 900
30 SCREEN 2:COLOR 15,1,1:CLS
40 DIM V(6):FOR I=1 TO 6:READ V(I):T=T+V(I):NEXT
50 REM ** axes and bars **
60 LINE (8,8)-(8,150),15:LINE (8,150)-(130,150),15
70 FOR I=1 TO 6
80 H=V(I)*130\90:X=12+(I-1)*19
90 LINE (X,150-H)-(X+14,149),2+I,BF:LINE (X,150-H)-(X+14,149),15,B
100 NEXT
110 REM ** a pie: one wedge per value, painted **
120 CIRCLE (196,80),50,15
130 A=0:FOR I=1 TO 6
140 B=A+V(I)/T*6.2832
150 LINE (196,80)-(196+50*COS(A),80-50*SIN(A)),15
160 M=(A+B)/2:PAINT (196+30*COS(M),80-30*SIN(M)),2+I,15
170 A=B:NEXT
180 REM ** an arrow drawn with DRAW, an arc, a filled box **
190 DRAW "BM140,170C11R30U4F6G6U4L30"
200 CIRCLE (60,175),12,13,0,3.1416
210 LINE (100,165)-(120,185),5,BF
220 REM ** sample the screen: one checksum per 8-pixel band **
230 FOR Y=0 TO 191 STEP 8:S=0
240 FOR X=0 TO 255 STEP 4:S=(S*3+POINT(X,Y+3)) MOD 9973:NEXT
250 LPRINT "CP 1";Y;S
260 NEXT
270 LPRINT "CP 2";POINT(196,80);POINT(15,140);POINT(150,170);T
280 SCREEN 0:PRINT "CHART DONE";T:END
900 LPRINT "CP 9 ERROR";ERR;"IN";ERL:SCREEN 0:END
1000 DATA 23,45,12,67,34,51
