10 REM ** DICE STATISTICS **
20 CLS:KEY OFF
30 PRINT "ROLLING TWO DICE 600 TIMES"
40 DIM C(12)
50 FOR K=1 TO 600
60 D1=INT(RND(1)*6)+1:D2=INT(RND(1)*6)+1
70 S=D1+D2:C(S)=C(S)+1
80 IF K MOD 100=0 THEN LPRINT "CP 1";K;D1;D2
90 NEXT K
100 MX=0:FOR S=2 TO 12:IF C(S)>MX THEN MX=C(S)
110 NEXT S
120 FOR S=2 TO 12
130 L=INT(C(S)*25/MX)
140 PRINT USING "## ###";S;C(S);:PRINT " ";STRING$(L,"*")
150 LPRINT "CP 2";S;C(S)
160 NEXT S
170 E=0:FOR S=2 TO 12:E=E+S*C(S):NEXT
180 PRINT "AVERAGE";E/600
190 LPRINT "CP 3";E;E/600;RND(0)
200 END
