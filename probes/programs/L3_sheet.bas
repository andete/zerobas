1 REM @ANSWERS B2=120|B3=80.5|C2=99.95|C3=-12|D4=7|A5=3|B5=*|D2=1E3|B9=1|C3=0.125|Q
10 REM ** SHEET - A TINY SPREADSHEET **
20 SCREEN 0:WIDTH 40:KEY OFF:CLS
30 NC=4:NR=5:DIM V#(NC,NR),T#(NC),S#(NR)
40 GOSUB 500
50 LOCATE 0,20:PRINT SPACE$(39):LOCATE 0,20
60 INPUT "CELL=VALUE (Q=QUIT)";C$
70 IF C$="Q" OR C$="q" THEN 400
80 E=INSTR(C$,"="):IF E<3 THEN 300
90 CL=ASC(C$)-64:RW=VAL(MID$(C$,2,E-2))
100 IF CL<1 OR CL>NC OR RW<1 OR RW>NR THEN 300
110 R$=MID$(C$,E+1):IF R$="*" THEN V#(CL,RW)=V#(CL,RW)*2 ELSE V#(CL,RW)=VAL(R$)
120 LPRINT "CP 1 ";C$;CL;RW;V#(CL,RW)
130 GOSUB 600:GOSUB 500:GOTO 50
300 LOCATE 0,21:PRINT "BAD CELL: ";C$;SPACE$(10):LPRINT "CP 2 BAD ";C$:GOTO 50
400 GOSUB 600:LOCATE 0,21
410 PRINT USING "GRAND TOTAL ########.##";G#
420 LPRINT "CP 4";G#:FOR R=1 TO NR:LPRINT USING "R# ######.###";R;S#(R):NEXT
430 END
500 REM ** DRAW **
510 LOCATE 0,0:PRINT "   ";:FOR C=1 TO NC:PRINT USING "    !    ";CHR$(64+C);:NEXT:PRINT "   TOTAL"
520 FOR R=1 TO NR:LOCATE 0,R*2:PRINT USING "##";R;
530 FOR C=1 TO NC:PRINT USING " ######.##";V#(C,R);:NEXT
540 PRINT USING " ######.##";S#(R):NEXT
550 LOCATE 0,NR*2+2:PRINT "SUM";:FOR C=1 TO NC:PRINT USING " ######.##";T#(C);:NEXT:RETURN
600 REM ** RECALC **
610 G#=0:FOR C=1 TO NC:T#(C)=0:NEXT
620 FOR R=1 TO NR:S#(R)=0:FOR C=1 TO NC
630 S#(R)=S#(R)+V#(C,R):T#(C)=T#(C)+V#(C,R):NEXT C:G#=G#+S#(R):NEXT R
640 LPRINT "CP 3";G#:RETURN
