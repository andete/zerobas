1 REM @DISK @ANSWERS GRINDER|7|29.95|DESCALER|40|3.5
10 REM ** STOCK - A RANDOM-ACCESS FILE OF ARTICLES **
15 MAXFILES=3
20 CLEAR 1000:SCREEN 0:WIDTH 37:KEY OFF:CLS:ON ERROR GOTO 900
25 REM (SCREEN 0: the CF-3300 boots in SCREEN 1, the VG-8020 and zerobas in 0)
30 OPEN "STOCK.DAT" AS #1 LEN=32
40 FIELD #1,12 AS N$,2 AS Q$,4 AS P$,14 AS D$
50 LPRINT "CP 1 OPEN";LOF(1)
60 FOR R=1 TO 6:READ A$,Q,P,B$:GOSUB 500:NEXT
70 FOR K=1 TO 2:INPUT "ARTICLE";A$:INPUT "QTY";Q:INPUT "PRICE";P:B$="NEW":R=R:GOSUB 500:R=R+1:NEXT
80 LPRINT "CP 2 RECORDS";LOF(1)/32
90 REM ** report, by record number **
100 T=0:FOR R=1 TO LOF(1)/32:GET #1,R
110 Q=CVI(Q$):P=CVS(P$):T=T+Q*P
115 REM (no \ \ string fields: the CF-3300 does not take them, TODO.md)
120 LPRINT USING "##";R;:LPRINT " ";N$;:LPRINT USING " #### ####.## #####.##";Q;P;Q*P;:LPRINT " ";D$
130 NEXT:LPRINT USING "STOCK VALUE ########.##";T
140 REM ** sell 3 of record 2, restock record 5: GET and PUT in place **
150 GET #1,2:LSET Q$=MKI$(CVI(Q$)-3):PUT #1,2
160 GET #1,5:LSET Q$=MKI$(CVI(Q$)+100):RSET D$="RESTOCKED":PUT #1
170 GET #1,1:GET #1:LPRINT "CP 3 NEXT GETS ";N$;CVI(Q$)
180 GET #1,5:LPRINT "CP 4 ";N$;CVI(Q$);"[";D$;"]"
190 REM ** export to a sequential file, read it back **
200 OPEN "STOCK.TXT" FOR OUTPUT AS #2
210 FOR R=1 TO LOF(1)/32:GET #1,R:PRINT #2,CHR$(34);LEFT$(N$,INSTR(N$+"  ","  ")-1);CHR$(34);",";CVI(Q$);",";CVS(P$):NEXT:CLOSE #2
220 OPEN "STOCK.TXT" FOR INPUT AS #2:C=0
230 IF EOF(2) THEN 260
240 INPUT #2,A$,Q,P:C=C+1:IF C MOD 3=1 THEN LPRINT "CP 5";C;A$;Q;P
250 GOTO 230
260 LPRINT "CP 6 READ BACK";C;LOC(2);LOF(2):CLOSE #2
270 REM ** a missing file: the error is trapped and the run goes on **
280 OPEN "NOFILE.DAT" FOR INPUT AS #3:LPRINT "CP 7 NOT REACHED"
290 CLOSE:KILL "STOCK.DAT":KILL "STOCK.TXT"
300 OPEN "STOCK.DAT" FOR INPUT AS #1
310 PRINT "DONE";T:LPRINT "CP 9 END";T
320 END
500 LSET N$=A$:LSET Q$=MKI$(Q):LSET P$=MKS$(P):LSET D$=B$:PUT #1,R:RETURN
900 LPRINT "CP 8 ERR";ERR;"IN";ERL:IF ERL=280 THEN RESUME 290
910 IF ERL=300 THEN RESUME 310
920 LPRINT "CP 8 UNEXPECTED":END
1000 DATA HAMMER,12,8.5,TOOLS,"SAW, FINE",4,15.75,TOOLS,NAILS 50MM,500,.02,FIXINGS
1010 DATA SCREWS 4X40,350,.04,FIXINGS,LADDER,2,89,ACCESS,GLOVES,30,2.25,SAFETY
