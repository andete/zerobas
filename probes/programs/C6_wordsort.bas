10 REM ** C6 - PROJECT EULER 22 AND 42 ON THE FIRST 120 NAMES / 150 WORDS OF THEIR LISTS **
20 CLEAR 3000:KEY OFF:CLS:DEFINT I-N:DIM N$(120)
30 REM P22 (first 120 names): sort them, then sum position * alphabetical value
40 RESTORE 1000:FOR I=1 TO 120:READ N$(I):NEXT
50 G=60
60 FOR I=G+1 TO 120:T$=N$(I):J=I
70 IF J>G THEN IF N$(J-G)>T$ THEN N$(J)=N$(J-G):J=J-G:GOTO 70
80 N$(J)=T$:NEXT I:IF G>1 THEN G=G\2:GOTO 60
90 S#=0:FOR I=1 TO 120:V=0:FOR K=1 TO LEN(N$(I)):V=V+ASC(MID$(N$(I),K,1))-64:NEXT K:S#=S#+CDBL(I)*V:NEXT I
100 LPRINT "P22<120>";S#;" ";N$(1);" ";N$(120)
110 REM P42 (first 150 words): words whose letter sum is a triangle number
120 RESTORE 2000:C=0:FOR I=1 TO 150:READ W$:V=0:FOR K=1 TO LEN(W$):V=V+ASC(MID$(W$,K,1))-64:NEXT K
130 T=0:N=0
140 IF T<V THEN N=N+1:T=T+N:GOTO 140
150 IF T=V THEN C=C+1
160 NEXT I:LPRINT "P42<150>";C
170 LPRINT "CP 9 END";FRE("")>0:END
