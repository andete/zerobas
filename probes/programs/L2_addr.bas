1 REM @ANSWERS A|VERMEULEN|ANNA|GENT|09-2231144|A|DE SMET|PIETER|BRUGGE|050-334455|A|AERTS|LIEVE|ANTWERPEN|03-2214567|A|MAES|JAN|GENT|09-2219988|L|S|GENT|D|2|L|P|Q
10 REM ** ADDRESS BOOK **
20 CLS:KEY OFF:WIDTH 37:MX=50
30 DIM NA$(MX),FI$(MX),CI$(MX),TE$(MX)
40 GOSUB 1000:REM 3 SAMPLE CARDS
50 PRINT:PRINT "A=ADD L=LIST S=SEARCH D=DELETE"
60 PRINT "P=PRINT Q=QUIT  (";N;"CARDS)"
70 INPUT "CHOICE";C$:C$=LEFT$(C$,1)
80 LPRINT "CP 1 MENU ";C$;N;FRE("")
90 K=INSTR("ALSDPQ",C$):IF K=0 THEN PRINT "?":GOTO 50
100 ON K GOSUB 200,300,400,500,600,700
110 IF K<>6 THEN 50
120 END
200 REM ** ADD **
210 IF N>=MX THEN PRINT "BOOK FULL":RETURN
220 N=N+1:INPUT "NAME";NA$(N):INPUT "FIRST NAME";FI$(N)
230 INPUT "CITY";CI$(N):INPUT "PHONE";TE$(N)
240 GOSUB 800:RETURN
300 REM ** LIST **
310 FOR I=1 TO N:GOSUB 900:NEXT:RETURN
400 REM ** SEARCH **
410 INPUT "TEXT";T$:F=0
420 FOR I=1 TO N
430 A$=NA$(I)+" "+FI$(I)+" "+CI$(I)
440 IF INSTR(A$,T$)>0 THEN GOSUB 900:F=F+1
450 NEXT:PRINT F;"FOUND":LPRINT "CP 4 SEARCH ";T$;F:RETURN
500 REM ** DELETE **
510 INPUT "NUMBER";D:IF D<1 OR D>N THEN PRINT "NO SUCH CARD":RETURN
520 LPRINT "CP 5 DEL ";NA$(D)
530 FOR I=D TO N-1:NA$(I)=NA$(I+1):FI$(I)=FI$(I+1):CI$(I)=CI$(I+1):TE$(I)=TE$(I+1):NEXT
540 NA$(N)="":FI$(N)="":CI$(N)="":TE$(N)="":N=N-1:RETURN
600 REM ** PRINT TO PRINTER **
610 LPRINT "CP 6 REPORT":LPRINT STRING$(36,"=")
620 FOR I=1 TO N
630 LPRINT USING "## \          \ \       \ \         \";I;NA$(I);FI$(I);CI$(I)
640 NEXT:LPRINT STRING$(36,"="):RETURN
700 PRINT "BYE":RETURN
800 REM ** SORT BY NAME, THEN FIRST NAME (INSERTION) **
810 FOR I=2 TO N
820 A$=NA$(I)+CHR$(1)+FI$(I):B$=FI$(I):C$=CI$(I):T$=TE$(I):J=I-1
830 IF J<1 THEN 860
840 IF NA$(J)+CHR$(1)+FI$(J)<=A$ THEN 860
850 NA$(J+1)=NA$(J):FI$(J+1)=FI$(J):CI$(J+1)=CI$(J):TE$(J+1)=TE$(J):J=J-1:GOTO 830
860 NA$(J+1)=LEFT$(A$,INSTR(A$,CHR$(1))-1):FI$(J+1)=B$:CI$(J+1)=C$:TE$(J+1)=T$
870 NEXT
880 LPRINT "CP 2 SORT";N;NA$(1);" ";NA$(N):RETURN
900 PRINT USING "## ";I;:PRINT NA$(I);", ";FI$(I)
910 PRINT "   ";CI$(I);TAB(20);TE$(I)
920 LPRINT "CP 3";I;NA$(I);"/";FI$(I);"/";CI$(I):RETURN
1000 RESTORE 1100:FOR I=1 TO 3:N=N+1
1010 READ NA$(N),FI$(N),CI$(N),TE$(N):NEXT:GOSUB 800:RETURN
