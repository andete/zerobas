1 REM @ANSWERS I|1|THE QUICK BROWN FOX|I|2|JUMPS OVER THE DOG|I|2|IS VERY QUICK|L|R|QUICK|SLOW|L|O|2|8|LAZY|D|1|L|F|DOG|Q
10 REM ** A LINE EDITOR **
20 CLEAR 1500:KEY OFF:CLS:WIDTH 37:ON ERROR GOTO 900
30 MX=20:DIM L$(MX):N=0
40 PRINT:PRINT "I=INS D=DEL L=LIST R=REPLACE"
50 PRINT "O=OVERTYPE F=FIND Q=QUIT  (";N;"LINES)"
60 INPUT "COMMAND";C$:C$=LEFT$(C$,1):LPRINT "CP 1 ";C$;N;FRE("")
70 K=INSTR("IDLROFQ",C$):IF K=0 THEN 40
80 ON K GOSUB 100,200,300,400,500,600,700
90 IF K<>7 THEN 40
95 END
100 INPUT "AT LINE";P:IF P<1 OR P>N+1 OR N>=MX THEN PRINT "NO":RETURN
110 LINE INPUT "TEXT? ";T$
120 FOR I=N TO P STEP -1:L$(I+1)=L$(I):NEXT:L$(P)=T$:N=N+1
130 LPRINT "CP 2 INS";P;LEN(T$):RETURN
200 INPUT "LINE";P:IF P<1 OR P>N THEN PRINT "NO":RETURN
210 FOR I=P TO N-1:L$(I)=L$(I+1):NEXT:L$(N)="":N=N-1:LPRINT "CP 3 DEL";P:RETURN
300 FOR I=1 TO N:PRINT USING "##";I;:PRINT " ";L$(I):LPRINT "CP 4";I;"[";L$(I);"]":NEXT:RETURN
400 INPUT "FIND";F$:INPUT "REPLACE BY";R$:C=0
410 FOR I=1 TO N
420 P=INSTR(L$(I),F$)
430 IF P=0 THEN 460
440 L$(I)=LEFT$(L$(I),P-1)+R$+MID$(L$(I),P+LEN(F$)):C=C+1
450 P=INSTR(P+LEN(R$),L$(I),F$):IF P THEN 440
460 NEXT:PRINT C;"CHANGED":LPRINT "CP 5 REPL";C;FRE(""):RETURN
500 INPUT "LINE";P:INPUT "COLUMN";Q:LINE INPUT "WORD? ";W$
510 IF P<1 OR P>N THEN PRINT "NO":RETURN
520 IF Q+LEN(W$)-1>LEN(L$(P)) THEN L$(P)=L$(P)+SPACE$(Q+LEN(W$)-1-LEN(L$(P)))
530 MID$(L$(P),Q)=W$:LPRINT "CP 6 OVER";P;Q;"[";L$(P);"]":RETURN
600 INPUT "WORD";F$:FOR I=1 TO N:P=INSTR(L$(I),F$):IF P THEN PRINT "LINE";I;"COLUMN";P:LPRINT "CP 7";I;P
610 NEXT:RETURN
700 PRINT "BYE":RETURN
900 LPRINT "CP 9 ERR";ERR;ERL:RESUME NEXT
