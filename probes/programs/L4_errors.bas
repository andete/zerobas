10 REM ** ERROR HANDLING THE WAY 80s PROGRAMS DID IT **
20 KEY OFF:CLS:ON ERROR GOTO 1000:ST=0
30 REM 1: RESUME NEXT over a division by zero inside an expression
40 ST=1:X=10:Y=0:Z=X/Y:LPRINT "CP 1";Z;ERR;ERL
50 REM 2: RESUME a corrected retry
60 ST=2:D=0:Q=100/D:LPRINT "CP 2";Q;D
70 REM 3: RESUME to a line, from inside a GOSUB
80 ST=3:GOSUB 500:LPRINT "CP 3 NOT REACHED"
90 LPRINT "CP 3";ST;ERR;ERL
100 REM 4: user errors and the message table
110 ST=4:FOR E=1 TO 3:ERROR 200+E:NEXT:LPRINT "CP 4";CE
120 REM 5: ON..GOSUB out of range falls through, a bad subscript is trapped
130 ST=5:K=7:ON K GOSUB 600,600:DIM A(5):A(9)=1:LPRINT "CP 5";K
140 REM 6: a string function error and a type mismatch
150 ST=6:A$=STRING$(300,"X"):B=VAL("12")+"3":LPRINT "CP 6";LEN(A$)
160 REM 7: error inside the handler's own retry count
170 ST=7:TR=0:OPEN "NUL:" FOR INPUT AS #1:LPRINT "CP 7";TR
180 ON ERROR GOTO 0:LPRINT "CP 8 END";ST:END
500 Q=1/0:RETURN
600 RETURN
1000 LPRINT "ERR";ERR;"IN";ERL;"ST";ST
1010 IF ST=1 THEN RESUME NEXT
1020 IF ST=2 THEN D=4:RESUME
1030 IF ST=3 THEN RESUME 90
1040 IF ST=4 THEN CE=CE+1:RESUME NEXT
1050 IF ST=5 OR ST=6 THEN RESUME NEXT
1060 IF ST=7 THEN TR=TR+1:IF TR<3 THEN RESUME ELSE RESUME NEXT
1070 RESUME NEXT
