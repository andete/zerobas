1 REM @ANSWERS 19861103|RENT|-450|19861101|SALARY|2150.75|19861115|GROCERIES|-87.4|0
10 REM ** HOUSEHOLD LEDGER **
20 CLEAR 1200:KEY OFF:CLS:WIDTH 37:ON ERROR GOTO 900
30 DEF FNY$(D$)=LEFT$(D$,4):DEF FNM(D$)=VAL(MID$(D$,5,2))
40 DEF FND$(D$)=MID$(D$,7,2)+"/"+MID$(D$,5,2)+"/"+FNY$(D$)
50 DEF FNR(X)=INT(X*100+SGN(X)*.5)/100
60 DIM D$(30),T$(30),A#(30):N=0
70 READ D$:IF D$="*" THEN 100
80 N=N+1:D$(N)=D$:READ T$(N),A#(N):GOTO 70
100 PRINT "NEW ENTRIES (DATE 0 TO STOP)"
110 INPUT "DATE YYYYMMDD";D$:IF D$="0" THEN 200
120 IF LEN(D$)<>8 OR FNM(D$)<1 OR FNM(D$)>12 THEN PRINT "BAD DATE":GOTO 110
130 INPUT "TEXT";T$:INPUT "AMOUNT";A#
140 N=N+1:D$(N)=D$:T$(N)=T$:A#(N)=FNR(A#):LPRINT "CP 1";N;FND$(D$);A#(N):GOTO 110
200 REM ** sort by date, stable (insertion) **
210 FOR I=2 TO N:D$=D$(I):T$=T$(I):A#=A#(I):J=I-1
220 IF J<1 THEN 240
230 IF D$(J)>D$ THEN D$(J+1)=D$(J):T$(J+1)=T$(J):A#(J+1)=A#(J):J=J-1:GOTO 220
240 D$(J+1)=D$:T$(J+1)=T$:A#(J+1)=A#:NEXT
300 REM ** the statement **
310 B#=0:IN#=0:OU#=0
320 FOR I=1 TO N:B#=B#+A#(I):IF A#(I)>0 THEN IN#=IN#+A#(I) ELSE OU#=OU#-A#(I)
330 LPRINT USING "\        \ \          \ #####.## ######.##";FND$(D$(I));T$(I);A#(I);B#
340 NEXT
350 LPRINT USING "IN  $$#####.##   OUT **#####.##";IN#;OU#:REM **$ differs: D-PUSTARDOL
360 LPRINT USING "BALANCE +#####.##  ##,###.##  ###.##-";B#;B#*10;-B#
370 LPRINT "CP 2";N;STR$(B#);VAL(STR$(B#))=B#;FNY$(D$(1));FNM(D$(N))
380 PRINT "BALANCE";B#:END
900 LPRINT "CP 9 ERR";ERR;ERL:RESUME NEXT
1000 DATA 19861005,OPENING,1000,19861010,PHONE,-35.15,19861020,GAS,-62.9,*
