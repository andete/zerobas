# S11_screen (D-SESSIONS, 2026-11-06): the screen as a user changes it at the prompt --
# KEY OFF / ON, a KEY definition and KEY LIST, WIDTH, SCREEN 1 and back, LOCATE,
# COLOR, and a program that draws in SCREEN 2 and returns to the prompt.
KEY OFF
PRINT "NO KEYS"
KEY ON
KEY 1,"HELLO"
KEY 2,"LIST"+CHR$(13)
KEY LIST
WIDTH 30
PRINT "123456789012345678901234567890123"
SCREEN 1
PRINT "IN SCREEN 1"
WIDTH 20
PRINT "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
SCREEN 0
WIDTH 37
LOCATE 10,5:PRINT "AT 10,5"
COLOR 15,1,1
NEW
10 SCREEN 2
20 LINE (0,0)-(255,191),15
30 FOR I=1 TO 300:NEXT
40 PRINT "BACK"
RUN
PRINT "DONE"
