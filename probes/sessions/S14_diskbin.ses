# @DISK
# S14_diskbin (D-SESSIONS, 2026-11-07): the rest of what a user does with a disk at the
# prompt -- BSAVE / BLOAD of a memory block (with and without an offset), a random file
# filled and read back by hand (FIELD, LSET / RSET, PUT, GET, LOC, LOF), COPY of one file
# and of a wildcard, FILES with a pattern, DSKF, MAXFILES, and the errors on the way
# (a FIELD wider than the record, GET past the end, a bad file number, a wildcard name
# for SAVE). CF-3300 + the DISK target. (Record 2 is never written; only its LENGTH is
# read -- its bytes are the CF-3300's stale sector buffer, D-RECHOLE.)
NEW
CLEAR 200,&HCFFF
FOR I=0 TO 15:POKE &HD000+I,I*3:NEXT
BSAVE "BLOCK.BIN",&HD000,&HD00F
FOR I=0 TO 15:POKE &HD000+I,0:NEXT
BLOAD "BLOCK.BIN"
PRINT PEEK(&HD000);PEEK(&HD005);PEEK(&HD00F)
BLOAD "BLOCK.BIN",&H20
PRINT PEEK(&HD020);PEEK(&HD02F)
OPEN "REC.DAT" AS #1 LEN=20
FIELD #1,8 AS N$,12 AS C$
LSET N$="ANNA":RSET C$="AMSTERDAM":PUT #1,1
LSET N$="BERT":RSET C$="UTRECHT":PUT #1,3
PRINT LOC(1);LOF(1)
GET #1,1:PRINT "[";N$;"][";C$;"]"
GET #1,2:PRINT LEN(N$)
GET #1,3:PRINT "[";N$;"][";C$;"]"
GET #1,9
FIELD #1,15 AS A$,10 AS B$
CLOSE #1
PRINT #7,"X"
COPY "BLOCK.BIN" TO "BLOCK2.BIN"
COPY "*.DAT" TO "*.BAK"
FILES
FILES "*.BIN"
FILES "B*"
PRINT DSKF(0)>300
MAXFILES=3
OPEN "A.TXT" FOR OUTPUT AS #3:PRINT #3,"THREE":CLOSE
OPEN "A.TXT" FOR INPUT AS #4
MAXFILES=1
SAVE "P*.BAS"
KILL "*.BAK"
FILES
