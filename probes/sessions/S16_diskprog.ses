# @DISK
# S16_diskprog (D-SESSIONS, 2026-11-07): a PROGRAM that works its files -- a missing
# file trapped by ON ERROR (ERR / ERL, RESUME NEXT), PRINT # and PRINT # USING into one
# file while a second is open, both read back on two channels at once, INPUT$ and LOF /
# LOC, reading past the end inside the handler, CLOSE of everything, then a chain to a
# second program with RUN "file" (its variables gone). CF-3300 + the DISK target.
# (NEW before the direct INPUT$ lines: a program's ON ERROR stays armed at the
# prompt on both machines, and would turn their output into TRAP lines.)
NEW
MAXFILES=2
10 ON ERROR GOTO 900
20 OPEN "NOPE.DAT" FOR INPUT AS #1
30 PRINT "AFTER";ERR;ERL
40 OPEN "A.DAT" FOR OUTPUT AS #1
50 OPEN "B.DAT" FOR OUTPUT AS #2
60 FOR I=1 TO 3:PRINT #1,"N";I;",";I*1.5:PRINT #2,USING "##.##";I/3:NEXT
70 CLOSE
80 X=42:PRINT "X=";X
90 END
900 PRINT "TRAP";ERR;"AT";ERL:RESUME NEXT
RUN
CLS
10 ON ERROR GOTO 900
20 OPEN "A.DAT" FOR INPUT AS #1:OPEN "B.DAT" FOR INPUT AS #2
30 PRINT "LOF";LOF(1);LOF(2)
40 FOR I=1 TO 4:INPUT #1,N$,V:LINE INPUT #2,B$:PRINT N$;V;"[";B$;"]";LOC(1):NEXT
50 PRINT "DONE"
60 CLOSE:END
900 PRINT "TRAP";ERR;"AT";ERL:CLOSE:END
RUN
NEW
OPEN "A.DAT" FOR INPUT AS #1
PRINT INPUT$(7,#1)
PRINT INPUT$(100,#1)
CLOSE
NEW
10 PRINT "SECOND, X=";X
20 END
SAVE "SECOND"
NEW
10 X=7:PRINT "FIRST, X=";X
20 RUN "SECOND"
RUN
FILES
