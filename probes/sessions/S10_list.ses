# S10_list (D-SESSIONS, 2026-11-06): LIST the way it is used -- a program long enough to
# scroll (typed through AUTO), every LIST range form, LIST ., LLIST to the printer,
# Ctrl-STOP in the middle of a long LIST, DELETE of a range, then LIST again.
NEW
AUTO 10,10
PRINT "LINE 01":A1=A1+1
PRINT "LINE 02":A2=A2+2
PRINT "LINE 03":A3=A3+3
PRINT "LINE 04":A4=A4+4
PRINT "LINE 05":A0=A0+5
PRINT "LINE 06":A1=A1+6
PRINT "LINE 07":A2=A2+7
PRINT "LINE 08":A3=A3+8
PRINT "LINE 09":A4=A4+9
PRINT "LINE 10":A0=A0+10
PRINT "LINE 11":A1=A1+11
PRINT "LINE 12":A2=A2+12
PRINT "LINE 13":A3=A3+13
PRINT "LINE 14":A4=A4+14
PRINT "LINE 15":A0=A0+15
PRINT "LINE 16":A1=A1+16
PRINT "LINE 17":A2=A2+17
PRINT "LINE 18":A3=A3+18
PRINT "LINE 19":A4=A4+19
PRINT "LINE 20":A0=A0+20
PRINT "LINE 21":A1=A1+21
PRINT "LINE 22":A2=A2+22
PRINT "LINE 23":A3=A3+23
PRINT "LINE 24":A4=A4+24
PRINT "LINE 25":A0=A0+25
PRINT "LINE 26":A1=A1+26
PRINT "LINE 27":A2=A2+27
PRINT "LINE 28":A3=A3+28
PRINT "LINE 29":A4=A4+29
PRINT "LINE 30":A0=A0+30
PRINT "LINE 31":A1=A1+31
PRINT "LINE 32":A2=A2+32
PRINT "LINE 33":A3=A3+33
PRINT "LINE 34":A4=A4+34
PRINT "LINE 35":A0=A0+35
PRINT "LINE 36":A1=A1+36
PRINT "LINE 37":A2=A2+37
PRINT "LINE 38":A3=A3+38
PRINT "LINE 39":A4=A4+39
PRINT "LINE 40":A0=A0+40
{CTRLC}
LIST
{STOP}
PRINT "STOPPED"
LIST 100-150
LIST -40
LIST 360-
LIST 200
LIST .
LLIST 50-70
DELETE 100-300
LIST
RUN
