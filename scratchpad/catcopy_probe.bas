10 ON ERROR GOTO 900
20 T$=STRING$(95,"A")+" ":LPRINT "CP 0";FRE("")
30 Q=INSTR(1,T$+" "," "):LPRINT "CP 1";Q;FRE("")
40 W$=MID$(T$,1,5):LPRINT "CP 2";FRE("")
50 FOR K=1 TO 5:Q=INSTR(K,T$+" "," "):W$=MID$(T$,K,Q-K):LPRINT "CP 3";K;LEN(W$);FRE(""):NEXT
60 T$=T$+"BCDEFGHIJKLMNOPQRSTUVWXYZ":LPRINT "CP 4";LEN(T$);FRE("")
70 Q=INSTR(1,T$+" "," "):LPRINT "CP 5";Q;FRE("")
80 END
900 LPRINT "CP 9 ERR";ERR;"IN";ERL;FRE(""):RESUME NEXT
