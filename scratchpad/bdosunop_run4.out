# cf: done-flag a50d (want a5 + last row 0d)
# zb: done-flag a50d (want a5 + last row 0d)
fn  what                                       cf                        zb
1A  SETDTA $D400         A=08 HL=5808 DE=D400 BC=581A  A=E1 HL=0000 DE=D400 BC=1A1A
0D  DSKRST               A=00 HL=9F00 DE=F1AA BC=9F0D  A=00 HL=0000 DE=0000 BC=0D0D
