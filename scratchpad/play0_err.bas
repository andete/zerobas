10 REM PLAY(n) after a trapped PLAY error, and for a voice given ""
20 FOR K=1 TO 300:NEXT:ON ERROR GOTO 100
30 PLAY "T4":A=PLAY(0):PLAY "V10":B=PLAY(0):FOR I=1 TO 500:NEXT:C=PLAY(0)
40 PLAY "C":D=PLAY(0):FOR I=1 TO 3000:NEXT:E=PLAY(0)
50 PLAY "","","":F=PLAY(0):G=PLAY(1)
60 PLAY "V9","V9","":H=PLAY(3):J=PLAY(2)
70 LPRINT "A";A;B;C;D;E;F;G;H;J;ER:END
100 ER=ER+1:RESUME NEXT
