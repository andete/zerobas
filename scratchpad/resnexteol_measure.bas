10 REM D-RESNEXTEOL: RESUME NEXT after an error raised at a line's END
20 ON ERROR GOTO 900:CLS:K=1
30 PRINT USING "##";"AB"
40 LPRINT "A":LPRINT "A2"
50 IF K=1 THEN PRINT USING "##";"AB"
60 LPRINT "B":LPRINT "B2"
70 A=1/0
80 LPRINT "C":LPRINT "C2"
90 IF K=1 THEN A=1/0
100 LPRINT "D":LPRINT "D2"
110 A$=STRING$(300,"A")
120 LPRINT "E":LPRINT "E2"
130 IF K=1 THEN A$=STRING$(300,"A")
140 LPRINT "F":LPRINT "F2"
150 IF K=1 THEN PRINT USING "!";5
160 LPRINT "G":LPRINT "G2"
170 IF K=1 THEN ERROR 50
180 LPRINT "H":LPRINT "H2"
190 LPRINT "END":END
900 LPRINT "ERR";ERR;ERL:RESUME NEXT
