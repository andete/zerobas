1 REM @DISK
10 REM D-INPLF: INPUT# / LINE INPUT# when the next byte is a lone LF
20 CLEAR 500:MAXFILES=2:SCREEN 0:CLS:ON ERROR GOTO 900
30 OPEN "N.TXT" FOR OUTPUT AS #1:PRINT #1,9:PRINT #1,36:PRINT #1,81:PRINT #1,"AB":PRINT #1,"CD":CLOSE
40 OPEN "N.TXT" FOR INPUT AS #1:X$=INPUT$(4,#1):INPUT #1,V:INPUT #1,W:LPRINT "A";LEN(X$);V;W:CLOSE
50 OPEN "N.TXT" FOR INPUT AS #1:X$=INPUT$(5,#1):INPUT #1,V:LPRINT "B";LEN(X$);V:CLOSE
60 OPEN "N.TXT" FOR INPUT AS #1:X$=INPUT$(4,#1):LINE INPUT #1,L$:LINE INPUT #1,M$:LPRINT "C";LEN(L$);LEN(M$);M$:CLOSE
70 OPEN "N.TXT" FOR INPUT AS #1:X$=INPUT$(17,#1):INPUT #1,A$:INPUT #1,B$:LPRINT "D ";ASC(RIGHT$(X$,1));"[";A$;"][";B$;"]":CLOSE
80 OPEN "L.TXT" FOR OUTPUT AS #1:PRINT #1,"1";CHR$(10);"2";CHR$(10);"3":CLOSE
90 OPEN "L.TXT" FOR INPUT AS #1:INPUT #1,P,Q,R:LPRINT "E";P;Q;R:CLOSE
100 OPEN "L.TXT" FOR INPUT AS #1:LINE INPUT #1,L$:LPRINT "F";LEN(L$);ASC(MID$(L$,2,1)):CLOSE
110 OPEN "L.TXT" FOR INPUT AS #1:INPUT #1,S$:LPRINT "G [";S$;"]";LEN(S$):CLOSE
120 OPEN "M.TXT" FOR OUTPUT AS #1:PRINT #1,"7";CHR$(13);CHR$(10);CHR$(10);"8":CLOSE
130 OPEN "M.TXT" FOR INPUT AS #1:INPUT #1,P,Q:LPRINT "H";P;Q;EOF(1):CLOSE
140 LPRINT "END":END
900 LPRINT "ERR";ERR;ERL:RESUME NEXT
