# --- str_cmp_bits: the unsigned-byte comparator (§2 D-3) ---
PASS  str_cmp_bits(b'AB',b'AB') = 2 (want 2, BC preserved)
PASS  str_cmp_bits(b'AB',b'ABC') = 1 (want 1, BC preserved)
PASS  str_cmp_bits(b'ABC',b'AB') = 4 (want 4, BC preserved)
PASS  str_cmp_bits(b'A',b'a') = 1 (want 1, BC preserved)
PASS  str_cmp_bits(b'a',b'A') = 4 (want 4, BC preserved)
PASS  str_cmp_bits(b'ABD',b'ABC') = 4 (want 4, BC preserved)
PASS  str_cmp_bits(b'ABC',b'ABD') = 1 (want 1, BC preserved)
PASS  str_cmp_bits(b'',b'A') = 1 (want 1, BC preserved)
PASS  str_cmp_bits(b'A',b'') = 4 (want 4, BC preserved)
PASS  str_cmp_bits(b'',b'') = 2 (want 2, BC preserved)
# --- full ev_rel path (eval): literals, all six operators ---
PASS  "AB"="AB" = 65535 (want 65535)
PASS  "AB"<>"AB" = 0 (want 0)
PASS  "AB"<"ABC" = 65535 (want 65535)
PASS  "AB">"ABC" = 0 (want 0)
PASS  "AB"<="ABC" = 65535 (want 65535)
PASS  "AB">="ABC" = 0 (want 0)
PASS  "A"<"a" = 65535 (want 65535)
PASS  "ABD">"ABC" = 65535 (want 65535)
PASS  ""<"A" = 65535 (want 65535)
PASS  ""="" = 65535 (want 65535)
# --- compound-form merge (<=, >=, <>) on an EQUAL pair ---
PASS  "A"<="A" (equal -> true) = 65535 (want 65535)
PASS  "A">="A" (equal -> true) = 65535 (want 65535)
PASS  "A"<>"A" (equal -> false) = 0 (want 0)
# --- compound-form merge on an ORDERED pair ---
PASS  "B"<="A" (false) = 0 (want 0)
PASS  "B">="A" (true) = 65535 (want 65535)
