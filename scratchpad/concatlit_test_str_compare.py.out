PASS  "A"<= "B" (no type mismatch) = 65535 (want 65535)
PASS  "A"<= "B": FPERR clean
PASS  "A">= "B" (no type mismatch) = 0 (want 0)
PASS  "A">= "B": FPERR clean
PASS  "A"<>  "B" (no type mismatch) = 65535 (want 65535)
PASS  "A"<>  "B": FPERR clean
PASS  "A"< = "B" (no type mismatch) = 65535 (want 65535)
PASS  "A"< = "B": FPERR clean
PASS  "A"< "B" (no type mismatch) = 65535 (want 65535)
PASS  "A"< "B": FPERR clean
# --- string VARIABLE operands ---
PASS  A$<B$  A$=AB B$=ABC = 65535 (want 65535)
PASS  A$=B$  A$=AB B$=ABC = 0 (want 0)
# --- concat / nested-function operands (spec nest) ---
PASS  "A"+"B"="AB" = 65535 (want 65535)
PASS  LEFT$("HELLO",3)="HEL" = 65535 (want 65535)
PASS  A$+B$="HELLO" = 65535 (want 65535)
# --- boolean composition above ev_rel (AND/OR/NOT) ---
PASS  ("A"="A") AND ("B"="B") = 65535 (want 65535)
PASS  ("A"="A") AND ("B"="C") = 0 (want 0)
PASS  NOT ("A"="B") = 65535 (want 65535)
# --- D-2 type mismatch: the comparator's own signal ---
PASS  "A"<5  (string LHS, numeric RHS): DE=0, ERRMARK=$DD, FPERR=10
