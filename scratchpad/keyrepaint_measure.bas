10 REM D-KEYREPAINT: KEY n,"..." repaints the shown key row at once
20 SCREEN 0:WIDTH 40:CLS:KEY ON
30 KEY 1,"LIST"+CHR$(13):KEY 2,"RUN 100"+CHR$(13):KEY 5,""
40 S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(23*40+X)):NEXT:LPRINT "A [";S$;"]"
50 SCREEN 1:KEY 3,"ABCDEFG"
60 S$="":FOR X=0 TO 31:S$=S$+CHR$(VPEEK(6144+23*32+X)):NEXT:LPRINT "B [";S$;"]"
70 KEY OFF:SCREEN 0:KEY 4,"QQQQ"
80 S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(23*40+X)):NEXT:LPRINT "C [";S$;"]"
90 KEY ON:SCREEN 2:KEY 6,"ZZZZZZZZ":N=PEEK(&HF922)+256*PEEK(&HF923)+920:T=0:FOR X=0 TO 39:T=T+VPEEK(N+X)+VPEEK(920+X):NEXT
100 SCREEN 0:LPRINT "D";T
110 KEY 1,"color ":KEY 2,"auto ":KEY 3,"goto ":KEY 4,"list ":KEY 6,"color 15,4,4"+CHR$(13)
120 S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(23*40+X)):NEXT:LPRINT "E [";S$;"]"
