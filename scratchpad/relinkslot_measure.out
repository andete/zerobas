Philips_VG_8020 ENDED t=30.2
1 LLIST:P=PEEK(&HF676)+256*PEEK(&HF677):FOR I=1 TO 12:L=PEEK(P)+256*PEEK(P+1):IF L=0 THEN 3
2 LPRINT PEEK(P+2)+256*PEEK(P+3);L-P;:P=L:NEXT
3 LPRINT "END":END
5 X=1.5
10 A=4
15 C=3
20 B=2:REM SECOND
30 PRINT "THIRTY"
35 E$="Z":DATA 1,2
40 REM LAST

