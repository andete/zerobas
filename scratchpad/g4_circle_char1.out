  circle(30,30),10,15,,,2            -> BC 28 0F 1E 2C 0F 1E 29 2C 0F 0A 2C 0F 0F 2C 2C 2C 13 00
  circle(30,30),10,,,,0.5            -> BC 28 0F 1E 2C 0F 1E 29 2C 0F 0A 2C 2C 2C 2C 1D 40 50 00 00 00
  circle(30,30),10,15,-1,-2          -> BC 28 0F 1E 2C 0F 1E 29 2C 0F 0A 2C 0F 0F 2C F2 12 2C F2 13 00

