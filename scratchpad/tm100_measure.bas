10 ON ERROR GOTO 900
20 T=5:LPRINT "A";T
30 T=0:FOR X=0 TO 3:T=T+VPEEK(X):NEXT:LPRINT "B";T
40 SCREEN 2:T=7:SCREEN 0:LPRINT "C";T
50 KEY ON:SCREEN 2:T=8:SCREEN 0:LPRINT "D";T
60 KEY ON:SCREEN 2:KEY 6,"ZZ":T=9:SCREEN 0:LPRINT "E";T
70 KEY OFF:SCREEN 2:KEY 6,"ZZ":T=9:SCREEN 0:LPRINT "F";T
80 LPRINT "G";VARPTR(T)
90 END
900 LPRINT "ERR";ERR;ERL:RESUME NEXT
