keyword case                             Philips_VG_8   C-BIOS_MSX1_
LEFT$   PRINT LEFT$(5,1)                     (13, 20)       (13, 20)
LEFT$   PRINT LEFT$("AB","A")                (13, 20)       (13, 20)
LEFT$   PRINT LEFT$("AB",-1)                  (5, 20)        (5, 20)
LEFT$   PRINT LEFT$("AB",256)                 (5, 20)        (5, 20)
LEFT$   PRINT LEFT$("AB",70000)               (6, 20)        (6, 20)
LEFT$   PRINT LEFT$("AB")                     (2, 20)        (2, 20)
LEFT$   PRINT LEFT$()                         (2, 20)        (2, 20)
LEFT$   PRINT LEFT$("AB",1,1)                 (2, 20)        (2, 20)
RIGHT$  PRINT RIGHT$(5,1)                    (13, 20)       (13, 20)
RIGHT$  PRINT RIGHT$("AB","A")               (13, 20)       (13, 20)
RIGHT$  PRINT RIGHT$("AB",-1)                 (5, 20)        (5, 20)
RIGHT$  PRINT RIGHT$("AB",256)                (5, 20)        (5, 20)
RIGHT$  PRINT RIGHT$("AB",70000)              (6, 20)        (6, 20)
RIGHT$  PRINT RIGHT$("AB")                    (2, 20)        (2, 20)
RIGHT$  PRINT RIGHT$()                        (2, 20)        (2, 20)
RIGHT$  PRINT RIGHT$("AB",1,1)                (2, 20)        (2, 20)
STRING$ PRINT STRING$("A","A")               (13, 20)       (13, 20)
STRING$ PRINT STRING$(-1,"A")                 (5, 20)        (5, 20)
STRING$ PRINT STRING$(256,"A")                (5, 20)        (5, 20)
STRING$ PRINT STRING$(2,"")                   (5, 20)        (2, 20)
STRING$ PRINT STRING$(2,256)                  (5, 20)        (5, 20)
STRING$ PRINT STRING$(2,-1)                   (5, 20)        (5, 20)
STRING$ PRINT STRING$(2)                      (2, 20)        (2, 20)
STRING$ PRINT STRING$()                       (2, 20)        (2, 20)
STRING$ PRINT STRING$(2,"A","A")              (2, 20)        (2, 20)
HEX$    PRINT HEX$("A")                      (13, 20)       (13, 20)
HEX$    PRINT HEX$(70000)                     (6, 20)        (6, 20)
HEX$    PRINT HEX$(-70000)                    (6, 20)        (6, 20)
HEX$    PRINT HEX$()                          (2, 20)        (2, 20)
HEX$    PRINT HEX$(1,1)                       (2, 20)        (2, 20)
OCT$    PRINT OCT$("A")                      (13, 20)       (13, 20)
OCT$    PRINT OCT$(70000)                     (6, 20)        (6, 20)
OCT$    PRINT OCT$(-70000)                    (6, 20)        (6, 20)
OCT$    PRINT OCT$()                          (2, 20)        (2, 20)
OCT$    PRINT OCT$(1,1)                       (2, 20)        (2, 20)
BIN$    PRINT BIN$("A")                      (13, 20)       (13, 20)
BIN$    PRINT BIN$(70000)                     (6, 20)        (6, 20)
BIN$    PRINT BIN$(-70000)                    (6, 20)        (6, 20)
BIN$    PRINT BIN$()                          (2, 20)        (2, 20)
BIN$    PRINT BIN$(1,1)                       (2, 20)        (2, 20)
SPACE$  PRINT SPACE$("A")                    (13, 20)       (13, 20)
SPACE$  PRINT SPACE$(-1)                      (5, 20)        (5, 20)
SPACE$  PRINT SPACE$(256)                     (5, 20)        (5, 20)
SPACE$  PRINT SPACE$()                        (2, 20)        (2, 20)
SPACE$  PRINT SPACE$(1,1)                     (2, 20)        (2, 20)
MKI$    PRINT MKI$("A")                       (5, 20)       (13, 20)
MKI$    PRINT MKI$(32768)                     (5, 20)        (5, 20)
MKI$    PRINT MKI$(-32769)                    (5, 20)        (5, 20)
MKI$    PRINT MKI$()                          (2, 20)        (2, 20)
MKI$    PRINT MKI$(1,1)                       (2, 20)       (13, 20)
CVI     PRINT CVI(5)                          (5, 20)       (13, 20)
CVI     PRINT CVI("")                         (5, 20)        (5, 20)
CVI     PRINT CVI("A")                        (5, 20)        (5, 20)
CVI     PRINT CVI()                           (2, 20)        (2, 20)
CVI     PRINT CVI("AB","AB")                  (2, 20)        (2, 20)
STR$    PRINT STR$("A")                      (13, 20)       (13, 20)
STR$    PRINT STR$()                          (2, 20)        (2, 20)
STR$    PRINT STR$(1,1)                       (2, 20)        (2, 20)
CINT    PRINT CINT("A")                      (13, 20)       (13, 20)
CINT    PRINT CINT(32768)                     (6, 20)        (6, 20)
CINT    PRINT CINT(-32769)                    (6, 20)        (6, 20)
CINT    PRINT CINT()                          (2, 20)        (2, 20)
CINT    PRINT CINT(1,1)                       (2, 20)        (2, 20)
FIX     PRINT FIX("A")                       (13, 20)       (13, 20)
FIX     PRINT FIX(-1E38)                           OK             OK
FIX     PRINT FIX()                           (2, 20)        (2, 20)
FIX     PRINT FIX(1,1)                        (2, 20)        (2, 20)
CSNG    PRINT CSNG("A")                      (13, 20)       (13, 20)
CSNG    PRINT CSNG(1E38)                           OK             OK
CSNG    PRINT CSNG()                          (2, 20)        (2, 20)
CSNG    PRINT CSNG(1,1)                       (2, 20)        (2, 20)
CDBL    PRINT CDBL("A")                      (13, 20)       (13, 20)
CDBL    PRINT CDBL(1E38)                           OK             OK
CDBL    PRINT CDBL()                          (2, 20)        (2, 20)
CDBL    PRINT CDBL(1,1)                       (2, 20)        (2, 20)
SIN     PRINT SIN("A")                       (13, 20)       (13, 20)
SIN     PRINT SIN(1E38)                            OK             OK
SIN     PRINT SIN()                           (2, 20)        (2, 20)
SIN     PRINT SIN(1,1)                        (2, 20)        (2, 20)
COS     PRINT COS("A")                       (13, 20)       (13, 20)
COS     PRINT COS(1E38)                            OK             OK
COS     PRINT COS()                           (2, 20)        (2, 20)
COS     PRINT COS(1,1)                        (2, 20)        (2, 20)
TAN     PRINT TAN("A")                       (13, 20)       (13, 20)
TAN     PRINT TAN(1E38)                       (6, 20)             OK
TAN     PRINT TAN()                           (2, 20)        (2, 20)
TAN     PRINT TAN(1,1)                        (2, 20)        (2, 20)
ATN     PRINT ATN("A")                       (13, 20)       (13, 20)
ATN     PRINT ATN(1E38)                            OK             OK
ATN     PRINT ATN()                           (2, 20)        (2, 20)
ATN     PRINT ATN(1,1)                        (2, 20)        (2, 20)
VPEEK   PRINT VPEEK("A")                     (13, 20)       (13, 20)
VPEEK   PRINT VPEEK(16384)                    (5, 20)        (5, 20)
VPEEK   PRINT VPEEK(-1)                       (5, 20)        (5, 20)
VPEEK   PRINT VPEEK(70000)                    (6, 20)        (6, 20)
VPEEK   PRINT VPEEK()                         (2, 20)        (2, 20)
VPEEK   PRINT VPEEK(1,1)                      (2, 20)        (2, 20)
POKE    POKE "A",1                           (13, 20)       (13, 20)
POKE    POKE 65536,1                          (6, 20)        (6, 20)
POKE    POKE -32769,1                         (6, 20)        (6, 20)
POKE    POKE &H9000,"A"                      (13, 20)       (13, 20)
POKE    POKE &H9000,256                       (5, 20)        (5, 20)
POKE    POKE &H9000,-1                        (5, 20)        (5, 20)
POKE    POKE &H9000                           (2, 20)        (2, 20)
POKE    POKE                                 (24, 20)       (24, 20)
POKE    POKE &H9000,1,1                       (2, 20)        (2, 20)
VPOKE   VPOKE "A",1                          (13, 20)       (13, 20)
VPOKE   VPOKE 16384,1                         (5, 20)        (5, 20)
VPOKE   VPOKE -1,1                            (5, 20)        (5, 20)
VPOKE   VPOKE 70000,1                         (6, 20)        (6, 20)
VPOKE   VPOKE 1,"A"                          (13, 20)       (13, 20)
VPOKE   VPOKE 1,256                           (5, 20)        (5, 20)
VPOKE   VPOKE 1,-1                            (5, 20)        (5, 20)
VPOKE   VPOKE 1                               (2, 20)        (2, 20)
VPOKE   VPOKE                                (24, 20)       (24, 20)
VPOKE   VPOKE 1,1,1                           (2, 20)        (2, 20)
SOUND   SOUND "A",0                          (13, 20)       (13, 20)
SOUND   SOUND 14,0                            (5, 20)        (5, 20)
SOUND   SOUND -1,0                            (5, 20)        (5, 20)
SOUND   SOUND 256,0                           (5, 20)        (5, 20)
SOUND   SOUND 8,"A"                          (13, 20)       (13, 20)
SOUND   SOUND 8,256                           (5, 20)        (5, 20)
SOUND   SOUND 8,-1                            (5, 20)        (5, 20)
SOUND   SOUND 8                               (2, 20)        (2, 20)
SOUND   SOUND                                (24, 20)       (24, 20)
SOUND   SOUND 8,0,0                           (2, 20)        (2, 20)

# the reference's error set per keyword form (code: first case)
LEFT$  prefix         2: PRINT LEFT$("AB")  5: PRINT LEFT$("AB",-1)  6: PRINT LEFT$("AB",70000)  13: PRINT LEFT$(5,1)
RIGHT$ suffix         2: PRINT RIGHT$("AB")  5: PRINT RIGHT$("AB",-1)  6: PRINT RIGHT$("AB",70000)  13: PRINT RIGHT$(5,1)
STRING$ repeat         2: PRINT STRING$(2)  5: PRINT STRING$(-1,"A")  13: PRINT STRING$("A","A")
HEX$   to-hex         2: PRINT HEX$()  6: PRINT HEX$(70000)  13: PRINT HEX$("A")
OCT$   to-octal       2: PRINT OCT$()  6: PRINT OCT$(70000)  13: PRINT OCT$("A")
BIN$   to-binary      2: PRINT BIN$()  6: PRINT BIN$(70000)  13: PRINT BIN$("A")
SPACE$ pad            2: PRINT SPACE$()  5: PRINT SPACE$(-1)  13: PRINT SPACE$("A")
MKI$   int-to-string  2: PRINT MKI$()  5: PRINT MKI$("A")
CVI    string-to-int  2: PRINT CVI()  5: PRINT CVI(5)
STR$   number-to-string 2: PRINT STR$()  13: PRINT STR$("A")
CINT   to-integer     2: PRINT CINT()  6: PRINT CINT(32768)  13: PRINT CINT("A")
FIX    truncate       2: PRINT FIX()  13: PRINT FIX("A")
CSNG   to-single      2: PRINT CSNG()  13: PRINT CSNG("A")
CDBL   to-double      2: PRINT CDBL()  13: PRINT CDBL("A")
SIN    sine           2: PRINT SIN()  13: PRINT SIN("A")
COS    cosine         2: PRINT COS()  13: PRINT COS("A")
TAN    tangent        2: PRINT TAN()  6: PRINT TAN(1E38)  13: PRINT TAN("A")
ATN    arctangent     2: PRINT ATN()  13: PRINT ATN("A")
VPEEK  address-read   2: PRINT VPEEK()  5: PRINT VPEEK(16384)  6: PRINT VPEEK(70000)  13: PRINT VPEEK("A")
POKE   address-value  2: POKE &H9000  5: POKE &H9000,256  6: POKE 65536,1  13: POKE "A",1  24: POKE
VPOKE  address-value  2: VPOKE 1  5: VPOKE 16384,1  6: VPOKE 70000,1  13: VPOKE "A",1  24: VPOKE
SOUND  register-value 2: SOUND 8  5: SOUND 14,0  13: SOUND "A",0  24: SOUND
