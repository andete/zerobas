10 REM D-PLAYQUEUE: more queue byte costs (voice A held by a long note)
20 FOR I=1 TO 10:READ A$,K
30 PLAY "T32L1V0C":FOR W=1 TO 20:NEXT:P=PEEK(&HF959)
40 FOR J=1 TO K:PLAY A$:NEXT:Q=PEEK(&HF959):LPRINT I;K;(Q-P+128) MOD 128;A$
50 BEEP:SOUND 8,0:NEXT
60 PLAY "T32L1V0C":FOR W=1 TO 20:NEXT:P=PEEK(&HF959):N=0
70 PLAY "C":N=N+1:IF N<40 AND PLAY(1) THEN Q=PEEK(&HF959):IF (Q-P+128) MOD 128>=6*N-6 THEN 70
80 LPRINT "CAP";N;(PEEK(&HF959)-P+128) MOD 128;PEEK(&HF95C):BEEP:END
90 DATA "S1C",1,"M100C",1,"S1M100C",1,"V8C",1,"CR",1,"RC",1,"T255L64C",1,"C",2,"C",3,"CDE",2
