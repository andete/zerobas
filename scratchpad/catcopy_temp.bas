10 ON ERROR GOTO 900
20 T$=STRING$(95,"A")+" ":LPRINT "CP 0";FRE("")
30 N=1:B$=T$+" ":LPRINT "CP 1";LEN(B$);FRE(""):B$=""
40 N=2:L=LEN(T$+" "):LPRINT "CP 2";L;FRE("")
50 N=3:Q=INSTR(T$+" "," "):LPRINT "CP 3";Q;FRE("")
60 N=4:Q=INSTR(1,T$+" "," "):LPRINT "CP 4";Q;FRE("")
70 N=5:Q=INSTR(1,T$," "):LPRINT "CP 5";Q;FRE("")
80 N=6:PRINT LEFT$(T$+" ",3):LPRINT "CP 6";FRE("")
90 N=7:Q=ASC(T$+" "):LPRINT "CP 7";Q;FRE("")
100 END
900 LPRINT "CP 9 ERR";ERR;"AT";N;FRE(""):RESUME NEXT
