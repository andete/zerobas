keyword case                             National_CF-   C-BIOS_MSX1_
MKI$    PRINT MKI$("A")                      (13, 20)       (13, 20)
MKI$    PRINT MKI$(32768)                     (6, 20)             OK
MKI$    PRINT MKI$(-32769)                    (6, 20)             OK
MKI$    PRINT MKI$()                          (2, 20)        (2, 20)
MKI$    PRINT MKI$(1,1)                       (2, 20)       (13, 20)
CVI     PRINT CVI(5)                         (13, 20)       (13, 20)
CVI     PRINT CVI("")                         (5, 20)        (5, 20)
CVI     PRINT CVI("A")                        (5, 20)        (5, 20)
CVI     PRINT CVI()                           (2, 20)        (2, 20)
CVI     PRINT CVI("AB","AB")                  (2, 20)        (2, 20)
MKS$    PRINT MKS$("A")                      (13, 20)       (13, 20)
MKS$    PRINT MKS$()                          (2, 20)        (2, 20)
MKS$    PRINT MKS$(1,1)                       (2, 20)       (13, 20)
CVS     PRINT CVS(5)                         (13, 20)       (13, 20)
CVS     PRINT CVS("")                         (5, 20)        (5, 20)
CVS     PRINT CVS("ABC")                      (5, 20)        (5, 20)
CVS     PRINT CVS()                           (2, 20)        (2, 20)
CVS     PRINT CVS("ABCD","ABCD")              (2, 20)        (2, 20)
MKD$    PRINT MKD$("A")                      (13, 20)       (13, 20)
MKD$    PRINT MKD$()                          (2, 20)        (2, 20)
MKD$    PRINT MKD$(1,1)                       (2, 20)       (13, 20)
CVD     PRINT CVD(5)                         (13, 20)       (13, 20)
CVD     PRINT CVD("")                         (5, 20)        (5, 20)
CVD     PRINT CVD("ABCDEFG")                  (5, 20)        (5, 20)
CVD     PRINT CVD()                           (2, 20)        (2, 20)
CVD     PRINT CVD("ABCDEFGH","ABCDEFGH")        (2, 20)        (2, 20)
DSKF    PRINT DSKF("A")                      (13, 20)       (13, 20)
DSKF    PRINT DSKF(9)                        (62, 20)       (62, 20)
DSKF    PRINT DSKF(-1)                        (5, 20)       (62, 20)
DSKF    PRINT DSKF(256)                       (5, 20)       (62, 20)
DSKF    PRINT DSKF()                          (2, 20)        (2, 20)
DSKF    PRINT DSKF(0,0)                       (2, 20)        (2, 20)

# the reference's error set per keyword form (code: first case)
MKI$   int-to-string  2: PRINT MKI$()  6: PRINT MKI$(32768)  13: PRINT MKI$("A")
CVI    string-to-int  2: PRINT CVI()  5: PRINT CVI("")  13: PRINT CVI(5)
MKS$   single-to-string 2: PRINT MKS$()  13: PRINT MKS$("A")
CVS    string-to-single 2: PRINT CVS()  5: PRINT CVS("")  13: PRINT CVS(5)
MKD$   double-to-string 2: PRINT MKD$()  13: PRINT MKD$("A")
CVD    string-to-double 2: PRINT CVD()  5: PRINT CVD("")  13: PRINT CVD(5)
DSKF   free-space     2: PRINT DSKF()  5: PRINT DSKF(-1)  13: PRINT DSKF("A")  62: PRINT DSKF(9)
