# @DISK
# rechole_fresh (scratch, D-RECHOLE, 2026-11-08): a random file on a FRESH disk, records
# 1 and 3 PUT, record 2 never -- what does GET #1,2 read when nothing was written before?
NEW
OPEN "H.DAT" AS #1 LEN=8:FIELD #1,8 AS A$
LSET A$="AAAAAAAA":PUT #1,1:LSET A$="CCCCCCCC":PUT #1,3
GET #1,2:FOR I=1 TO 8:PRINT ASC(MID$(A$,I,1));:NEXT:PRINT
CLOSE
OPEN "H.DAT" AS #1 LEN=8:FIELD #1,8 AS A$:GET #1,2:FOR I=1 TO 8:PRINT ASC(MID$(A$,I,1));:NEXT:PRINT:PRINT LOF(1):CLOSE
