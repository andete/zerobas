=== Q1  LINE token crunch (disambiguation) ===
  line(0,0)-(10,10)          -> AF 28 11 2C 11 29 F2 28 0F 0A 2C 0F 0A 29 00
  line-(10,10)               -> AF F2 28 0F 0A 2C 0F 0A 29 00
  line(0,0)-(10,10),15       -> AF 28 11 2C 11 29 F2 28 0F 0A 2C 0F 0A 29 2C 0F 0F 00
  line(0,0)-(10,10),15,b     -> AF 28 11 2C 11 29 F2 28 0F 0A 2C 0F 0A 29 2C 0F 0F 2C 42 00
  line(0,0)-(10,10),15,bf    -> AF 28 11 2C 11 29 F2 28 0F 0A 2C 0F 0A 29 2C 0F 0F 2C 42 46 00
  line(0,0)-(10,10),,b       -> AF 28 11 2C 11 29 F2 28 0F 0A 2C 0F 0A 29 2C 2C 42 00
  line step(1,1)-step(2,2)   -> AF 20 DC 28 12 2C 12 29 F2 DC 28 13 2C 13 29 00
  line(0,0)-step(10,10)      -> AF 28 11 2C 11 29 F2 DC 28 0F 0A 2C 0F 0A 29 00
  line input a$              -> AF 20 85 20 41 24 00

