SUPPORTED     using_c   PRINT"[";:PRINT USING"+##";7;:PRINT"]"
            ref  [value] '[ +7]'
SUPPORTED     using_d   PRINT"[";:PRINT USING"!";"ABC";:PRINT"]"
            ref  [value] '[A]'
SUPPORTED     using_e   PRINT"[";:PRINT USING"##.##^^^^";123.4;:PRINT"]"
            ref  [value] '[ 1.23E+02]'
SUPPORTED     listkw    PRINT"[A]":LIST
            ref  [value] '[A]|10 PRINT"[A]":LIST'
SUPPORTED     listkw_b  PRINT"[A]":Z$="XXXXXXXXXXXXXXXXXXXXXXXX":Y$="YYYYYYYYYYYYYYYYYYYY":LIST 20
            ref  [value] '[A]|20 Z$="XXXXXXXXXXXXXXXXXXXXXXXX"'
SUPPORTED     listkw_c  PRINT"[A]":Z$="XXXXXXXXXXXXXXXXXXXXXXXX":Y$="YYYYYYYYYYYYYYYYYYYY":LIST 20-30
            ref  [value] '[A]|20 Z$="XXXXXXXXXXXXXXXXXXXXXXXX"|30 Y$="YYYYYYYYYYYYYYYYYYYY"'
SUPPORTED     llist     LLIST:REM ZQ8
            ref  [value] '10 LLIST:REM ZQ8\\r\\n'
SUPPORTED     keykw     KEY 1,"ZZQ":KEY LIST
            ref  [value] 'ZZQ|auto|goto|list|run|color 15,4,4|cload"|cont|list.|run'
SUPPORTED     keykw_b   KEY 1,"ZQ":A$="":T=TIME:W$="WWWWWWWWWWWWWWWWWW":A$=A$+INKEY$:V$="VVVVVVVVVVVVVVVVVV":IF LEN(A$)<2 AND TIME-T<99 THEN 30:KEY 1,"":PRINT"[3r";LEFT$(A$,2);"]"
            ref  [value] '[3rZQ]'
SUPPORTED     keykw_on  KEY ON:LOCATE 0,23:A=CSRLIN:CLS:PRINT"[K5";A;"]"
            ref  [value] '[K5 22 ]'
SUPPORTED     keykw_off KEY OFF:LOCATE 0,23:A=CSRLIN:CLS:PRINT"[K4";A;"]"
            ref  [value] '[K4 23 ]'
SUPPORTED     save      A=1:SAVE"S.BAS":OPEN"S.BAS"FOR INPUT AS#1:A=LOF(1):CLOSE#1:PRINT"[";A;"]"
            ref  [value] '[ 68 ]'
SUPPORTED     save_b    PRINT"[2s]":SAVE"SA.BAS",A:PRINT"[2u]"
            ref  [value] '[2s]'

