10 REM ** C3 - PROJECT EULER 3 17 24 40 53 63, AND 76 21 36 SCALED DOWN **
20 TIME=0:KEY OFF:CLS:DEFINT I-N:DEFDBL A-H,O-Z:DIM D%(1500),P(100),W$(19),T$(9)
30 REM P3: the largest prime factor of 600851475143, trial division in doubles
40 X=600851475143#:F=3:L=1:REM no factor 2: odd divisors only
50 IF X<=1 THEN 60
55 IF X-INT(X/F)*F=0 THEN X=X/F:L=F ELSE F=F+2
57 GOTO 50
60 LPRINT "P3";TIME;L
70 REM P17: letters used writing 1..1000 out in words (British "and")
80 RESTORE 900:FOR K=0 TO 19:READ W$(K):NEXT:FOR K=2 TO 9:READ T$(K):NEXT:S=0
90 FOR K=1 TO 999:H=K\100:R=K MOD 100:A$=""
100 IF H THEN A$=W$(H)+"HUNDRED":IF R THEN A$=A$+"AND"
110 IF R>=20 THEN A$=A$+T$(R\10):IF R MOD 10 THEN A$=A$+W$(R MOD 10)
120 IF R>0 AND R<20 THEN A$=A$+W$(R)
130 S=S+LEN(A$):NEXT:S=S+LEN("ONETHOUSAND"):LPRINT "P17";TIME;S
140 REM P24: the millionth permutation of 0..9, by the factorial number system
150 A$="0123456789":R=999999#:B$="":F=362880#
160 FOR K=9 TO 0 STEP -1:Q=INT(R/F):R=R-Q*F:B$=B$+MID$(A$,Q+1,1):A$=LEFT$(A$,Q)+MID$(A$,Q+2):IF K THEN F=F/K
170 NEXT:LPRINT "P24 ";TIME;B$
180 REM P40: Champernowne's constant: d1*d10*d100*...*d1000000, digit by arithmetic
190 R=1:FOR E=0 TO 6:P0=10^E:G=1:C=9:B=1
200 IF P0>G*C THEN P0=P0-G*C:G=G+1:C=C*10:B=B*10:GOTO 200
210 V=B+INT((P0-1)/G):J=(P0-1)-INT((P0-1)/G)*G:R=R*VAL(MID$(STR$(V),J+2,1)):NEXT:LPRINT "P40";TIME;R
220 REM P53: C(n,r) above a million for n <= 100, Pascal's triangle capped
230 FOR K=0 TO 100:P(K)=0:NEXT:P(0)=1:N=0
240 FOR M=1 TO 100:FOR K=M TO 1 STEP -1:P(K)=P(K)+P(K-1):IF P(K)>1000000# THEN P(K)=1000001#:N=N+1
250 NEXT K,M:LPRINT "P53";TIME;N
270 REM P63: n-digit positive integers that are also an nth power
280 N=0:Z=LOG(10):FOR A=1 TO 9:FOR M=1 TO 25:IF INT(M*LOG(A)/Z)+1=M THEN N=N+1
290 NEXT M,A:LPRINT "P63";TIME;N
300 REM P76 for 60 (not 100): ways to write 60 as a sum of at least two positive integers
310 FOR K=0 TO 60:P(K)=0:NEXT:P(0)=1
320 FOR M=1 TO 59:FOR K=M TO 60:P(K)=P(K)+P(K-M):NEXT K,M:LPRINT "P76<60>";TIME;P(60)
330 REM P21 below 1000 (not 10000): amicable numbers, divisor sums by a sieve
340 FOR K=1 TO 499:FOR M=2*K TO 999 STEP K:D%(M)=D%(M)+K:NEXT M,K:S=0
350 FOR K=2 TO 999:M=D%(K):IF M<>K AND M<1000 THEN IF D%(M)=K THEN S=S+K
360 NEXT:LPRINT "P21<1000";TIME;S
370 REM P36 below 500 (not 1000000): palindromes in base 10 and in base 2
380 S=0:FOR K=1 TO 499:A$=MID$(STR$(K),2):B$=BIN$(K):GOSUB 800:IF R THEN S=S+K
390 NEXT:LPRINT "P36<500";TIME;S
400 LPRINT "CP 9 END":END
800 R=0:FOR M=1 TO LEN(A$)\2:IF MID$(A$,M,1)<>MID$(A$,LEN(A$)+1-M,1) THEN RETURN
810 NEXT:FOR M=1 TO LEN(B$)\2:IF MID$(B$,M,1)<>MID$(B$,LEN(B$)+1-M,1) THEN RETURN
820 NEXT:R=1:RETURN
900 DATA "",ONE,TWO,THREE,FOUR,FIVE,SIX,SEVEN,EIGHT,NINE,TEN,ELEVEN,TWELVE,THIRTEEN,FOURTEEN,FIFTEEN,SIXTEEN,SEVENTEEN,EIGHTEEN,NINETEEN
910 DATA TWENTY,THIRTY,FORTY,FIFTY,SIXTY,SEVENTY,EIGHTY,NINETY
