10 REM D-PRSTRFN: an operator after a string FUNCTION in PRINT -- the error, and
11 REM whether the string reached the screen before it (VPEEK of the column)
20 SCREEN 0:WIDTH 40:KEY OFF:CLS:ON ERROR GOTO 900
30 E=0:LOCATE 0,5:PRINT "[";:PRINT CHR$(65) AND 1;:GOSUB 800:LPRINT "A";E;"[";C$;"]"
40 E=0:LOCATE 0,5:PRINT "[";:PRINT STRING$(2,66) - 1;:GOSUB 800:LPRINT "B";E;"[";C$;"]"
50 E=0:LOCATE 0,5:PRINT "[";:PRINT LEFT$("CD",1) * 2;:GOSUB 800:LPRINT "C";E;"[";C$;"]"
60 E=0:LOCATE 0,5:PRINT "[";:PRINT MID$("XGY",2,1) MOD 2;:GOSUB 800:LPRINT "D";E;"[";C$;"]"
70 E=0:LOCATE 0,5:PRINT "[";:PRINT CHR$(69)+"F";:GOSUB 800:LPRINT "E";E;"[";C$;"]"
80 E=0:LOCATE 0,5:PRINT "[";:PRINT HEX$(255);"/";OCT$(8);:GOSUB 800:LPRINT "F";E;"[";C$;"]"
90 E=0:LOCATE 0,5:PRINT "[";:PRINT SIN(0);-1;(2);+3;:GOSUB 800:LPRINT "G";E;"[";C$;"]"
100 ON ERROR GOTO 0:END
800 C$="":FOR X=1 TO 8:C$=C$+CHR$(VPEEK(5*40+X)):NEXT:LOCATE 0,5:PRINT SPACE$(39);:RETURN
900 E=ERR:RESUME NEXT
