T7 ['  zerobas version 0.1', '  clean-room MSX1 BASIC', '  zerobas Disk BASIC', '  ZB', '  ÿ', '  color  auto   goto   list   run']
T7.5 ['  zerobas version 0.1', '  clean-room MSX1 BASIC', '  zerobas Disk BASIC', '  ZB', '  ÿ', '  color  auto   goto   list   run']
T11 ['  zerobas version 0.1', '  clean-room MSX1 BASIC', '  zerobas Disk BASIC', '  ZB', '  PRINT 7*6', '   42']
