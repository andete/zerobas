10 ON ERROR GOTO 900
20 T$=STRING$(122,65):MID$(T$,121,2)=" B":LPRINT "CP 0";FRE("");LEN(T$)
30 N=1:Q=INSTR(T$," "):LPRINT "CP 1";Q;FRE("")
40 N=2:Q=INSTR(5,T$,"B"):LPRINT "CP 2";Q;FRE("")
50 N=3:U$="X":Q=INSTR(T$,U$):LPRINT "CP 3";Q;FRE("")
60 N=4:Q=INSTR("ABC"+"DEF","D"):LPRINT "CP 4";Q;FRE("")
70 N=5:Q=INSTR(T$,LEFT$(" B",2)):LPRINT "CP 5";Q;FRE("")
80 END
900 LPRINT "CP 9 ERR";ERR;"AT";N;FRE(""):RESUME NEXT
