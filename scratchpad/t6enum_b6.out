# the reference's error set per keyword form (code: first case)
FOR    ascending      2: FOR I=1:NEXT  13: FOR I="A" TO 2:NEXT  24: FOR I=1 TO:NEXT
FOR    step           2: FOR I=1 TO 2 STEP 1,2:NEXT  13: FOR I=1 TO 2 STEP "A":NEXT  24: FOR I=1 TO 2 STEP:NEXT
FOR    negative-step  13: FOR I=2 TO 1 STEP -"A":NEXT  24: FOR I=2 TO 1 STEP -:NEXT
IF     then           2: IF THEN 30  8: IF 1 THEN 99  13: IF "A" THEN 30
IF     else           8: IF 0 THEN 30 ELSE 99  13: IF "A" THEN 30 ELSE 30
IF     goto           2: IF 1 GOTO "A"  8: IF 1 GOTO 99  13: IF "A" GOTO 30
CLEAR  bare           2: CLEAR 1,2,3
CLEAR  string-space   5: CLEAR -1  6: CLEAR 70000  7: CLEAR 30000  13: CLEAR "A"
CLEAR  himem          5: CLEAR 200,&H7000  13: CLEAR 200,"A"  24: CLEAR 200,
COLOR  foreground     5: COLOR 16  13: COLOR "A"
COLOR  background     5: COLOR ,16  13: COLOR ,"A"
COLOR  border         2: COLOR 1,1,1,1  5: COLOR ,,16  13: COLOR ,,"A"
SCREEN mode           5: SCREEN 4  13: SCREEN "A"
