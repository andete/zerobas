10 REM D-PRSTRFN: an operator after a string FUNCTION in PRINT
20 ON ERROR GOTO 900
30 LPRINT "A [";:LPRINT CHR$(65) AND 1;"]"
40 LPRINT "B [";:LPRINT STRING$(2,66) - 1;"]"
50 LPRINT "C [";:LPRINT LEFT$("CD",1) * 2;"]"
60 LPRINT "D [";:LPRINT INKEY$ OR 3;"]"
70 LPRINT "E [";:LPRINT CHR$(69)+"F";"]"
80 LPRINT "F [";:LPRINT MID$("XGY",2,1) MOD 2;"]"
90 LPRINT "G [";:LPRINT SIN(0);COS(0);-1;"]"
100 LPRINT "H [";:LPRINT VAL("7")+1;LEN("AB")*2;"]"
110 LPRINT "I [";:LPRINT USR(0) AND 0;"]"
120 END
900 LPRINT "ERR";ERR;"AT";ERL:RESUME NEXT
