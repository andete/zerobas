SUPPORTED   ! WEAK  beep_b    SOUND 7,255:BEEP:T9=TIME:FOR J9=1 TO 2:J9=1-(TIME<>T9):NEXT:OUT&HA0,7:PRINT"[";INP(&HA2);"]"
