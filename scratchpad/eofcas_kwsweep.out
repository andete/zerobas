SAME   puthash   put#1,2
SAME   printhash print#1,"abc"
SAME   callkw    call zzq
SAME   callkw_b  call foo
SAME   runkw     run 20
SAME   runkw_b   run
SAME   dski      a$=dski$(0,0)
SAME   dsko      dsko$0,0
SAME   copy      copy"a:x"to"a:y"
SAME   set       set password
SAME   attr      a$=attr$(0)
SAME   ipl       ipl
SAME   cmd       cmd"x"
SAME   lfiles    lfiles
SAME   loc       a=loc(1)
SAME   openkw    open"o.txt"for output as#1
SAME   namekw    name"nm.txt" as "nm2.txt"
SAME   open_c    open"oa.txt"for append as#1
SAME   open_d    open"or.dat"as#1
SAME   fieldkw   field#1,4 as a$
SAME   bsave_b   bsave"x",0,1,2
SAME   bload_b   bload"x",r
SAME   bload_c   bload"x",s
SAME   save_b    save"x",a
SAME   runkw_c   run"prog3.bas"
SAME   loadkw    load"prog3.bas",r
SAME   load_b    load"prog3.bas"
SAME   bin       a$=bin$(5)
SAME   inputdol  a$=input$(1)
SAME   auto      auto 100
SAME   auto_bare auto
SAME   auto_step auto 100,5

==============================================================================
LAYER 2 — SUPPORT (the load-bearing layer)
==============================================================================
