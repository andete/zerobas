--- USR: reference Philips_VG_8020
Ok
10 FOR I=0 TO 7:READ B$
20 POKE &HD000+I,VAL("&H"+B$):NEXT
30 DATA 2A,F8,F7,23,22,F8,F7,C9
40 DEFUSR=&HD000:DEFUSR1=&HD007
50 PRINT USR(5);USR1(5);USR1(1.5)
60 ON ERROR GOTO 90
70 A=USR(1,2)
80 END
90 PRINT "Error";ERR:RESUME NEXT
RUN
 6  5  1.5
