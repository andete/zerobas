10 REM D-RESNEXTEOL class: deferred Type mismatch at a line's END -> ERL and RESUME NEXT
20 ON ERROR GOTO 900:CLS:K=1
30 A=5+"X"
40 LPRINT "A":LPRINT "A2"
50 A$=5
60 LPRINT "B":LPRINT "B2"
70 A=LEN(5)
80 LPRINT "C":LPRINT "C2"
90 IF "X"=5 THEN K=2
100 LPRINT "D":LPRINT "D2"
110 A=-"X"
120 LPRINT "E":LPRINT "E2"
130 A=ASC(5)
140 LPRINT "F":LPRINT "F2"
150 X$=MID$("ABC",1,"X")
160 LPRINT "G":LPRINT "G2"
170 A=VAL(5)
180 LPRINT "H":LPRINT "H2"
190 LPRINT USING "##";"AB"
200 LPRINT "I":LPRINT "I2"
210 LPRINT "END":END
900 LPRINT "ERR";ERR;ERL:RESUME NEXT
