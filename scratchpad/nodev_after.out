== program opn2.bas
10 ON ERROR GOTO 900
20 FOR I=1 TO 11:READ N$:E=0:OPEN N$ FOR OUTPUT AS #1:CLOSE:LPRINT I;"[";N$;"]";E:NEXT:END
900 E=ERR:RESUME NEXT
1000 DATA "X:","AB:","NUL:","ABCDE:","ABCDEFG:X","ABCDEFGHI:X",":X","FOO:BAR","FOO","A:B:","Q:"

