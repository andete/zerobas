keyword case                                           Philips_VG_8   C-BIOS_MSX1_
INSTR   PRINT INSTR("AB",5)                                (13, 20)       (13, 20)
INSTR   PRINT INSTR("AB")                                   (2, 20)        (2, 20)
INSTR   PRINT INSTR()                                       (2, 20)        (2, 20)
INSTR   PRINT INSTR("AB","B","C")                           (2, 20)        (2, 20)
INSTR   PRINT INSTR(0,"AB","B")                             (5, 20)        (5, 20)
INSTR   PRINT INSTR(256,"AB","B")                           (5, 20)        (5, 20)
INSTR   PRINT INSTR(70000,"AB","B")                         (6, 20)        (6, 20)
INSTR   PRINT INSTR(1,5,"B")                               (13, 20)       (13, 20)
INSTR   PRINT INSTR(1,"AB",5)                              (13, 20)       (13, 20)
INSTR   PRINT INSTR(1,"AB","B","C")                         (2, 20)        (2, 20)
INSTR   PRINT INSTR(1,"AB")                                 (2, 20)        (2, 20)
MID$    PRINT MID$(5,1,1)                                  (13, 20)       (13, 20)
MID$    PRINT MID$("AB",0,1)                                (5, 20)        (5, 20)
MID$    PRINT MID$("AB",256,1)                              (5, 20)        (5, 20)
MID$    PRINT MID$("AB",1,-1)                               (5, 20)        (5, 20)
MID$    PRINT MID$("AB",1,256)                              (5, 20)        (5, 20)
MID$    PRINT MID$("AB","A",1)                             (13, 20)       (13, 20)
MID$    PRINT MID$("AB",1,"A")                             (13, 20)       (13, 20)
MID$    PRINT MID$("AB",1,1,1)                              (2, 20)       (13, 20)
MID$    PRINT MID$("AB",70000,1)                            (6, 20)        (6, 20)
MID$    PRINT MID$(5,1)                                    (13, 20)       (13, 20)
MID$    PRINT MID$("AB",0)                                  (5, 20)        (5, 20)
MID$    PRINT MID$("AB")                                    (2, 20)        (2, 20)
MID$    PRINT MID$("AB","A")                               (13, 20)       (13, 20)
MID$    PRINT MID$()                                        (2, 20)        (2, 20)
MID$    A$="AB":MID$(A$,0)="X"                              (5, 20)        (5, 20)
MID$    A$="AB":MID$(A$,1)=5                               (13, 20)       (13, 20)
MID$    A$="AB":MID$(A$,3)="X"                              (5, 20)        (5, 20)
MID$    A$="AB":MID$(A$,1,-1)="X"                           (5, 20)        (5, 20)
MID$    A$="AB":MID$(A$,1,1)                                (2, 20)        (2, 20)
MID$    MID$(5,1)="X"                                       (2, 20)       (13, 20)
MID$    A$="AB":MID$(A$)="X"                                (2, 20)        (2, 20)
MID$    A$="AB":MID$(A$,256)="X"                            (5, 20)        (5, 20)
NEXT    NEXT                                                (1, 20)        (1, 20)
NEXT    FOR I=1 TO 2:NEXT:NEXT                              (1, 20)        (1, 20)
NEXT    NEXT I                                              (1, 20)        (1, 20)
NEXT    FOR I=1 TO 2:NEXT J                                 (1, 20)        (1, 20)
NEXT    FOR I=1 TO 2:NEXT A$                                (1, 20)        (1, 20)
NEXT    FOR I=1 TO 2:NEXT 5                                 (2, 20)        (2, 20)
NEXT    FOR I=1 TO 2:FOR J=1 TO 2:NEXT J,K                  (1, 20)        (1, 20)
NEXT    NEXT I,J                                            (1, 20)        (1, 20)
NEXT    FOR I=1 TO 2:FOR J=1 TO 2:NEXT J,                   (1, 20)        (1, 20)
RETURN  RETURN                                              (3, 20)        (3, 20)
RETURN  RETURN 99                                           (3, 20)        (3, 20)
RETURN  IF X=0 THEN X=1:GOSUB 20 ELSE RETURN 99             (8, 20)        (8, 20)
RETURN  IF X=0 THEN X=1:GOSUB 20 ELSE RETURN "A"            (2, 20)        (2, 20)
RESTORE RESTORE,                                            (8, 20)        (8, 20)
RESTORE RESTORE 1,2                                         (8, 20)        (8, 20)
RESTORE RESTORE 99                                          (8, 20)        (8, 20)
RESTORE RESTORE "A"                                         (8, 20)        (8, 20)
RESTORE RESTORE -1                                          (8, 20)        (8, 20)
RESTORE RESTORE 70000                                       (8, 20)        (8, 20)
GOTO    GOTO 99                                             (8, 20)        (8, 20)
GOTO    GOTO                                                (2, 20)        (2, 20)
GOTO    GOTO "A"                                            (2, 20)        (2, 20)
GOTO    GOTO -1                                             (2, 20)        (2, 20)
GOTO    GOTO 70000                                          (8, 20)        (8, 20)
READ    READ A                                              (4, 20)        (4, 20)
READ    READ A:DATA X                                       (2, 20)        (2, 20)
READ    READ 5                                              (2, 20)        (2, 20)
READ    READ                                                (2, 20)        (2, 20)
READ    READ A:DATA 1E99                                    (6, 20)        (2, 20)
SWAP    SWAP A,B$                                          (13, 20)       (13, 20)
SWAP    SWAP A                                              (2, 20)        (2, 20)
SWAP    SWAP                                                (2, 20)        (2, 20)
SWAP    SWAP A,5                                            (2, 20)        (2, 20)
ERASE   ERASE A                                             (5, 20)        (5, 20)
ERASE   ERASE                                               (2, 20)        (2, 20)
ERASE   ERASE 5                                             (2, 20)        (2, 20)
ERASE   DIM A(2):ERASE A,A                                  (5, 20)        (5, 20)
DIM     DIM A(2):DIM A(2)                                  (10, 20)       (10, 20)
DIM     DIM A(-1)                                           (5, 20)        (5, 20)
DIM     DIM A("X")                                         (13, 20)       (13, 20)
DIM     DIM A(70000)                                        (6, 20)        (6, 20)
DIM     DIM A(10000)                                        (9, 20)        (9, 20)
DIM     DIM 5                                               (2, 20)        (2, 20)
DIM     DIM B(2,2):DIM B(2,2)                              (10, 20)       (10, 20)
DIM     DIM B(-1,2)                                         (5, 20)        (5, 20)
DIM     DIM B(2,"X")                                       (13, 20)       (13, 20)
DIM     DIM B(200,200)                                      (9, 20)        (9, 20)

# the reference's error set per keyword form (code: first case)
INSTR  search         2: PRINT INSTR("AB")  13: PRINT INSTR("AB",5)
INSTR  search-from    2: PRINT INSTR(1,"AB","B","C")  5: PRINT INSTR(0,"AB","B")  6: PRINT INSTR(70000,"AB","B")  13: PRINT INSTR(1,5,"B")
MID$   substring-3arg 2: PRINT MID$("AB",1,1,1)  5: PRINT MID$("AB",0,1)  6: PRINT MID$("AB",70000,1)  13: PRINT MID$(5,1,1)
MID$   substring-to-end 2: PRINT MID$("AB")  5: PRINT MID$("AB",0)  13: PRINT MID$(5,1)
MID$   assign         2: A$="AB":MID$(A$,1,1)  5: A$="AB":MID$(A$,0)="X"  13: A$="AB":MID$(A$,1)=5
NEXT   bare           1: NEXT
NEXT   named          1: NEXT I  2: FOR I=1 TO 2:NEXT 5
NEXT   comma-list     1: FOR I=1 TO 2:FOR J=1 TO 2:NEXT J,K
RETURN bare           3: RETURN
RETURN line           2: IF X=0 THEN X=1:GOSUB 20 ELSE RETURN "A"  3: RETURN 99  8: IF X=0 THEN X=1:GOSUB 20 ELSE RETURN 99
RESTORE bare           8: RESTORE,
RESTORE line           8: RESTORE 99
GOTO   jump           2: GOTO  8: GOTO 99
READ   read-data      2: READ A:DATA X  4: READ A  6: READ A:DATA 1E99
SWAP   exchange       2: SWAP A  13: SWAP A,B$
ERASE  free-array     2: ERASE  5: ERASE A
DIM    one-dimensional 2: DIM 5  5: DIM A(-1)  6: DIM A(70000)  9: DIM A(10000)  10: DIM A(2):DIM A(2)  13: DIM A("X")
DIM    multi-dimensional 5: DIM B(-1,2)  9: DIM B(200,200)  10: DIM B(2,2):DIM B(2,2)  13: DIM B(2,"X")
