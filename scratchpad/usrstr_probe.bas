10 REM usrstr-acceptance: USR with a string argument (D-USRSTR)
20 FOR K=1 TO 300:NEXT:CLEAR 200,&HDFFF:A=&HE000
30 FOR I=0 TO 11:READ H$:POKE A+I,VAL("&H"+H$):NEXT:DEFUSR=A:DEFUSR1=A+5:DEFUSR2=A+6
40 DATA 3E,02,32,63,F6,C9,21,0B,E0,34,C9,00
50 ON ERROR GOTO 200
60 S$="HELLO":P=USR(S$):V=VARPTR(S$):LPRINT "A";P=V;PEEK(P);CHR$(PEEK(PEEK(P+1)+256*PEEK(P+2)))
70 LPRINT "H";USR(LEFT$(S$,2))>0;PEEK(USR(MID$(S$,2)));PEEK(USR(S$+"!"))
80 X=USR1("AB"):LPRINT "E";X
90 Y=USR1(5):LPRINT "F";Y:Z$=USR1(5):LPRINT "G ";Z$
100 LPRINT "I";USR1(-7);USR1("A"="A")
101 REM D-USRSTRRES: a routine that leaves VALTYP 3 makes USR a STRING; USR2 counts its calls
102 LPRINT "C ";USR1("ABC");LEN(USR1("Q"+"R"))
103 B$=USR1(S$):LPRINT "D ";B$;LEN(B$):W$="X"+USR1("Y"):LPRINT "M ";W$
104 POKE &HE00B,0:Q=USR2(5):LPRINT "J";Q;PEEK(&HE00B)
105 POKE &HE00B,0:LPRINT "K";USR2(USR2(7));PEEK(&HE00B)
106 POKE &HE00B,0:LPRINT "L";5.5>USR2(5);PEEK(&HE00B)
107 POKE &HE00B,0:LPRINT "N";USR2(3)+USR2(4);PEEK(&HE00B)
108 Y#=5:LPRINT "O";USR1(7);USR1(-7)
110 LPRINT "Z END":END
200 LPRINT "ERR";ERR;"IN";ERL:RESUME NEXT
