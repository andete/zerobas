10 REM usrstr-acceptance: USR with a string argument (D-USRSTR)
20 FOR K=1 TO 300:NEXT:CLEAR 200,&HDFFF:A=&HE000
30 FOR I=0 TO 5:READ H$:POKE A+I,VAL("&H"+H$):NEXT:DEFUSR=A:DEFUSR1=A+5
40 DATA 3E,02,32,63,F6,C9
50 ON ERROR GOTO 200
60 S$="HELLO":P=USR(S$):V=VARPTR(S$):LPRINT "A";P=V;PEEK(P);CHR$(PEEK(PEEK(P+1)+256*PEEK(P+2)))
70 LPRINT "H";USR(LEFT$(S$,2))>0;PEEK(USR(MID$(S$,2)));PEEK(USR(S$+"!"))
80 X=USR1("AB"):LPRINT "E";X
90 Y=USR1(5):LPRINT "F";Y:Z$=USR1(5):LPRINT "G ";Z$
100 LPRINT "I";USR1(-7);USR1("A"="A")
110 LPRINT "Z END":END
200 LPRINT "ERR";ERR;"IN";ERL:RESUME NEXT
