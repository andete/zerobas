=== C1  PAINT token crunch (grammar) ===
  paint(50,50)               -> BF 28 0F 32 2C 0F 32 29 00
  paint(50,50),15            -> BF 28 0F 32 2C 0F 32 29 2C 0F 0F 00
  paint(50,50),15,4          -> BF 28 0F 32 2C 0F 32 29 2C 0F 0F 2C 15 00
  paint step(5,5),15,4       -> BF 20 DC 28 16 2C 16 29 2C 0F 0F 2C 15 00
  paint(50,50),,4            -> BF 28 0F 32 2C 0F 32 29 2C 2C 15 00
  paint(50,50),"AB",4        -> BF 28 0F 32 2C 0F 32 29 2C 22 41 42 22 2C 15 00
  paint(50,50),15,4,7        -> BF 28 0F 32 2C 0F 32 29 2C 0F 0F 2C 15 2C 18 00

