10 REM D-PLAYRATE: per row, TIME when PLAY returns (A) and when PLAY(0) is 0 (B)
20 FOR I=1 TO 18:READ N,A$,B$:TIME=0
30 IF N=1 THEN PLAY A$ ELSE PLAY A$,B$
40 A=TIME
50 IF PLAY(0) THEN 50
60 LPRINT I;A;TIME:NEXT:END
