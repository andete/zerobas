keyword case                     Philips_VG_8   C-BIOS_MSX1_
ABS    PRINT ABS("A")               (13, 20)       (13, 20)
ABS    PRINT ABS()                   (2, 20)        (2, 20)
ABS    PRINT ABS(1,2)                (2, 20)        (2, 20)
ABS    PRINT ABS(-1E38)                   OK             OK
SGN    PRINT SGN("A")               (13, 20)       (13, 20)
SGN    PRINT SGN()                   (2, 20)        (2, 20)
SGN    PRINT SGN(1,2)                (2, 20)        (2, 20)
SGN    PRINT SGN(-1E38)                   OK             OK
INT    PRINT INT("A")               (13, 20)       (13, 20)
INT    PRINT INT()                   (2, 20)        (2, 20)
INT    PRINT INT(1,2)                (2, 20)        (2, 20)
INT    PRINT INT(-1E38)                   OK             OK
SQR    PRINT SQR("A")               (13, 20)       (13, 20)
SQR    PRINT SQR()                   (2, 20)        (2, 20)
SQR    PRINT SQR(1,2)                (2, 20)        (2, 20)
SQR    PRINT SQR(-1)                 (5, 20)        (5, 20)
SQR    PRINT SQR(0)                       OK             OK
LOG    PRINT LOG("A")               (13, 20)       (13, 20)
LOG    PRINT LOG()                   (2, 20)        (2, 20)
LOG    PRINT LOG(1,2)                (2, 20)        (2, 20)
LOG    PRINT LOG(0)                  (5, 20)        (5, 20)
LOG    PRINT LOG(-1)                 (5, 20)        (5, 20)
EXP    PRINT EXP("A")               (13, 20)       (13, 20)
EXP    PRINT EXP()                   (2, 20)        (2, 20)
EXP    PRINT EXP(1,2)                (2, 20)        (2, 20)
EXP    PRINT EXP(99)                      OK             OK
EXP    PRINT EXP(-99)                     OK             OK
ASC    PRINT ASC(5)                 (13, 20)       (13, 20)
ASC    PRINT ASC()                   (2, 20)        (2, 20)
ASC    PRINT ASC("A","B")            (2, 20)        (2, 20)
ASC    PRINT ASC("")                 (5, 20)        (5, 20)
CHR$   PRINT CHR$("A")              (13, 20)       (13, 20)
CHR$   PRINT CHR$()                  (2, 20)        (2, 20)
CHR$   PRINT CHR$(1,2)               (2, 20)        (2, 20)
CHR$   PRINT CHR$(256)               (5, 20)        (5, 20)
CHR$   PRINT CHR$(-1)                (5, 20)        (5, 20)
CHR$   PRINT CHR$(70000)             (6, 20)        (6, 20)
LEN    PRINT LEN(5)                 (13, 20)       (13, 20)
LEN    PRINT LEN()                   (2, 20)        (2, 20)
LEN    PRINT LEN("A","B")            (2, 20)        (2, 20)
LEN    PRINT LEN("")                      OK             OK
PEEK   PRINT PEEK("A")              (13, 20)       (13, 20)
PEEK   PRINT PEEK()                  (2, 20)        (2, 20)
PEEK   PRINT PEEK(1,2)               (2, 20)        (2, 20)
PEEK   PRINT PEEK(65536)             (6, 20)        (6, 20)
PEEK   PRINT PEEK(-32769)            (6, 20)        (6, 20)
PEEK   PRINT PEEK(70000)             (6, 20)        (6, 20)

# the reference's error set per keyword form (code: first case)
ABS    magnitude      2: PRINT ABS()  13: PRINT ABS("A")
SGN    sign           2: PRINT SGN()  13: PRINT SGN("A")
INT    floor          2: PRINT INT()  13: PRINT INT("A")
SQR    square-root    2: PRINT SQR()  5: PRINT SQR(-1)  13: PRINT SQR("A")
LOG    logarithm      2: PRINT LOG()  5: PRINT LOG(0)  13: PRINT LOG("A")
EXP    exponential    2: PRINT EXP()  13: PRINT EXP("A")
ASC    code-of        2: PRINT ASC()  5: PRINT ASC("")  13: PRINT ASC(5)
CHR$   code-to-char   2: PRINT CHR$()  5: PRINT CHR$(256)  6: PRINT CHR$(70000)  13: PRINT CHR$("A")
LEN    length         2: PRINT LEN()  13: PRINT LEN(5)
PEEK   address-read   2: PRINT PEEK()  6: PRINT PEEK(65536)  13: PRINT PEEK("A")
