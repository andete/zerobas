U    key: 'A>'                               then CD: 'A>CD'
X    key: 'A>AB'                             then CD: 'A>ABD'
E    key: 'A>AB^E'                           then CD: 'A>AB^ECD'
R    key: 'A>AB'                             then CD: 'A>ABCD'
ESC  key: 'A>'                               then CD: 'A>CD'
N    key: 'A>AB'                             then CD: 'A>ABCD'
S    key: 'A>AB^S'                           then CD: 'A>AB^SCD'
H    key: 'A>A'                              then CD: 'A>ACD'
C    key: 'A>AB^C / A>'                      then CD: 'A>AB^C / A>CD'
