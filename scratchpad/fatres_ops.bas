1 REM @DISK
10 REM D-FATRES: many small disk operations, each a mount -- TIME per batch
20 OPEN "A.DAT" FOR OUTPUT AS #1:PRINT #1,"HELLO":CLOSE
30 T=TIME:FOR I=1 TO 20:OPEN "A.DAT" FOR INPUT AS #1:CLOSE:NEXT:A=TIME-T
40 T=TIME:FOR I=1 TO 10:FILES:NEXT:B=TIME-T
50 T=TIME:FOR I=1 TO 10:OPEN "A.DAT" FOR INPUT AS #1:INPUT #1,X$:CLOSE:NEXT:C=TIME-T
60 LPRINT A;B;C
