10 REM where SCREEN leaves the cursor: POS(0) and CSRLIN right after it
20 FOR K=1 TO 300:NEXT
30 SCREEN 1:LOCATE 10,5:PRINT "AB";:SCREEN 0:A=POS(0):B=CSRLIN
40 LOCATE 7,3:PRINT "CD";:SCREEN 0:C=POS(0):D=CSRLIN
50 LOCATE 5,9:PRINT "EF";:CLS:E=POS(0):F=CSRLIN
60 SCREEN 2:SCREEN 0:G=POS(0):H=CSRLIN
70 LOCATE 12,6:PRINT "GH";:SCREEN 1:I=POS(0):J=CSRLIN:SCREEN 0
80 LOCATE 3,4:PRINT "IJ";:WIDTH 30:K=POS(0):L=CSRLIN
90 LPRINT "A";A;B;"B";C;D;"C";E;F;"D";G;H;"E";I;J;"F";K;L
