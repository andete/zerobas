50 E=TIME:LPRINT "Q";T(1)<10;T(2)<10;T(3)<10;ABS(T(4)-40)<4;:FOR B=5 TO 12:LPRINT T(B)-T(B-1);:NEXT:LPRINT ABS(E-1178)<5
