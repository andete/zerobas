--- VARPTR: reference Philips_VG_8020
Ok
10 MAXFILES=2
20 A=0:B=0:DIM Z(4)
30 A=VARPTR(Z(0)):Q=1
40 B=VARPTR(Z(0))
50 PRINT VARPTR(Z(1))-B;B-A
60 S$(0)="hi":PRINT PEEK(VARPTR(S$(0)))
70 PRINT VARPTR(#2)-VARPTR(#1)
80 ON ERROR GOTO 120
90 PRINT VARPTR(W)
100 PRINT VARPTR(#3)
110 END
120 PRINT "Error";ERR:RESUME NEXT
RUN
