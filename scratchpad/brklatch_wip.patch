-                call    BREAKX
-                jr      c,nx_again_run      ; Ctrl-STOP: the run loop breaks
-                ld      a,(ZTRAP+ZTI_STOP*ZTRAP_ENTSZ)
-                bit     6,a                 ; ZTS_SHADOW: rp_exec's release logic
-                jr      nz,nx_again_run
+                ld      a,(INTFLG)          ; D-BRKLATCH: a latched STOP / CTRL-STOP
