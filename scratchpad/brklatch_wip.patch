diff --git a/tape/tape.asm b/tape/tape.asm
index 20e64ffb..5e22ac3e 100644
--- a/tape/tape.asm
+++ b/tape/tape.asm
@@ -35,6 +35,7 @@
 PSG_REGS:       equ     $A0             ; PSG register-select write port
 PSG_WRITE:      equ     $A1             ; PSG value write port (R15 = general-output port B)
 PSG_STAT:       equ     $A2             ; PSG value read port (CAS-in on R14 bit 7)
+INTFLG:         equ     $FC9B           ; the keyboard interrupt's STOP / CTRL-STOP latch
 BREAKX:         equ     $00B7           ; published BIOS entry: CF = Ctrl-STOP held,
                                         ; read from the matrix (interrupts may be off)
 PPI_REGS:       equ     $AB             ; i8255 PPI control (BSR) register
@@ -845,6 +846,17 @@ lptout_wait:
                 or      a               ; CY = 0 (success)
                 ret
 lptout_stop:
+                ; D-BRKLATCH (2026-11-12): the VG-8020's LPTOUT returns only once
+                ; CTRL-STOP is UP again (fewer than 10 frames to the key-up, against
+                ; ~100 when returned on the press) and its press never reaches BASIC
+                ; (INTFLG 0, still 0 ten frames later -- scratchpad/BL_lptup.out,
+                ; BL_lptintflg.out). So: wait for the release, then consume the latch.
+                call    BREAKX
+                jr      c,lptout_stop
+                call    BREAKX          ; TWICE: one read can tear (D-STOPTEAR) -- with
+                jr      c,lptout_stop   ; one, the wait ended >40 frames early (BL_lpt2.out)
+                xor     a
+                ld      (INTFLG),a
