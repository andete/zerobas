@@ -265,21 +265,31 @@ isc_slow:
                 jr      z,isc_brk
                 cp      4
                 ret     nz
+                call    stop_pause          ; A = 4 (resumed, INTFLG 0) or 3 (CTRL-STOP)
+                cp      3
+                ret     nz                  ; A = 4
+                jr      isc_brk
+; stop_pause -- STOP's pause, shared by ISCNTC (above) and the run loop (rp_exec,
+; D-BRKLATCH): the key UP first (NEWKEY row 7, STOP = bit 4 -- INTFLG re-latches on
+; the release too, scratchpad/latchedge_run.out), then INTFLG cleared and waited on.
+; Out: A = 4 -> resumed by STOP, INTFLG 0; A = 3 -> CTRL-STOP, INTFLG left 3 for the
+; caller's break. Interrupts left ENABLED (the wait needs the keyboard interrupt).
+stop_pause:
                 ei
-isc_up:
+sp_up:
                 halt
                 ld      a,(NEWKEY+7)
                 and     $10
-                jr      z,isc_up            ; STOP still down
+                jr      z,sp_up             ; STOP still down
                 xor     a
                 ld      (INTFLG),a
-isc_dn:
+sp_dn:
                 halt
                 ld      a,(INTFLG)
                 or      a
-                jr      z,isc_dn
+                jr      z,sp_dn
                 cp      3
-                jr      z,isc_brk
+                ret     z                   ; CTRL-STOP: the caller breaks
                 xor     a
                 ld      (INTFLG),a
                 ld      a,4
