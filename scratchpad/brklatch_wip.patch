                 pop     hl                  ; HL = resume stmt ptr
 rp_do_break:
                 ; Ctrl-STOP pressed between lines/statements. HL = the statement
@@ -2338,11 +2351,9 @@ nx_again:
                 ; shadow still set, takes the old road, where rp_exec breaks / releases
