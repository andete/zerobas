10 REM D-DBLNORM: the stored form of a double zero, and which zeros break 0+Y
20 DEFDBL A-Z:Y=5.0000000000001#-5
30 R=0:V=VARPTR(R):LPRINT "R=0";PEEK(V);PEEK(V+1)
40 R=0#:LPRINT "R=0#";PEEK(V);PEEK(V+1)
50 R=1-1:LPRINT "R=1-1";PEEK(V);PEEK(V+1)
60 R=Y-Y:LPRINT "R=Y-Y";PEEK(V);PEEK(V+1)
70 X=0#+Y:GOSUB 200:X=CDBL(0)+Y:GOSUB 200:X=(Y-Y)+Y:GOSUB 200
80 X=0!+Y:GOSUB 200:X=1+Y-1:GOSUB 200:X=Y+1E-13:GOSUB 200:X=Y+1E-20:GOSUB 200
90 X=1E-13+0:GOSUB 200:X=1.5E-10+0:GOSUB 200:X=.001+0:GOSUB 200:X=.5+0:GOSUB 200:END
200 W=VARPTR(X):LPRINT X;-(X<1E-8);PEEK(W);PEEK(W+1):RETURN
