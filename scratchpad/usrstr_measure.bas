10 REM USR with a string argument: what DAC holds, and a string result
20 FOR K=1 TO 300:NEXT:CLEAR 200,&HDFFF:A=&HE000
30 FOR I=0 TO 5:READ H$:POKE A+I,VAL("&H"+H$):NEXT:DEFUSR=A:DEFUSR1=A+5
40 DATA 3E,02,32,63,F6,C9
50 ON ERROR GOTO 200
60 S$="HELLO":P=USR(S$):V=VARPTR(S$):LPRINT "A";P=V;PEEK(P);CHR$(PEEK(PEEK(P+1)+256*PEEK(P+2)))
70 P=USR("XYZ"):LPRINT "B";PEEK(P);CHR$(PEEK(PEEK(P+1)+256*PEEK(P+2)))
80 LPRINT "C ";USR1("ABC");LEN(USR1("Q"+"R"))
90 B$=USR1(S$):LPRINT "D ";B$;LEN(B$)
100 X=USR1("AB"):LPRINT "E";X
110 Y=USR1(5):LPRINT "F";Y:Z$=USR1(5):LPRINT "G ";Z$
120 LPRINT "H";USR(LEFT$(S$,2))>0;PEEK(USR(MID$(S$,2)))
130 LPRINT "Z END":END
200 LPRINT "ERR";ERR;"IN";ERL:RESUME NEXT
