1 REM @ANSWERS X|5|Z|7|1|2|3|1,2|X|9,8|1|A|4,5|6
10 REM INPUT: the redo prompt, the ?? continuation, and a comma after the prompt (Syntax error)
20 FOR K=1 TO 300:NEXT:CLS
30 INPUT "P1";A:LPRINT "A";A
50 INPUT C:LPRINT "C";C
60 INPUT "P4";D,E,F:LPRINT "D";D;E;F
70 INPUT "P5";G,H,I:LPRINT "E";G;H;I
80 INPUT "P6";J,K,L:LPRINT "F";J;K;L
85 ON ERROR GOTO 200:E=0:INPUT "P7",X:LPRINT "G";E:E=0:LINE INPUT "P8",Q$:LPRINT "H";E:ON ERROR GOTO 0
90 FOR Y=0 TO 23:S$="":FOR X=0 TO 39:S$=S$+CHR$(VPEEK(Y*40+X)):NEXT:LPRINT "|";S$:NEXT
100 END
200 E=ERR:RESUME NEXT
