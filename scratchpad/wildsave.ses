# @DISK
# D-WILDSAVE scratch: a wildcard in a name that CREATES a file
NEW
10 PRINT "X"
SAVE "P*.BAS"
SAVE "P?.BAS"
SAVE "Q*",A
OPEN "O*.TXT" FOR OUTPUT AS #1
OPEN "O?.TXT" FOR APPEND AS #1
OPEN "R*.DAT" AS #1
BSAVE "B*.BIN",&H8000,&H8010
SAVE "GOOD"
NAME "GOOD" AS "G*"
NAME "GOOD" AS "G?D"
NAME "G*" AS "NEW"
FILES
LOAD "G*"
LIST
KILL "G?OD"
FILES
