10 REM fullclash-acceptance: a pixel that would fill its 8-pixel byte in another colour (D-FULLCLASH)
20 SCREEN 2:COLOR 15,1,1:DEFINT A-Z:DIM R$(7):P=5*256+5*8:Q=P+8192
30 FOR K=0 TO 6:CLS:ON K+1 GOSUB 100,110,120,130,140,150,160
40 R$(K)=HEX$(VPEEK(P))+" "+HEX$(VPEEK(Q))+" ":FOR X=40 TO 47:R$(K)=R$(K)+CHR$(48+POINT(X,40)):NEXT:NEXT
50 SCREEN 0:FOR K=0 TO 6:LPRINT K;R$(K):NEXT:END
100 LINE (40,40)-(47,40),2:RETURN
110 LINE (40,40)-(47,40),2:PSET (40,40),3:RETURN
120 LINE (40,40)-(47,40),2:PSET (40,40),2:RETURN
130 LINE (40,40)-(46,40),2:PSET (47,40),2:RETURN
140 LINE (40,40)-(46,40),2:PSET (47,40),3:RETURN
150 LINE (40,40)-(47,40),2:PSET (40,40),3:PSET (41,40),5:RETURN
160 LINE (40,40)-(47,40),2:PSET (40,40),1:RETURN
