10 REM D-BIOSRUNG / STRTMS: the bytes each PLAY appends to voice A's ring, in hex -- the VG-8020's packet format
20 DATA C,T32L1C,V10C,S0M1000CC,M1000CM1000C,M255C,M1000R4C,N0,L8N0,R4,O8B,V0C,S8C,*
30 READ M$:IF M$="*" THEN 100
40 P=PEEK(&HF959):PLAY M$
50 IF PLAY(0) THEN 50
60 Q=PEEK(&HF959):S$="":I=P
70 IF I<>Q THEN I=(I+1) AND 127:S$=S$+RIGHT$("0"+HEX$(PEEK(&HF975+I)),2):GOTO 70
80 LPRINT M$;" ";S$
90 GOTO 30
100 P=PEEK(&HF95F):PLAY "C","E"
110 IF PLAY(0) THEN 110
120 Q=PEEK(&HF95F):S$="":I=P
130 IF I<>Q THEN I=(I+1) AND 127:S$=S$+RIGHT$("0"+HEX$(PEEK(&HF9F5+I)),2):GOTO 130
140 LPRINT "B ";S$
