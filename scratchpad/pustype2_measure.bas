10 REM D-PUSTYPE: the value of a string field that is not a string, and RESUME NEXT after it
20 ON ERROR GOTO 900:CLS
30 E=0:PRINT USING "!";5:LPRINT "A";E
40 E=0:PRINT USING "!";:LPRINT "B";E
50 E=0:PRINT USING "!";1/0:LPRINT "C";E
60 E=0:PRINT USING "&";"AB"+5:LPRINT "D";E
70 E=0:PRINT USING "!";X:LPRINT "E";E
80 E=0:PRINT USING "##";"AB":LPRINT "F";E
90 E=0:PRINT USING "##";"AB";5:LPRINT "G";E
100 E=0:PRINT USING "\ \##";"AB";"CD":LPRINT "H";E
110 E=0:PRINT USING "##";:LPRINT "I";E
120 LPRINT "END":END
900 E=ERR:LPRINT "ERR";ERR;ERL:RESUME NEXT
