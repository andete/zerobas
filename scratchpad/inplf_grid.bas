1 REM @DISK
10 REM D-INPLF grid: one char class per case; | = a lone LF, ^ = CR, ~ = a quote
20 CLEAR 1000:MAXFILES=2:SCREEN 0:CLS:ON ERROR GOTO 900
30 FOR C=1 TO 19:READ K$,T$:GOSUB 800
40 OPEN "G.TXT" FOR INPUT AS #1:X=-1:Y=-1:A$="?":B$="?"
50 IF K$="N" THEN INPUT #1,X,Y:LPRINT C;"N";X;Y
60 IF K$="S" THEN INPUT #1,A$,B$:LPRINT C;"S [";A$;"][";B$;"]";LEN(A$);LEN(B$)
70 IF K$="L" THEN LINE INPUT #1,A$:LINE INPUT #1,B$:LPRINT C;"L";LEN(A$);LEN(B$);"[";B$;"]"
80 CLOSE:NEXT:LPRINT "END":END
800 B$="":FOR J=1 TO LEN(T$):M$=MID$(T$,J,1)
810 IF M$="|" THEN M$=CHR$(10) ELSE IF M$="^" THEN M$=CHR$(13) ELSE IF M$="~" THEN M$=CHR$(34)
820 B$=B$+M$:NEXT:OPEN "G.TXT" FOR OUTPUT AS #1:PRINT #1,B$;:CLOSE:RETURN
900 LPRINT C;"ERR";ERR;ERL:RESUME NEXT
1000 DATA N,"|5^6^",N," |5^6^",N,"5|6^7^",N,"5 |6^7^",N,"5|,6^"
1010 DATA N,"5,|6^",N,"-|5^6^",N,"5.|5^6^",N,"5^|6^"
1020 DATA S,"|AB^CD^",S,"A|B^CD^",S,"~A|B~^CD^",S,"AB|,CD^",S," |AB^CD^"
1030 DATA L,"|AB^CD^",L,"A|B^CD^",L,"AB^|CD^",L,"AB^||CD^",L,"AB||CD^EF^"
