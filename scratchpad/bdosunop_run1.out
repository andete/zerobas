# cf: done-flag a50d (want a5 + last row 0d)
# zb: done-flag a50d (want a5 + last row 0d)
fn  what                                       cf                        zb
1A  SETDTA $D400         A=08 HL=5808 DE=D400 BC=581A  A=E1 HL=0000 DE=D400 BC=1A1A
0D  DSKRST               A=00 HL=9F00 DE=F1AA BC=9F0D  A=00 HL=0000 DE=0000 BC=0D0D
10  CLOSE nosuch, fresh  A=FF HL=0BFF DE=F2BA BC=0B00  A=00 HL=0008 DE=0000 BC=0008
14  SEQRD nosuch, fresh  A=01 HL=0001 DE=0000 BC=0000  A=00 HL=FFF8 DE=0000 BC=0008
10  CLOSE exists, fresh  A=00 HL=0000 DE=0007 BC=0001  A=00 HL=0008 DE=0000 BC=0008
14  SEQRD exists, fresh  A=01 HL=0001 DE=0000 BC=0000  A=01 HL=0000 DE=0000 BC=0100
0F  OPEN exists          A=00 HL=FF00 DE=C0EF BC=FFFA  A=00 HL=0000 DE=ED53 BC=0000
14  SEQRD exists, open   A=01 HL=0001 DE=0000 BC=0000  A=01 HL=0000 DE=0000 BC=0614
10  CLOSE exists, open   A=00 HL=0300 DE=F2C4 BC=0300  A=00 HL=C0E8 DE=C0D0 BC=1010
10  CLOSE again          A=00 HL=0300 DE=F2C4 BC=0300  A=00 HL=C0E8 DE=C0D0 BC=1010
14  SEQRD after CLOSE    A=01 HL=0001 DE=0000 BC=0000  A=01 HL=0000 DE=0000 BC=1414
0F  OPEN nosuch          A=FF HL=0BFF DE=C100 BC=0B00  A=FF HL=E8CD DE=0020 BC=0F08
10  CLOSE after fail     A=FF HL=0BFF DE=F2BA BC=0B00  A=00 HL=0008 DE=0000 BC=0008
14  SEQRD after fail     A=01 HL=0001 DE=0000 BC=0000  A=01 HL=0000 DE=0000 BC=0F08
# the FCBs afterwards, bytes +12..+36 (the name is the same everywhere)
  FCB NO cf: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  FCB NO zb: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 00 00 00 01 00 00 00 00
  FCB EX cf: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  FCB EX zb: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  FCB OP cf: 00 00 00 00 00 00 00 00 00 00 00 00 40 00 00 00 00 00 00 00 14 00 00 c1 00
  FCB OP zb: 00 00 00 00 00 00 00 00 21 08 00 00 40 00 00 00 00 00 00 00 14 00 00 c1 00
  FCB NF cf: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  FCB NF zb: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
done
