1 REM @ANSWERS ABCDEF
10 REM D-PRSTRFN: INPUT$ and SPRITE$ as bare PRINT items
20 ON ERROR GOTO 900
30 PRINT "GO"
40 LPRINT "A [";INPUT$(1);"]"
50 LPRINT "B ";INPUT$(2)
60 LPRINT INPUT$(1);"C"
70 SCREEN 1:SPRITE$(1)="XYZ":S$=SPRITE$(1):SCREEN 0
80 LPRINT "D [";LEFT$(S$,3);"]";LEN(S$)
90 SCREEN 1:LPRINT "E [";LEFT$(SPRITE$(1),3);"]":SCREEN 0
100 SCREEN 1:LPRINT "F [";:LPRINT MID$(SPRITE$(1),2,1);"]":SCREEN 0
110 SCREEN 1:X$=SPRITE$(1):LPRINT "G";LEN(SPRITE$(1)):SCREEN 0
120 SCREEN 1:LPRINT "H ";:LPRINT SPRITE$(1):SCREEN 0
130 LPRINT "I ";INPUT$(1)+"Q";INPUT$(1)="F"
140 ON ERROR GOTO 0:END
900 LPRINT "ERR";ERR;"AT";ERL:RESUME NEXT
