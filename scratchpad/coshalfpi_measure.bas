10 REM D-COSHALFPI: SIN / COS / TAN near their zeros, double and single
20 FOR K=1 TO 300:NEXT
30 P#=4*ATN(1#):P!=4*ATN(1!):LPRINT "A";P#;P!
40 LPRINT "B";COS(P#/2);SIN(P#);COS(3*P#/2);SIN(2*P#)
50 LPRINT "C";COS(P!/2);SIN(P!);COS(3*P!/2);SIN(2*P!)
60 LPRINT "D";SIN(P#/2);COS(P#);COS(0#);SIN(P#/6)
70 LPRINT "E";TAN(P#);TAN(P#/4);COS(1.5707963267949#);SIN(3.1415926535898#)
80 LPRINT "F";COS(1.5707963267948#);COS(1.570796#);SIN(1D-10);COS(1D-10)
90 LPRINT "G";SIN(100#);COS(100#);SIN(1000!);COS(-P#/2)
