10 REM D-DBLNORM: which step leaves 1E-13 unnormalised -- ABS, 0+y, y+0, R=0:R=R+y?
20 DEFDBL A-Z
30 Y=5.0000000000001#-5:X=Y:GOSUB 100
40 X=ABS(Y):GOSUB 100
50 X=0+Y:GOSUB 100
60 X=Y+0:GOSUB 100
70 R=0:X=R+Y:GOSUB 100
80 X=ABS(5.0000000000001#-5):GOSUB 100
85 X=0+ABS(5.0000000000001#-5):GOSUB 100
90 Z=ABS(Y):X=0+Z:GOSUB 100
95 X=-(5.0000000000001#-5):GOSUB 100:END
100 V=VARPTR(X):LPRINT X;-(X<1E-8);PEEK(V);PEEK(V+1):RETURN
