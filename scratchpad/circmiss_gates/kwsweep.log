LAYER 2 — SUPPORT (the load-bearing layer)
==============================================================================
DIVERGENT     csrlin    PRINT:PRINT:PRINT"[";CSRLIN;"]"
            ref  [value] '||[ 4 ]'
            zb   [value] '||[ 3 ]'
NO-ORACLE     mki       PRINT"[";LEN(MKI$(1));"]"
            ref  [?noecho] ''
            zb   [value] '[ 2 ]'
NO-ORACLE     mks       PRINT"[";LEN(MKS$(1));"]"
            ref  [?noecho] ''
            zb   [value] '[ 0 ]'
NO-ORACLE     mkd       PRINT"[";LEN(MKD$(1));"]"
            ref  [?noecho] ''
            zb   [value] '[ 0 ]'
NO-ORACLE     cvs       PRINT"[";CVS(MKS$(1));"]"
            ref  [?noecho] ''
            zb   [error:type mismatch] '[|Type mismatch'
NO-ORACLE     cvd       PRINT"[";CVD(MKD$(1));"]"
            ref  [?noecho] ''
            zb   [error:type mismatch] '[|Type mismatch'
SUPPORTED     abs       PRINT"[";ABS(-5);"]"
            ref  [value] '[ 5 ]'
SUPPORTED     int       PRINT"[";INT(1.7);"]"
            ref  [value] '[ 1 ]'
SUPPORTED     len       PRINT"[";LEN("ab");"]"
            ref  [value] '[ 2 ]'
SUPPORTED     chr       PRINT"[";CHR$(65);"]"
            ref  [value] '[A]'
SUPPORTED     mid       PRINT"[";MID$("hi",2,1);"]"
            ref  [value] '[i]'
SUPPORTED     instr     PRINT"[";INSTR("ab","b");"]"
            ref  [value] '[ 2 ]'
SUPPORTED     hex       PRINT"[";HEX$(255);"]"
            ref  [value] '[FF]'
SUPPORTED     sqr       PRINT"[";SQR(9);"]"
            ref  [value] '[ 3 ]'
SUPPORTED     peek      PRINT"[";PEEK(0)>=0;"]"
            ref  [value] '[-1 ]'
SUPPORTED     varptr    B=1:PRINT"[";VARPTR(B)>0;"]"
            ref  [value] '[ 0 ]'
SUPPORTED     stick     PRINT"[";STICK(0);"]"
            ref  [value] '[ 0 ]'
SUPPORTED     erase     DIM Q(2):ERASE Q:PRINT"[ok]"
            ref  [value] '[ok]'
SUPPORTED     swapctl   A=1:PRINT"[";A;"]"
            ref  [value] '[ 1 ]'
SUPPORTED     locate    LOCATE 10:PRINT"[X]"
            ref  [value] '[X]'
SUPPORTED     pos       PRINT"    ";:PRINT"[";POS(0);"]"
            ref  [value] '[ 5 ]'
SUPPORTED     tab       PRINT"[";TAB(5);"X]"
            ref  [value] '[    X]'
SUPPORTED     spc       PRINT"[";SPC(5);"X]"
            ref  [value] '[     X]'
SUPPORTED     swap      A=1:B=2:SWAP A,B:PRINT"[";A;B;"]"
            ref  [value] '[ 2  1 ]'
SUPPORTED     fre       PRINT"[";FRE(0)>1000;"]"
            ref  [value] '[-1 ]'
SUPPORTED     tron      TRON:TROFF:PRINT"[ok]"
            ref  [value] '[ok]'
SUPPORTED     troff     TROFF:PRINT"[ok]"
            ref  [value] '[ok]'
SUPPORTED     defsng    DEFSNG A:A=1.5:PRINT"[";A;"]"
            ref  [value] '[ 1.5 ]'
SUPPORTED     defdbl    DEFDBL A:A=1.5:PRINT"[";A;"]"
            ref  [value] '[ 1.5 ]'
SUPPORTED     defstr    DEFSTR A:A="x":PRINT"[";A;"]"
            ref  [value] '[x]'
SUPPORTED     deffn     DEF FNA(X)=X+1:PRINT"[";FNA(2);"]"
            ref  [value] '[ 3 ]'
SUPPORTED     eqv       PRINT"[";5 EQV 3;"]"
            ref  [value] '[-7 ]'
SUPPORTED     imp       PRINT"[";5 IMP 3;"]"
            ref  [value] '[-5 ]'
SUPPORTED     motor     MOTOR OFF:PRINT"[ok]"
            ref  [value] '[ok]'
SUPPORTED   ! WEAK  time      T=TIME:PRINT"[";TIME>=T;"]"
            ref  [value] '[-1 ]'
            zb   [value] '[-1 ]'
            WEAK: absent => variable TI, always 0, and `0>=0` is STILL true, so this row passes on a machine with no TIME. The `timetick` row is the real test.
SUPPORTED     timetick  T=TIME:FOR I=1 TO 400:NEXT:PRINT"[";TIME>T;"]"
            ref  [value] '[-1 ]'
SUPPORTED     bin       PRINT"[";BIN$(5);"]"
            ref  [value] '[101]'

