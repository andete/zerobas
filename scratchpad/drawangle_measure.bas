10 REM DRAW A0..A3: where does U10 from (100,100) end, and the R / D / L strokes
20 SCREEN 2:DEFINT A-Z:DIM R$(16)
30 FOR K=0 TO 15:A=K\4:M=K MOD 4:CLS
40 ON M+1 GOSUB 200,210,220,230
50 S$="":FOR D=0 TO 3:X=100+(D=1)*(-10)*-1:Y=100:IF D=0 THEN Y=90
60 IF D=1 THEN X=110:Y=100 ELSE IF D=2 THEN X=100:Y=110 ELSE IF D=3 THEN X=90:Y=100
70 S$=S$+CHR$(48+POINT(X,Y)):NEXT
80 R$(K)=S$+CHR$(48+POINT(100,100)):NEXT
90 SCREEN 0:FOR K=0 TO 15:LPRINT "A";K\4;"STROKE ";MID$("URDL",K MOD 4+1,1);" ";R$(K):NEXT:END
200 DRAW "BM100,100C15A=A;U10":RETURN
210 DRAW "BM100,100C15A=A;R10":RETURN
220 DRAW "BM100,100C15A=A;D10":RETURN
230 DRAW "BM100,100C15A=A;L10":RETURN
