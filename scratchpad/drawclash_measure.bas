10 REM the colour clash when a line ENDS on an already-set pixel of another colour
20 SCREEN 2:COLOR 15,1,1:DEFINT A-Z:DIM R$(7)
30 FOR K=0 TO 6:CLS:LINE (40,40)-(60,40),2
40 ON K+1 GOSUB 200,210,220,230,240,250,260
50 R$(K)="":FOR X=38 TO 49:R$(K)=R$(K)+CHR$(48+POINT(X,40)):NEXT:NEXT
60 SCREEN 0:FOR K=0 TO 6:LPRINT K;R$(K):NEXT:END
200 LINE (20,40)-(40,40),3:RETURN
210 LINE (40,40)-(20,40),3:RETURN
220 PSET (40,40),3:RETURN
230 DRAW "BM20,40C3R20":RETURN
240 DRAW "BM40,40C3L20":RETURN
250 PSET (41,40),3:RETURN
260 LINE (20,40)-(41,40),3:RETURN
