10 REM L3_turtle line 40 alone: four squares from (40,60) at A0..A3, colour 2..5
20 SCREEN 2:COLOR 15,1,1:CLS:DEFINT A-Z
30 SQ$="U20R20D20L20":FOR A=0 TO 3:CC=A+2:DRAW "BM40,60A=A;C=CC;XSQ$;":NEXT
40 P$="":RESTORE 90:FOR I=1 TO 10:READ X,Y:P$=P$+CHR$(48+POINT(X,Y)):NEXT
50 SCREEN 0:LPRINT "A ";P$
60 SCREEN 2:CLS:CC=3:DRAW "BM40,60A1C=CC;XSQ$;":Q$="":RESTORE 90:FOR I=1 TO 10:READ X,Y:Q$=Q$+CHR$(48+POINT(X,Y)):NEXT
70 SCREEN 2:CLS:DRAW "BM40,60A1C3U20R20D20L20":R$="":RESTORE 90:FOR I=1 TO 10:READ X,Y:R$=R$+CHR$(48+POINT(X,Y)):NEXT
80 SCREEN 0:LPRINT "B ";Q$:LPRINT "C ";R$:END
90 DATA 42,40,40,40,20,40,20,50,30,60,60,50,40,70,50,80,47,40,48,40
