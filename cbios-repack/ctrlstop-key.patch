diff --git a/src/main.asm b/src/main.asm
index 6aebbfb..d74a7a1 100644
--- a/src/main.asm
+++ b/src/main.asm
@@ -2919,6 +2919,15 @@ key_ascii:
                 cp      6
                 ld      a,(hl)          ; get ASCII value (keeps the flags)
                 jr      nc,key_ascii_ctrl       ; C >= 6: rows 0-5
+                ; zerobas repack (D-STOPKEY3): $03 here is STOP (row 7's entry), and it
+                ; is a key only with CTRL held (row 6 bit 1, active low).
+                cp      3
+                jr      nz,key_ascii_home
+                ld      a,(NEWKEY + 6)
+                bit     1,a
+                ld      a,3
+                jr      nz,key_store_end2   ; STOP alone: nothing
+key_ascii_home:
                 ; Rows 6-11. HOME is $0B, SHIFT+HOME is $0C (CLS). The table
                 ; for these rows has no SHIFT variant, so handle that one key.
                 cp      $0B
@@ -3263,7 +3272,11 @@ str_nocart:     equ     str_error_prompt
 ; the last rows are not locale specific
 scode_tbl_otherkeys:
                 db      $00,$00,$00,$00,$00,$00,$00,$00 ;06
-                db      $00,$00,$1B,$09,$00,$08,$00,$0D ;07
+; zerobas repack (D-STOPKEY3): STOP (row 7, bit 4) is $03 -- with CTRL held, which
+; key_ascii tests: Ctrl-STOP queues ^C on the VG-8020 (zerobas
+; scratchpad/stopkey_run2.out, KEYBUF written 46 ms in), STOP alone queues nothing
+; (stopkey_noctrl.out). The only $03 in this table.
+                db      $00,$00,$1B,$09,$03,$08,$00,$0D ;07
                 db      $20,$0B,$12,$7F,$1D,$1E,$1F,$1C ;08
                 db      "*+/01234"                      ;09
                 db      "56789-,."                      ;0a
