         IF VDP = TMS99X8
@@ -1725,51 +1725,8 @@ curs2hl_mult_skip:
 ; Remark   : On a mismatch it is a Syntax error: H.ERRO is called with
 ;            E = 2, as BASIC does; without BASIC to go back to, C-BIOS then
 ;            stops with an error screen.
-synchr:
-                ld      a,(hl)
-                ex      (sp),hl
-                cp      (hl)            ; the inline byte
-                inc     hl              ; return past it
-                ex      (sp),hl
-                jr      nz,synchr_error
-                                        ; on into CHRGTR
-;-------------------------------------
-; $0010 CHRGTR
-; Function : Steps to the next character of a program text and returns it,
-;            skipping spaces, TABs and LFs
-; Input    : HL - the current character
-; Output   : HL - the next character (spaces, TABs and LFs skipped)
-;            A  - that character
-;            F  - Z at the end of a statement (00 or ':'), C on a digit;
-;                 from ':' up a compare's flags with ':', 00 an OR's, else
-;                 a decrement's flags
-; Registers: AF, HL
-; Remark   : The numeric-constant tokens ($0B-$1F) of BASIC's text are
-;            returned as plain characters: C-BIOS has no BASIC.
-chrgtr:
-                call    H_CHRG
-chrgtr_lp:
-                inc     hl
-                ld      a,(hl)
-                cp      ':'
-                ret     nc              ; ':' and up
-                or      a
-                ret     z               ; 00: the end of the line
-                cp      ' '
-                jr      z,chrgtr_lp
-                sub     9
-                cp      2
-                jr      c,chrgtr_lp     ; TAB and LF
-                sub     '0'-9           ; A = the character - '0'
-                sub     $CF             ; A = the character + 1, C: a digit
-                dec     a
-                ret
-
-synchr_error:
-                ld      e,2             ; Syntax error
-                call    H_ERRO
-                ld      de,str_syntax_error
-                jp      print_error
+; zerobas cbios-repack (D-CBIOS032): SYNCHR / CHRGTR -- zerobas overlays the vector with its own body and
+; nothing in the merged ROM reaches C-BIOS's (zerobas scratchpad/cbios_reach.py), so it is cut.
 
 ;--------------------------------
 ; $0020 DCOMPR
@@ -1797,18 +1754,8 @@ dcompr:
 ;       high    low     low     float   4
 ; Output   : A  - VALTYP - 3; F as OR A on it, with C when VALTYP < 8
 ; Registers: AF
-getypr:
-                ld      a,(VALTYP)
-                cp      8
-                jr      nc,getypr_dbl
-                sub     3
-                or      a
-                scf
-                ret
-getypr_dbl:
-                sub     3
-                or      a
-                ret
+; zerobas cbios-repack (D-CBIOS032): GETYPR -- zerobas overlays the vector with its own body and
+; nothing in the merged ROM reaches C-BIOS's (zerobas scratchpad/cbios_reach.py), so it is cut.
 
 ;--------------------------------
 ; $0030 CALLF
@@ -1960,17 +1907,8 @@ chget_nowrap:
 ; Remark   : H_OUTD comes first (disk BASIC's file output hooks in there)
 ; Registers: F; A too for a graphic character to a printer that is not
 ;            an MSX printer (see OUTDLP)
-outdo:
-                push    af
-                call    H_OUTD
-                ld      a,(PRTFLG)
-                or      a
-                jr      nz,outdo_lpt
-                pop     af
-                jp      chput
-outdo_lpt:
-                pop     af
-                ; on to OUTDLP
+; zerobas cbios-repack (D-CBIOS032): OUTDO -- zerobas overlays the vector with its own body and
+; nothing in the merged ROM reaches C-BIOS's (zerobas scratchpad/cbios_reach.py), so it is cut.
 
 ;--------------------------------
 ; $014D OUTDLP
@@ -2156,10 +2094,8 @@ breakx:
 ;           the answer with no break pending: A = 0, Z, H and P/V set, and
 ;           interrupts on.
 ; Registers: AF
-iscntc:
-                and     0
-                ei
-                ret
+; zerobas cbios-repack (D-CBIOS032): ISCNTC / CKCNTC -- zerobas overlays the vector with its own body and
+; nothing in the merged ROM reaches C-BIOS's (zerobas scratchpad/cbios_reach.py), so it is cut.
 
 ;--------------------------------
 ; $00C6 POSIT
@@ -2581,14 +2517,8 @@ format:
 ;            F  - Z set if not taking place
 ; Registers: AF
 ; TODO: call H_ISFL
-isflio:
-;                call    H_ISFL
-                push    hl
-                ld      hl,(PTRFIL)
-                ld      a,h
-                or      l               ; both bytes of the pointer
-                pop     hl
-                ret
+; zerobas cbios-repack (D-CBIOS032): ISFLIO -- zerobas overlays the vector with its own body and
+; nothing in the merged ROM reaches C-BIOS's (zerobas scratchpad/cbios_reach.py), so it is cut.
 
 ;--------------------------------
 ; $00D5 GTSTCK
@@ -3348,9 +3278,8 @@ hang_up_mode:
 ; Input    : IX - the address to call
 ; Output   : Depends on the called routine
 ; Registers: Depends on the called routine, and IY
-calbas:
-                ld      iy,(EXPTBL-1)   ; IYH: the main ROM's slot
-                jp      calslt
+; zerobas cbios-repack (D-CBIOS032): CALBAS -- zerobas overlays the vector with its own body and
+; nothing in the merged ROM reaches C-BIOS's (zerobas scratchpad/cbios_reach.py), so it is cut.
 
         IF MODEL_MSX != MODEL_MSX1
 ;--------------------------------
@@ -3504,8 +3433,6 @@ str_error_prompt:
 str_memory_err:
                 db      "MEMORY NOT FOUND.",$00
 
-str_syntax_error:
