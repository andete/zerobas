-;--------------------------------
-; $011D READC -- A = the colour of the pixel at CLOC / CMASK (SCREEN 2): the colour
-; byte's foreground nibble when the pattern bit is set, else its background nibble.
-; SCREEN 3: the 4-bit colour of the block, the pattern byte's nibble under CMASK
-; (zerobas scratchpad/scr3sweep_run.out). HL / DE / BC kept.
-readc:
-                push    hl
-                push    bc
-                call    gcell
-                call    is_sc3
-                ld      a,(CMASK)
-                jr      nz,readc_s2
-                ld      c,b             ; SCREEN 3: the block's nibble of the pattern byte
-                and     $F0             ; Z: the right block, the low nibble
-                jr      readc_tst
-readc_s2:
-                and     b
-readc_tst:
-                ld      a,c
-                jr      z,readc_bg
-                rrca
-                rrca
-                rrca
-                rrca
-readc_bg:
-                and     $0F
-                jr      readc_out
-
-; B = the pattern byte at CLOC, C = its colour byte, HL = the colour byte's address
-gcell:
-                ld      hl,(CLOC)
-                call    rdvrm
-                ld      b,a
-                set     5,h             ; the colour table: pattern address + $2000
-                call    rdvrm
-                ld      c,a
-                ret
-
-;--------------------------------
-; $0120 SETC -- the pixel at CLOC / CMASK set to ATRBYT (SCREEN 2), as the VG-8020
-; (zerobas scratchpad/biossweep_setc.out): when ATRBYT is the cell's background
-; colour the pattern bit is CLEARED and the colour byte kept, A = the pattern byte;
-; otherwise the bit is SET, and when ATRBYT is not already the foreground the colour
-; byte becomes ATRBYT << 4 | background, A = that colour byte (else A = the pattern
-; byte). SCREEN 3: ATRBYT replaces the pattern byte's nibble under CMASK, A = the new
-; byte (zerobas scratchpad/scr3sweep_run.out). HL / DE / BC kept.
-setc:
-                push    hl
-                push    bc
-                push    de
-                call    gcell
-                ld      a,(ATRBYT)
-                ld      e,a
-                ld      a,(CMASK)
-                ld      d,a
-                call    is_sc3
-                jr      z,setc_sc3
-                ld      a,c
-                and     $0F
-                cp      e
-                ld      a,d
-                jr      nz,setc_set
-                cpl
-                and     b               ; ATRBYT is the background: the bit cleared
-                jr      setc_pat
-setc_set:
-                ld      a,e
-                rlca
-                rlca
-                rlca
-                rlca
-                xor     c
-                and     $F0
-                jr      z,setc_fg       ; the foreground is ATRBYT already
-                xor     c               ; ATRBYT << 4 | background
-                call    wrtvrm
-                ld      e,a
-                ld      a,d
-                or      b
-                res     5,h
-                call    wrtvrm
-                ld      a,e
-                jr      setc_out
-setc_sc3:
-                ld      a,e             ; SCREEN 3: ATRBYT into the nibble under CMASK
-                rlca
-                rlca
-                rlca
-                rlca
-                or      e
-                xor     b
-                and     d
-                xor     b
-                jr      setc_pat
-setc_fg:
-                ld      a,d
-                or      b
-setc_pat:
-                res     5,h             ; the pattern byte, at the colour address - $2000
-                call    wrtvrm
-setc_out:
-                pop     de
-readc_out:
-                pop     bc
-                pop     hl
-                ret
