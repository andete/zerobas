diff --git a/src/main.asm b/src/main.asm
index bf98b68..f9845cf 100644
--- a/src/main.asm
+++ b/src/main.asm
@@ -1550,13 +1550,26 @@ initio:
                 ; initio_cf.out): INITIO writes PSG register 15 := $CF (bit 6 set; C-BIOS
                 ; wrote $8F) and register 11 := $0B (C-BIOS left it), then the GICINI
                 ; teardown -- GICINI itself touches neither (called directly on both).
+                ; zerobas D-GICINIQ (2026-11-14): GICINI through the JUMP TABLE, so a ROM
+                ; that replaces it is honoured (zerobas's resets the PLAY queues), and
+                ; INITIO's exit registers as both references leave them (initio_run4.out):
+                ; F = $54 (Z, H, P/V), A = $FF; E = $0B from the R11 write below (GICINI
+                ; keeps every register); BC / D / HL the caller's.
+                ; GICINI FIRST (2026-11-21): WRTPSG enables interrupts, and the timer
+                ; interrupt plays the music now (isr_music) -- an interrupt landing there
+                ; must find MUSICF already 0, as the VG-8020's does (zerobas spec page
+                ; INITIO, R-IO-PLAY: MUSICF $A5 seeded, interrupts off on entry).
+                call    $0090
                 ld      e,$CF           ; strobe off, triggers on, bit 6 as both references
                 ld      a,$0F
                 call    wrtpsg
                 ld      e,$0B           ; envelope period low byte, as both references
                 ld      a,11
                 call    wrtpsg
-                jp      gicini
+                xor     a
+                and     a               ; F = $54
+                ld      a,$FF
+                ret
 
 ;--------------------------------
 ; $003E INIFNK
@@ -1567,7 +1580,7 @@ initio:
 ; runs; it gives INITIO's 7 new bytes above back (18 -> 11), so nothing after it moves.
 inifnk:
                 ret
-                ds      10, 0
+                ds      5, 0            ; D-GICINIQ took 5 of the 10 (INITIO's tail)
 
 ;--------------------------------
 ; $0099 STRTMS
