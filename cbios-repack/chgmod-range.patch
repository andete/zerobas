@@ -1918,6 +1918,7 @@
                 ; 4..$80 SCREEN 3, $81..$FF SCREEN 0 (INITXT makes OLDSCR 0). C-BIOS ran INIT32
                 ; for every non-zero OLDSCR. Through CHGMOD's table; 7 B longer, paid from
                 ; POSIT's pad above (TOTEXT starts 7 B earlier, $00D2 follows its label).
+totext_map:                             ; CHGMOD enters here for A above 3 (D-CHGMODRANGE)
                 cp      4
                 jr      c,totext_go     ; 0..3
                 cp      $81
--- a/src/video.asm
