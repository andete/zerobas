diff --git a/src/main.asm b/src/main.asm
index 7536cf6..ae2a643 100644
--- a/src/main.asm
+++ b/src/main.asm
@@ -2775,15 +2775,31 @@ key_chk_lp:
                 ld      a,(de)
                 ld      (ix+0),a
                 ex      af,af'
-                ; TODO: Optimise scanning if no keys are pressed.
-                ;       That's the most common case by far.
+                ; zerobas repack (D-KEYSKIP): a row with no NEWLY pressed key -- the
+                ; common case, as C-BIOS's TODO here said -- skips its 8-bit walk and
+                ; steps the table by 8 (Z is the `and` above, restored by ex af,af').
+                ; key_store is reached only on a set bit, so nothing else changes. The
+                ; walk, run twice a scan, was most of a ~3 ms interrupt, long enough
+                ; to make a disk read miss the next sector (zerobas
+                ; scratchpad/isrprof_runs.out). Paid for by key_chk_fnk below.
                 ld      b,$08
+                jr      z,key_row_skip
 key_bit_lp:
                 rrca
                 jr      c,key_store
 key_bit_next:
                 inc     hl
                 djnz    key_bit_lp
+                jr      key_row_next
+key_row_skip:
+                ld      a,l
+                add     a,b
+                ld      l,a
+                ld      b,0             ; B = 0 at the row's end, as djnz leaves it:
+                                        ; KSCAN's exit BC is the VG-8020's (biosregs)
+                jr      nc,key_row_next
+                inc     h
+key_row_next:
                 inc     ix
                 inc     de
                 dec     c
@@ -2820,35 +2836,22 @@ key_store:
 
 ; Put function string into buffer
 key_chk_fnk1:
-                ; F1-F3
-                ld      a,b
-                cp      $03 ; F1
-                jr      nz,key_chk_f2
-                ld      a,$00
-                jr      put_key_fnk
-key_chk_f2:
-                cp      $02 ; F2
-                jr      nz,key_chk_f3
-                ld      a,$01
-                jr      put_key_fnk
-key_chk_f3:
-                cp      $01 ; F3
-                jr      nz,key_ascii ; return to normal process
-                ld      a,$02
+                ; zerobas repack (D-KEYSKIP): the F-key index as arithmetic, not five
+                ; compare arms -- row 6 bits 5/6/7 (B = 3/2/1: B counts down as the
+                ; bits go up) are F1/F2/F3 = 0/1/2, row 7 bits 0/1 (B = 8/7) are
+                ; F4/F5 = 3/4; anything else is a plain key, as before.
+                ld      a,3
+                sub     b
+                cp      3
+                jr      nc,key_ascii
                 jr      put_key_fnk
 key_chk_fnk2:
-                ; F4-F5
-                ld      a,b
-                cp      $08 ; F4
-                jr      nz,key_chk_f5
-                ld      a,$03
-                jr      put_key_fnk
-key_chk_f5:
-                cp      $07 ; F5
-                jr      nz,key_ascii
-                ld      a,$04
-                jr      put_key_fnk
+                ld      a,11
+                sub     b
+                cp      5
+                jr      nc,key_ascii
 put_key_fnk:
+                or      a               ; Cy = 0 into the hook, as the old arms left it
 ; zerobas repack (interrupt-traps T3): the KEY-trap seam. Entered with A = the
 ; function-key index 0..4, immediately before the FNKSTR expansion. Deliberately
 ; THIN -- all policy lives in zerobas (basic/keytrap.asm). Teaching this ROM
