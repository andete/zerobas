diff --git a/src/chput.asm b/src/chput.asm
index 6e0d9c4..042ef42 100644
--- a/src/chput.asm
+++ b/src/chput.asm
@@ -285,19 +285,23 @@ chput_esc_xy_5:
 chput_escape_3: ; ----------------------------
                 djnz    chput_escape_4
 
-                ; -- ESCCNT == 3: 'ESC Y <n> <m>'
-                ld      b,$1F
-                sub     b
-                ld      (CSRX),a
+                ; -- ESCCNT == 3: 'ESC Y <n> <m>'. zerobas D-CHPUTESCY (2026-11-18), as the
+                ; VG-8020 (zerobas docs/bios/CHPUT.md R-Y-COLCLAMP): a column byte under 32 or
+                ; past LINLEN + 31 gives column LINLEN (POSIT's clamp); C-BIOS stored byte - 31.
+                sub     $1F
+                ld      h,a
+                call    posit_col
                 jr      chput_escape_reset
 
 chput_escape_4: ; ----------------------------
                 djnz    chput_escape_reset
 
-                ; -- ESCCNT == 4: 'ESC Y <n>'
-                ld      b,$1F
-                sub     b
-                ld      (CSRY),a
+                ; -- ESCCNT == 4: 'ESC Y <n>'. zerobas D-CHPUTESCY: a row byte under 32 or
+                ; past the last text row gives the last text row -- 24, or 23 with the key
+                ; line on (R-Y-ROWCLAMP, R4-Y-KEYCLAMP; POSIT's clamp, crt_rows).
+                sub     $1F
+                ld      l,a
+                call    posit_row
                 ld      a,3
                 jr      chput_escape_set
 
diff --git a/src/main.asm b/src/main.asm
index 234e6b1..319d1f9 100644
--- a/src/main.asm
+++ b/src/main.asm
@@ -1860,29 +1860,31 @@ posit:
                 ; LINLEN becomes LINLEN; a row of 0 or above (CRTCNT + CNSDFG) mod 256 --
                 ; zerobas's crt_rows at $3283 -- becomes that limit. C-BIOS stored H / L as
                 ; given. Paid from the FNKSB / ERAFNK / DSPFNK print_debug stubs below, dead
-                ; since zerobas overlays $00C9 / $00CC / $00CF; their labels are this ret, the
-                ; pad keeps TOTEXT where it was.
+                ; since zerobas overlays $00C9 / $00CC / $00CF; their labels are a ret here,
+                ; the pad keeps TOTEXT where it was. D-CHPUTESCY: ESC Y's two parameters
+                ; clamp the same way, through posit_col / posit_row (chput.asm).
                 ld      a,(SCRMOD)
                 cp      2
                 ret     nc
+                call    posit_row
+posit_col:                              ; H = column -> CSRX, clamped to LINLEN
+                ld      c,h
                 ld      a,(LINLEN)
-                cp      h
-                jr      c,posit_x       ; H above LINLEN
-                inc     h
-                dec     h
-                jr      z,posit_x       ; H = 0
-                ld      a,h
-posit_x:
-                ld      (CSRX),a
+                ld      de,CSRX
+                jr      posit_clamp
+posit_row:                              ; L = row -> CSRY, clamped to crt_rows
+                ld      c,l
                 call    $3283           ; A := CRTCNT + CNSDFG (zerobas crt_rows; HL kept)
-                cp      l
-                jr      c,posit_y       ; L above the limit
-                inc     l
-                dec     l
-                jr      z,posit_y       ; L = 0
-                ld      a,l
-posit_y:
-                ld      (CSRY),a
+                ld      de,CSRY
+posit_clamp:                            ; (DE) := C, or A (the limit) for C = 0 or C > A
+                inc     c
+                dec     c
+                jr      z,posit_store
+                cp      c
+                jr      c,posit_store
+                ld      a,c
+posit_store:
+                ld      (de),a
 fnksb:                                  ; $00C9 / $00CC / $00CF: zerobas's (overlaid)
 erafnk:
 dspfnk:
