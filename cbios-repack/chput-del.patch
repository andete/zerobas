diff --git a/src/chput.asm b/src/chput.asm
index 9af521a..33e80ad 100644
--- a/src/chput.asm
+++ b/src/chput.asm
@@ -328,9 +328,9 @@ chput_esc_d:
                 ld      (CSRX),a
                 ret
 
-; -- clear line
-chput_esc_l:
-                call    chput_ctrl_cr
+; -- clear line: zerobas D-CHPUTDEL -- chput_esc_l is in main.asm (POSIT's pad), as
+; the VG-8020's ESC l leaves the cursor where it was; its old 3 B are padding.
+                ds      3, 0
 
 ; -- Clear till end of line
 chput_esc_k:
@@ -481,12 +481,18 @@ chput_copy_line_copy:
 
 ; -- Erase
 chput_erase:
-                ld      a,(CSRX)
-                cp      1
+                ; zerobas D-CHPUTDEL (2026-11-18), as the VG-8020 (zerobas docs/bios/CHPUT.md
+                ; R-DEL / R4-CURSOR / R4-CELLS / R-DEL-WRAPCELL): DEL moves left exactly as BS
+                ; (at column 1 to the row above's last column, not past the top-left) and
+                ; blanks the cell it moved ONTO. C-BIOS blanked the cell under the cursor,
+                ; then moved -- not at column 1, where it stayed (and scrolled from the last
+                ; cell). chput_ctrl_left leaves Z set exactly when it did not move.
+                call    chput_ctrl_left
                 ret     z
                 ld      a,32
-                call    chput_putchar
-                jp      chput_ctrl_left
+                call    curs2hl
+                jp      wrtvrm
+                ds      2, 0            ; 2 B shorter: nothing after it moves
 
 ; -- disable cursor
 chput_remove_cursor:
diff --git a/src/main.asm b/src/main.asm
index 04768cf..234e6b1 100644
--- a/src/main.asm
+++ b/src/main.asm
@@ -1887,7 +1887,19 @@ fnksb:                                  ; $00C9 / $00CC / $00CF: zerobas's (over
 erafnk:
 dspfnk:
                 ret
-                ds      22, 0
+
+; -- ESC l (chput.asm's table): erase the whole line, the cursor staying where it is, as
+; the VG-8020 (zerobas D-CHPUTDEL, docs/bios/CHPUT.md R-ESC-l / R-ED-l); C-BIOS left it
+; at column 1. In POSIT's pad: nothing moves.
+chput_esc_l:
+                ld      hl,(CSRY)
+                push    hl
+                call    chput_ctrl_cr
+                call    chput_esc_k
+                pop     hl
+                ld      (CSRY),hl
+                ret
+                ds      7, 0
 
 ;--------------------------------
 ; $00D2 TOTEXT
