+; ---------------------------------------------------------------------------
+; zerobas cbios-repack (D-BIOSCONTRACT, 2026-11-08): the graphics-cursor span
+; RIGHTC .. GTASPC, rewritten as one block of the SAME LENGTH (it sits before
+; BASIC_ORG in the merged image; padded to pntini at the end). SCALXY and GTASPC
+; are real now -- measured against the Philips VG-8020 (zerobas
+; scratchpad/biossweep_sxy*.out); the entries not implemented YET are a bare
+; `ret` (they were print_debug stubs that did nothing either), their debug
+; calls and name strings giving the room. MAPXYC, SETC, STOREC, SETATR, READC
+; and the four moves too; the span runs to print_debug since PNTINI / SCANR /
+; SCANL joined the bare-`ret` list.
+; ---------------------------------------------------------------------------
 ;--------------------------------
-; $00FC RIGHTC
-; Function : Shifts screenpixel to the right
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-rightc:
+; $0123 NSETCX -- HL pixels from CLOC / CMASK rightward set as SETC does (SCREEN 2);
+; CLOC / CMASK end where they started, as on the VG-8020 (zerobas
+; scratchpad/biossweep_nsx.out). Registers not kept (the VG-8020 keeps none either).
+nsetcx:
                 push    hl
-                push    af
-                ld      hl,rightc_text
-                call    print_debug
+                call    fetchc
+                ex      (sp),hl         ; (SP) = CLOC, HL = the count
+                push    af              ; CMASK
+                jr      nsetcx_test
+nsetcx_lp:
+                call    setc
+                call    rightc
+                dec     hl
+nsetcx_test:
+                ld      a,h
+                or      l
+                jr      nz,nsetcx_lp
                 pop     af
-                pop     hl
+                pop     hl              ; falls into STOREC: CLOC / CMASK restored
+
+;--------------------------------
+; $0117 STOREC -- CLOC := HL, CMASK := A
+storec:
+                ld      (CLOC),hl
+                ld      (CMASK),a
                 ret
-rightc_text:    db      "RIGHTC",0
 
 ;--------------------------------
-; $00FF LEFTC
-; Function : Shifts screenpixel to the left
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-leftc:
-                push    hl
-                push    af
-                ld      hl,leftc_text
-                call    print_debug
-                pop     af
-                pop     hl
+; $011A SETATR -- ATRBYT := A when A < 16; else Cy = 1 and ATRBYT kept (the VG-8020:
+; F = $41 for A = 16 -- exactly `cp 16` / `ccf` / `ret c`)
+setatr:
+                cp      16
+                ccf
+                ret     c
+                ld      (ATRBYT),a
                 ret
-leftc_text:     db      "LEFTC",0
 
 ;--------------------------------
-; $0102 UPC
-; Function : Shifts screenpixel up
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-upc:
+; $011D READC -- A = the colour of the pixel at CLOC / CMASK (SCREEN 2): the colour
+; byte's foreground nibble when the pattern bit is set, else its background nibble.
+; HL / DE / BC kept.
+readc:
                 push    hl
-                push    af
-                ld      hl,upc_text
-                call    print_debug
-                pop     af
-                pop     hl
+                push    bc
+                call    gcell
+                ld      a,(CMASK)
+                and     b
+                ld      a,c
+                jr      z,readc_bg
+                rrca
+                rrca
+                rrca
+                rrca
+readc_bg:
+                and     $0F
+                jr      readc_out
+
+; B = the pattern byte at CLOC, C = its colour byte, HL = the colour byte's address
+gcell:
+                ld      hl,(CLOC)
+                call    rdvrm
+                ld      b,a
+                set     5,h             ; the colour table: pattern address + $2000
+                call    rdvrm
+                ld      c,a
                 ret
-upc_text:       db      "UPC",0
 
 ;--------------------------------
-; $0105 TUPC
-; Function : Tests whether UPC is possible, if possible, execute UPC
-; Output   : C-flag set if operation would end outside the screen
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-tupc:
+; $0120 SETC -- the pixel at CLOC / CMASK set to ATRBYT (SCREEN 2), as the VG-8020
+; (zerobas scratchpad/biossweep_setc.out): when ATRBYT is the cell's background
+; colour the pattern bit is CLEARED and the colour byte kept, A = the pattern byte;
+; otherwise the bit is SET, and when ATRBYT is not already the foreground the colour
+; byte becomes ATRBYT << 4 | background, A = that colour byte (else A = the pattern
+; byte). HL / DE / BC kept.
+setc:
                 push    hl
-                push    af
-                ld      hl,tupc_text
-                call    print_debug
-                pop     af
+                push    bc
+                push    de
+                call    gcell
+                ld      a,(ATRBYT)
+                ld      e,a
+                ld      a,(CMASK)
+                ld      d,a
+                ld      a,c
+                and     $0F
+                cp      e
+                ld      a,d
+                jr      nz,setc_set
+                cpl
+                and     b               ; ATRBYT is the background: the bit cleared
+                jr      setc_pat
+setc_set:
+                ld      a,e
+                rlca
+                rlca
+                rlca
+                rlca
+                xor     c
+                and     $F0
+                jr      z,setc_fg       ; the foreground is ATRBYT already
+                xor     c               ; ATRBYT << 4 | background
+                call    wrtvrm
+                ld      e,a
+                ld      a,d
+                or      b
+                res     5,h
+                call    wrtvrm
+                ld      a,e
+                jr      setc_out
+setc_fg:
+                ld      a,d
+                or      b
+setc_pat:
+                res     5,h             ; the pattern byte, at the colour address - $2000
+                call    wrtvrm
+setc_out:
+                pop     de
+readc_out:
+                pop     bc
                 pop     hl
                 ret
-tupc_text:      db      "TUPC",0
 
 ;--------------------------------
-; $0108 DOWNC
-; Function : Shifts screenpixel down
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-downc:
+; $00FC RIGHTC / $00FF LEFTC -- the graphics cursor one pixel right / left (SCREEN 2)
+; CMASK rotated; on the byte's wrap CLOC moves by 8 (the next / previous character
+; column). A = the new CMASK; HL / DE / BC kept. Measured on the Philips VG-8020
+; (zerobas scratchpad/biossweep_cur.out).
+rightc:
                 push    hl
-                push    af
-                ld      hl,downc_text
-                call    print_debug
-                pop     af
+                ld      hl,CMASK
+                rrc     (hl)
+                push    de
+                ld      de,8
+                jr      leftc_mv
+leftc:
+                push    hl
+                ld      hl,CMASK
+                rlc     (hl)
+                push    de
+                ld      de,-8
+leftc_mv:
+                ld      a,(hl)
+                jr      nc,leftc_out
+                ld      hl,(CLOC)
+                add     hl,de
+                ld      (CLOC),hl
+leftc_out:
+                pop     de
                 pop     hl
                 ret
-downc_text:     db      "DOWNC",0
 
 ;--------------------------------
-; $010B TDOWNC
-; Function : Tests whether DOWNC is possible, if possible, execute DOWNC
-; Output   : C-flag set if operation would end outside the screen
-; Registers: AF
-; NOTE     : This implementation is still a stub!
+; $0102 UPC / $0108 DOWNC -- the graphics cursor one pixel up / down (SCREEN 2)
+; CLOC -/+ 1 inside the 8-row character cell; across the cell's top / bottom row
+; CLOC -/+ $F9 (the row-7 / row-0 byte of the cell above / below). A = the old row
+; (UPC) or (old row + 1) AND 7 (DOWNC), as the VG-8020 leaves it; HL / DE / BC kept.
+; $0105 TUPC / $010B TDOWNC -- the same, except on the screen's top / bottom pixel
+; row: no move, A = 0, F = $45 (Cy set) as the VG-8020 (zerobas
+; scratchpad/biossweep_b3.out); elsewhere Cy clear.
+upc:
+                push    hl
+                ld      hl,(CLOC)
+                ld      a,l
+                and     7
+                jr      z,upc_wrap
+upc_in:
+                dec     hl
+                jr      upc_st
+upc_wrap:
+                push    de
+                ld      de,-$F9
+                jr      upc_add
+tupc:
+                push    hl
+                ld      hl,(CLOC)
+                ld      a,l
+                and     7
+                jr      nz,upc_in
+                inc     h
+                dec     h
+                jr      nz,upc_wrap     ; not the screen's top cell row
+tupc_edge:
+                xor     a
+                scf
+                pop     hl
+                ret
+downc:
+                push    hl
+                ld      hl,(CLOC)
+                ld      a,l
+                inc     a
+                and     7
+                jr      z,downc_wrap
+downc_in:
+                inc     hl
+                jr      upc_st
 tdownc:
                 push    hl
-                push    af
-                ld      hl,tdownc_text
-                call    print_debug
-                pop     af
+                ld      hl,(CLOC)
+                ld      a,l
+                inc     a
+                and     7
+                jr      nz,downc_in
+                ld      a,h
+                cp      $17             ; the bottom cell row (192 / 8 - 1)
+                jr      z,tupc_edge
+                xor     a
+downc_wrap:
+                push    de
+                ld      de,$F9
+upc_add:
+                add     hl,de
+                and     a               ; A = 0 here: F = $54 as the VG-8020 leaves it
+                pop     de
+upc_st:
+                ld      (CLOC),hl
                 pop     hl
                 ret
-tdownc_text:    db      "TDOWNC",0
 
