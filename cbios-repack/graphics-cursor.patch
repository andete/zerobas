                 pop     af
+leftc_out:
                 pop     hl
                 ret
-tupc_text:      db      "TUPC",0
 
 ;--------------------------------
-; $0108 DOWNC
-; Function : Shifts screenpixel down
-; Registers: AF
-; NOTE     : This implementation is still a stub!
+; $0102 UPC / $0108 DOWNC -- the graphics cursor one pixel up / down (SCREEN 2)
+; CLOC -/+ 1 inside the 8-row character cell; across the cell's top / bottom row
+; CLOC -/+ $F9 (the row-7 / row-0 byte of the cell above / below). A = the old row
+; (UPC) or (old row + 1) AND 7 (DOWNC), as the VG-8020 leaves it; HL / DE / BC kept.
+upc:
+                push    hl
+                ld      hl,(CLOC)
+                ld      a,l
+                and     7
+                jr      z,upc_wrap
+                dec     hl
+                jr      upc_st
+upc_wrap:
+                push    de
+                ld      de,-$F9
+                add     hl,de
+                pop     de
+upc_st:
+                ld      (CLOC),hl
+                pop     hl
+                ret
 downc:
                 push    hl
-                push    af
-                ld      hl,downc_text
-                call    print_debug
-                pop     af
+                ld      hl,(CLOC)
+                ld      a,l
+                inc     a
+                and     7
+                jr      z,downc_wrap
+                inc     hl
+                jr      downc_st
+downc_wrap:
+                push    de
+                ld      de,$F9
+                add     hl,de
+                pop     de
+downc_st:
+                ld      (CLOC),hl
                 pop     hl
                 ret
-downc_text:     db      "DOWNC",0
 
