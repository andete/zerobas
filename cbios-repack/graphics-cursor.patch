-; $010B TDOWNC
-; Function : Tests whether DOWNC is possible, if possible, execute DOWNC
-; Output   : C-flag set if operation would end outside the screen
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-tdownc:
+; $010E SCALXY
+; Function : Clips the X / Y coordinate to the screen
+; Input    : BC = X, DE = Y
+; Output   : BC / DE clipped (X 0..255, Y 0..191, negatives to 0), then both
+;            divided by 4 in SCREEN 3; A = $80 if neither was clipped, else 0
+; Registers: AF, BC, DE (HL kept)
+scalxy:
                 push    hl
-                push    af
-                ld      hl,tdownc_text
-                call    print_debug
-                pop     af
+                ld      h,$80           ; "in range" until a clip says otherwise
+                bit     7,b
+                jr      z,scalxy_xpos
+                ld      bc,0
+                ld      h,b
+scalxy_xpos:
+                ld      a,b
+                or      a
+                jr      z,scalxy_xok
+                ld      bc,255
+                ld      h,0
+scalxy_xok:
+                bit     7,d
+                jr      z,scalxy_ypos
+                ld      de,0
+                ld      h,d
+scalxy_ypos:
+                ld      a,d
+                or      a
+                jr      nz,scalxy_yclip
+                ld      a,e
+                cp      192
+                jr      c,scalxy_yok
+scalxy_yclip:
+                ld      de,191
+                ld      h,0
+scalxy_yok:
+                ld      a,(SCRMOD)
+                cp      3
+                jr      nz,scalxy_done
+                srl     c
+                srl     c
+                srl     e
+                srl     e
+scalxy_done:
+                ld      a,h
                 pop     hl
                 ret
-tdownc_text:    db      "TDOWNC",0
 
