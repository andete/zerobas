+; ---------------------------------------------------------------------------
+; zerobas cbios-repack (D-BIOSCONTRACT, 2026-11-08): the graphics-cursor span
+; RIGHTC .. GTASPC, rewritten as one block of the SAME LENGTH (it sits before
+; BASIC_ORG in the merged image; padded to pntini at the end). SCALXY and GTASPC
+; are real now -- measured against the Philips VG-8020 (zerobas
+; scratchpad/biossweep_sxy*.out); the entries not implemented YET are a bare
+; `ret` (they were print_debug stubs that did nothing either), their debug
+; calls and name strings giving the room. MAPXYC, SETC, STOREC, SETATR, READC
+; and the four moves too; the span runs to print_debug since PNTINI / SCANR /
+; SCANL joined the bare-`ret` list.
+; ---------------------------------------------------------------------------
+tupc:
+tdownc:
+nsetcx:
+pntini:
+scanr:
+scanl:
+                ret
+
 ;--------------------------------
-; $00FC RIGHTC
-; Function : Shifts screenpixel to the right
-; Registers: AF
-; NOTE     : This implementation is still a stub!
-rightc:
+; $0117 STOREC -- CLOC := HL, CMASK := A
+storec:
+                ld      (CLOC),hl
+                ld      (CMASK),a
+                ret
+
+;--------------------------------
+; $011A SETATR -- ATRBYT := A when A < 16; else Cy = 1 and ATRBYT kept (the VG-8020:
+; F = $41 for A = 16 -- exactly `cp 16` / `ccf` / `ret c`)
+setatr:
+                cp      16
+                ccf
+                ret     c
+                ld      (ATRBYT),a
+                ret
+
+;--------------------------------
+; $011D READC -- A = the colour of the pixel at CLOC / CMASK (SCREEN 2): the colour
+; byte's foreground nibble when the pattern bit is set, else its background nibble.
+; HL / DE / BC kept.
+readc:
                 push    hl
-                push    af
-                ld      hl,rightc_text
-                call    print_debug
-                pop     af
+                push    bc
+                call    gcell
+                ld      a,(CMASK)
+                and     b
+                ld      a,c
+                jr      z,readc_bg
+                rrca
+                rrca
+                rrca
+                rrca
+readc_bg:
+                and     $0F
+                pop     bc
                 pop     hl
                 ret
-rightc_text:    db      "RIGHTC",0
+
+; B = the pattern byte at CLOC, C = its colour byte, HL = the colour byte's address
+gcell:
+                ld      hl,(CLOC)
+                call    rdvrm
+                ld      b,a
+                ld      a,h
+                add     a,$20
+                ld      h,a
+                call    rdvrm
+                ld      c,a
+                ret
 
