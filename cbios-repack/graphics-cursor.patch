 ; $010E SCALXY
-; Function : Scales X and Y coordinates
-; NOTE     : This implementation is still a stub!
+; Function : Clips the X / Y coordinate to the screen
+; Input    : BC = X, DE = Y
+; Output   : BC / DE clipped (X 0..255, Y 0..191, negatives to 0), then both
+;            divided by 4 in SCREEN 3; A = $80 if neither was clipped, else 0
+; Registers: AF, BC, DE (HL kept)
 scalxy:
-                ld      bc,(GRPACX)
-                ld      de,(GRPACY)
+                push    hl
+                ld      h,$80           ; "in range" until a clip says otherwise
+                ld      a,b
+                or      a
+                jr      z,scalxy_xok
+                rla                     ; Cy = negative
+                ld      bc,255
+                jr      nc,scalxy_xc
+                ld      c,b             ; BC = 0
+scalxy_xc:
+                ld      h,b             ; H = 0: clipped
+scalxy_xok:
+                ld      a,d
+                or      a
+                jr      nz,scalxy_yhi
+                ld      a,e
+                cp      192
+                jr      c,scalxy_yok
+                xor     a               ; 192..255: over, not negative
+scalxy_yhi:
+                rla
+                ld      de,191
+                jr      nc,scalxy_yc
+                ld      e,d             ; DE = 0
+scalxy_yc:
+                ld      h,d
+scalxy_yok:
+                ld      a,(SCRMOD)
+                cp      3
+                jr      nz,scalxy_done
+                srl     c
+                srl     c
+                srl     e
+                srl     e
+scalxy_done:
+                ld      a,h
+                pop     hl
+                ret
+
+;--------------------------------
+; $0126 GTASPC
+; Function : Gets the screen aspect ratio
+; Output   : DE = ASPCT1, HL = ASPCT2
+gtaspc:
+                ld      de,(ASPCT1)
+                ld      hl,(ASPCT2)
+pntini:                                 ; PNTINI / SCANR / SCANL: not yet, a bare `ret`
+scanr:
+scanl:
                 ret
-scalxy_text:    db      "SCALXY",0
 
