-                and     15
-                jr      setatr_set
-setatr_sc6_low:
-                push    hl
-                and     3
-                ld      l,a
-                add     a,a
-                add     a,a
-                add     a,l
-                pop     hl
-                jr      setatr_set
-        ENDIF
-
-        IF CALL_SUB = YES
-readc_bitmap:
-                ld      ix,$0095        ; READC in the sub-ROM
-                jr      gc_extrom
-setc_bitmap:
-                ld      ix,$009D        ; SETC in the sub-ROM
-gc_extrom:
-                jp      extrom
-        ENDIF
-        IF MODEL_MSX = MODEL_SUBROM
-; READC and SETC in SCREEN 5-8, with the VDP's POINT and PSET commands at
-; X = CLOC, Y = CMASK on the active page.
-readc_bitmap:
-                push    hl
-                ld      a,32
-                call    gc_vdp_xy       ; SX, SY
-                ld      a,45
-                call    gc_vdp_reg
-                xor     a
-                out     (VDP_REGS),a    ; ARG
-                ld      a,$40
-                out     (VDP_REGS),a    ; POINT
-                call    gc_vdp_wait
-                ld      a,7
-                call    vdpsta          ; S#7: the colour
-                pop     hl
-                ret
-setc_bitmap:
-                ld      a,36
-                call    gc_vdp_xy       ; DX, DY; HL = X
-                ld      a,44
-                call    gc_vdp_reg
-                ld      a,(ATRBYT)
-                out     (VDP_REGS),a    ; CLR
-                xor     a
-                out     (VDP_REGS),a    ; ARG
-                ld      a,$50
-                out     (VDP_REGS),a    ; PSET
-                ei
-                ret
-
-; Input  : A = the VDP register for X, followed by Y
-; Output : HL = CLOC; interrupts disabled
-; Changes: AF
-gc_vdp_xy:
-                call    gc_vdp_wait
-                call    gc_vdp_reg
-                ld      hl,(CLOC)
-                ld      a,l
-                out     (VDP_REGS),a
-                ld      a,h
-                out     (VDP_REGS),a
-                ld      a,(CMASK)
-                out     (VDP_REGS),a
-                ld      a,(ACPAGE)
-                out     (VDP_REGS),a
-                ret
-
-; Select VDP register A for writes through port VDP_REGS, which count up.
-; Changes: A; interrupts disabled
-gc_vdp_reg:
-                di
-                out     (VDP_ADDR),a
-                ld      a,$80 + 17
-                out     (VDP_ADDR),a
-                ret
-
-; Wait until the VDP has finished its command. Changes: F
-gc_vdp_wait:
-                push    af
-gc_vdp_wait_lp:
-                ld      a,2
-                call    vdpsta
-                rra
-                jr      c,gc_vdp_wait_lp
-                pop     af
-                ret
-        ENDIF
-
-;--------------------------------
-; $011D READC
-; Function : Reads the colour of the pixel at the graphics cursor
-; Output   : A  - the colour
-; Registers: AF
-; Remark   : SCREEN 5-8: through the sub-ROM's READC; F is undefined then
-readc:
-        IF VDP != TMS99X8
-                ld      a,(SCRMOD)
-                cp      5
-                jr      nc,readc_bitmap
-        ENDIF
-                push    hl
-                push    bc
-                call    fetchc
-                push    af
-                call    gc_cell
-                pop     af
-                and     b
-                ld      a,c
-                jr      z,readc_bg      ; the bit is clear: the background
-                rrca
-                rrca
-                rrca
-                rrca
-readc_bg:
-                and     $0F
-                jr      setc_pop
-
-;--------------------------------
-; $0120 SETC
-; Function : Sets the pixel at the graphics cursor to the colour ATRBYT
-; Output   : A  - the pattern byte written, or the colour byte if that changed
-;                 SCREEN 3: the pattern byte; SCREEN 5-8: $50
-; Registers: AF
-; Remark   : SCREEN 2 and 4 hold two colours per 8 pixels: the bit of a pixel
-;            in the pattern byte picks the colour byte's foreground (set) or
-;            background (clear). SETC clears the bit if ATRBYT is the
-;            background and sets it if it is the foreground. Else ATRBYT
-;            becomes the foreground, and the bit is set; unless that would
-;            set all 8 bits: then it becomes the background, and the bit is
-;            cleared, which leaves the other 7 pixels as they were.
-;            F: S, Z and P/V follow A. Measured on a VG-8020 and an NMS
-;            8250, flag bits 3 and 5 are 0 when A is the pattern byte; here
-;            they follow A.
-setc:
-        IF VDP != TMS99X8
-                ld      a,(SCRMOD)
-                cp      5
-                jr      nc,setc_bitmap
-        ENDIF
-                push    hl
-                call    fetchc          ; HL = CLOC, A = CMASK
-                jr      setc_cell
-
-; Sets the pixels of mask A in the pattern byte at HL, as SETC sets one.
-; SCREEN 2 and 4 only. Registers: AF
-setc_hl:
-                push    hl
-setc_cell:
-                push    bc
-                push    de
-                push    hl              ; the pattern byte's address
-                ld      d,a             ; D = the mask
-                call    gc_cell
-                ld      a,(ATRBYT)
-                ld      e,a
-                jr      c,setc_sc3
-                and     $0F
-                ld      e,a
-                ld      a,b
-                or      d
-                ld      b,a             ; B = the pattern byte with the bit set
-                xor     d
-                ld      d,a             ; D = the pattern byte with the bit cleared
-                ld      a,e
-                rlca
-                rlca
-                rlca
-                rlca
-                or      e               ; ATRBYT in both nibbles
-                xor     c               ; a nibble is 0 where the colour byte has ATRBYT
-                ld      e,a
-                and     $0F
-                jr      z,setc_clear    ; ATRBYT is the background
-                xor     e               ; A = the foreground nibble
-                jr      z,setc_set      ; ATRBYT is the foreground
-                inc     b
-                jr      z,setc_full     ; all 8 bits would be set
-                dec     b
-                or      a               ; NZ: the colour byte changes
-                jr      setc_set
-setc_full:
-                xor     e               ; A = the background nibble
-setc_clear:
-                ld      b,d             ; the bit cleared instead
-setc_set:
-                ld      e,a             ; E = the change to the colour byte, 0: none
-                ld      a,b
-                ex      (sp),hl         ; HL = the pattern byte's address
-                call    wrtvrm          ; the pattern byte; F is kept
-                pop     hl              ; the colour byte's address
-                jr      z,setc_done
-                ld      a,e
-setc_colour:
-                xor     c
-                call    wrtvrm          ; the colour byte
-setc_done:
-                or      a
-                pop     de
-setc_pop:
-                pop     bc
-                pop     hl
-                ret
-setc_sc3:
-                rlca                    ; SCREEN 3: ATRBYT into the nibble
-                rlca
-                rlca
-                rlca
-                or      e
-                xor     c
-                and     d
-                pop     hl              ; the pattern byte's address, as HL
-                jr      setc_colour
-
-; Input  : HL = the address of a pattern byte
-; Output : B = the pattern byte, C = the colour byte for it, HL = its
-;          address; SCREEN 3: C set, HL unchanged, B = $80, C = the pattern
-;          byte, which holds two colours
-; Changes: AF
-gc_cell:
-                call    rdvrm
-                ld      c,a
-                ld      b,$80
-                ld      a,(SCRMOD)
-                cp      3
-                scf
-                ret     z
-                ld      b,c
-                ld      a,h
-                xor     $20             ; the colour byte is $2000 away
-                ld      h,a
-                call    rdvrm           ; C reset
-                ld      c,a
-                ret
-
-;--------------------------------
-; $0123 NSETCX
-; Function : Sets a row of pixels from the graphics cursor rightward to the
-;            colour ATRBYT
-; Input    : HL - the number of pixels; other modes than SCREEN 2 and 4
-;                 only use L, with 0 as 256
-; Registers: All
-; Remark   : SCREEN 2 and 4: a byte at a time, and the cursor stays. A byte
-;            with only some of its pixels in the row is set as SETC sets one
-;            pixel, with all those pixels at once; also the first byte when
-;            HL is 0 (none of its pixels), unless the row starts at the
-;            byte's left edge. Every byte with all 8 pixels in the row gets
-;            pattern $00 and colour byte ATRBYT. The registers it leaves
-;            differ from those a VG-8020 or NMS 8250 leaves.
-;            Other modes: SETC and RIGHTC for each pixel; the cursor ends
-;            after the row. In SCREEN 5-8 that is of little use, as RIGHTC
-;            there moves the cursor as in SCREEN 3.
-nsetcx:
-                ld      a,(SCRMOD)
-                cp      3
-                jr      z,nsetcx_px
-        IF VDP != TMS99X8
-                cp      5
-                jr      nc,nsetcx_px
-        ENDIF
-                ; Per byte: C = its pixels from the row's start rightward, B =
-                ; the same shifted right once per pixel counted off DE; then
-                ; C - B are the pixels in the row (B = 0: all of C).
-                ex      de,hl           ; DE = the count
-                call    fetchc          ; HL = the byte's address
-                add     a,a
-                dec     a               ; the cursor's bit and all right of it
-nsetcx_byte:
-                ld      c,a
-                ld      b,a
-nsetcx_count:
-                ld      a,d
-                or      e
-                jr      z,nsetcx_mask   ; no pixels left
-                dec     de
-                srl     b
-                jr      nz,nsetcx_count ; the byte has more pixels
-nsetcx_mask:
-                ld      a,c
-                sub     b               ; A = the byte's pixels in the row
-                inc     b
-                ret     z               ; none left at a byte's left edge: done
-                inc     a
-                jr      nz,nsetcx_setc  ; not all 8
-                ; All 8: make the colour byte ATRBYT; then ATRBYT is its
-                ; background, and SETC with mask $FF clears the pattern byte.
-                push    hl
-                ld      a,h
-                xor     $20
-                ld      h,a
-                ld      a,(ATRBYT)
-                call    wrtvrm
-                pop     hl
-                xor     a
-nsetcx_setc:
-                dec     a
-                call    setc_hl
-                ld      bc,8
-                add     hl,bc           ; the next byte
-                ld      a,$FF
-                jr      nsetcx_byte
-
-; Other modes: a pixel at a time; only L counts, 0 as 256.
-nsetcx_px:
-                push    hl
-                call    setc
-                call    rightc
-                pop     hl
-                dec     l
-                jr      nz,nsetcx_px
-                ret
-
-;--------------------------------
-; $0126 GTASPC
-; Function : Gets the screen's aspect ratio, for CIRCLE
-; Output   : DE - ASPCT1, HL - ASPCT2
-; Registers: DE, HL
-gtaspc:
-                ld      de,(ASPCT1)
-                ld      hl,(ASPCT2)
-                ret
