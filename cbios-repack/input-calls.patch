--- a/src/main.asm
+++ b/src/main.asm
@@ -2152,15 +2152,17 @@
 ; Output   : A  - for data (the bit corresponding to the pressed key will be 0)
 ; Registers: AF
 snsmat:
+                ; zerobas D-SNSMATC / D-SNSMATPORT (2026-11-19): as the VG-8020 (zerobas
+                ; docs/bios/SNSMAT.md R-SM-C / R-SM-PORT): C := the row number (A on entry),
+                ; and port C := (port C AND $F0) + A, an 8-bit ADD of the whole A ($50 + $12 =
+                ; $62, $50 + $FF = $4F). 2 B shorter: GTTRIG's space bar spends them (below).
                 di
-                push bc
                 ld      c,a
                 in      a,(GIO_REGS)
                 and     $F0
-                or      c
+                add     a,c
                 out     (GIO_REGS),a
                 in      a,(KBD_STAT)
-                pop bc
                 ei
                 ret
 
@@ -2242,8 +2244,10 @@
                 push    de
 
                 ld      e,$00
-                dec     a
-                jr      z,sel_stc1
+                ; zerobas D-JOYPORT (2026-11-19): an ODD A selects port 1 (A 3 too), as the
+                ; VG-8020 (zerobas docs/bios/GTSTCK.md R-GS-PORT). Same size.
+                rrca
+                jr      c,sel_stc1
                 set     6,e             ; select stick 2
 sel_stc1:
                 ld      a,$0F
@@ -2307,14 +2311,21 @@
 ; Note     : Some programs rely on ZF to be set according to the value in A.
 ; Registers: All
 gttrig:
-                cp      5
-                jr      nc,gttrig_space ; if value of A is above 5,go space routine
+                ; zerobas D-GTTRIGRANGE (2026-11-19): A 5 is a joystick trigger (port 1, B),
+                ; not the space bar, as the VG-8020 (zerobas docs/bios/GTTRIG.md R-GT-A).
+                cp      6
+                jr      nc,gttrig_space ; A 6 and up: the space bar (C-BIOS's own choice)
                 or      a
                 jr      nz,joy_trig
 gttrig_space:
 ; Keyboard (spacebar)
+                ; zerobas (2026-11-19): BC kept, as the VG-8020's GTTRIG 0 (zerobas
+                ; biosregs-acceptance row gttrig0) -- SNSMAT itself now leaves the row in C.
+                ; The 2 B are SNSMAT's: the labels between move down 2, gttrig's end stays.
+                push    bc
                 ld      a,$08
                 call    snsmat          ; bit0 = 0 -> space pressed
+                pop     bc
                 or      $FE             ; FE -> pressed, FF -> not pressed
                 inc     a               ; FF -> pressed, 00 -> not pressed
                 ret
@@ -2444,13 +2455,17 @@
 ;             not #00 is lamp off
 ; Registers: AF
 chgcap:
-                or      a
-                in      a,(GIO_REGS)
-                set     6,a             ; bit 6 = 1: lamp off
-                jr      nz,chgcap_out
-                res     6,a             ; bit 6 = 0: lamp on
-chgcap_out:     out     (GIO_REGS),a
+                ; zerobas D-CHGCAPAF (2026-11-19): the lamp through the PPI's bit set / reset
+                ; command, and A := that command ($0C lamp on, $0D off), F $54 / $08 whatever
+                ; F was, as the VG-8020 (zerobas docs/bios/CHGCAP.md R-CC-AF); the other bits
+                ; of port C are kept by the command itself. 3 B shorter, padded.
+                and     a               ; A = 0: F $54
+                ld      a,$0C           ; reset bit 6: the lamp on
+                jr      z,chgcap_out
+                inc     a               ; $0D, set bit 6: the lamp off; F $08
+chgcap_out:     out     (PPI_REGS),a
                 ret
+                ds      3
 
 ;--------------------------------
 ; $014D OUTDLP
@@ -2518,8 +2533,11 @@
 ; Empties the keyboard buffer.
 ; Changes: HL
 kilbuf:
-                ld      hl,(GETPNT)
-                ld      (PUTPNT),hl
+                ; zerobas D-KILBUFPTR (2026-11-19): GETPNT := PUTPNT, HL that pointer -- the
+                ; buffer empties at the put side, as the VG-8020 (zerobas docs/bios/KILBUF.md
+                ; R-KB-BUF). Same size.
+                ld      hl,(PUTPNT)
+                ld      (GETPNT),hl
                 ret
 
 ;--------------------------------
