diff --git a/src/main.asm b/src/main.asm
index 23351a8..447ce67 100644
--- a/src/main.asm
+++ b/src/main.asm
@@ -2873,6 +2873,17 @@ put_key_fnk_nul:
 ; Check scan table
 key_ascii:
                 ld      a,(hl)          ; get ASCII value
+                ; zerobas repack (D-HOMEKEY): HOME is $0B, and $0C (CLS) only
+                ; with SHIFT -- this rows 6-11 table has no SHIFT variant, so the
+                ; one key that needs one is folded here. SHIFT is row 6 bit 0,
+                ; active low: carry set = NOT pressed, so $0C - carry = $0B.
+                cp      $0B
+                jr      nz,key_ascii_go
+                ld      a,(NEWKEY + 6)
+                rrca
+                ld      a,$0C
+                sbc     a,0
+key_ascii_go:
                 and     a               ; dead key?
                 jr      z,key_store_end2
                 ; Store ASCII value in key buffer.
@@ -3197,7 +3208,7 @@ scode_tbl_otherkeys:
 ; screen editor never saw either key -- on the MSX they are $12 (INS) and $7F
 ; (DEL), the codes BASIC's line editor acts on (MSX2 Technical Handbook, the
 ; character set's control codes). Row 8, bits 2 and 3.
-                db      $20,$0C,$12,$7F,$1D,$1E,$1F,$1C ;08
+                db      $20,$0B,$12,$7F,$1D,$1E,$1F,$1C ;08
                 db      "*+/01234"                      ;09
                 db      "56789-,."                      ;0a
 
