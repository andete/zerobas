# Build artifacts — ROMs now land under build/, regenerate with `make`.
/build/
# Belt-and-braces: ignore any stray ROM left at an old location (e.g. repo root).
*.rom

# Cassette images, disk images, and other test inputs (not source material).
# Disk images are oracle inputs / generated: real disks are proprietary and must
# never be committed (see PUBLISHING.md); the test image is regenerated with
# `make test-dsk` from tools/make_test_dsk.py.
*.cas
*.wav
*.dsk

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Editor / IDE
.vscode/

# Claude Code agent state + git worktrees. The worktree checkouts under here are
# full duplicate trees (and carry pre-migration references); they must never land
# in history. See PUBLISHING.md.
.claude/

# Gate/battery run logs land in scratchpad/ and are regenerated by `make`;
# the scratchpad itself is tracked (knives, drivers, characterisations) but its
# logs are not — one repack log is 1600 lines of build noise.
scratchpad/*.log
# ...and the per-run battery logs, which live one level down. The rule above is
# SHALLOW and `tools/run_gates.py` `rm -rf`s this directory at the start of every
# battery, so a file in it exists only until the next `make gates` -- which made
# `docs/spec-probe-machxml.md` cite a path nobody else could ever open
# (tools/check_citation_paths.py, 2026-08-26).
scratchpad/gate_logs/
# Same rule, same reason, for the other ephemeral classes. The tracked scratchpad
# is .py / .json / .md / .out / .asm -- knives, characterisations, run summaries
# that docs cite by name. Ad-hoc gate drivers and commit-message scaffolding are
# neither: the drivers are per-session by design (there is deliberately no
# standing corpus driver) and a commit message already lives in git history.
scratchpad/*.sh
scratchpad/*.txt

# D-AUTOLOCK: the desktop scheduled task's overlap lock (runs can collide --
# a gate battery outlasts the task's interval). Never a repo artifact.
scratchpad/.autolock/
