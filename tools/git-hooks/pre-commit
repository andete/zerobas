#!/bin/sh
# tools/git-hooks/pre-commit -- (1) refuse a commit that adds or changes a file over 1 MiB
# (tools/check_file_sizes.py; exceptions in tools/large-files-allow.txt); (2) when TODO.md or
# basic/kwtable.inc is staged, regenerate and stage docs/tier-status.md (tools/precommit_tiers.py),
# so the gate's tiers-md-check no longer goes red on a forgotten `make tiers-md`.
# Enable once per clone:  git config core.hooksPath tools/git-hooks
top="$(git rev-parse --show-toplevel)"
python3 "$top/tools/check_file_sizes.py" --staged || exit 1
exec python3 "$top/tools/precommit_tiers.py"
