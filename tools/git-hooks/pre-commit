#!/bin/sh
# tools/git-hooks/pre-commit -- refuse a commit that adds or changes a file over 1 MiB
# (tools/check_file_sizes.py; exceptions in tools/large-files-allow.txt).
# Enable once per clone:  git config core.hooksPath tools/git-hooks
exec python3 "$(git rev-parse --show-toplevel)/tools/check_file_sizes.py" --staged
